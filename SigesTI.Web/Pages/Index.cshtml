@page
@model SigesTI.Web.Pages.IndexModel

@{
    ViewData["Title"] = "SigesST | Sistema de Gestión de Soporte Técnico";
}

<div class="container-fluid py-3">

    <!-- Encabezado de Bienvenida y Reloj -->
    <div class="card dashboard-header-card mb-4">
        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 py-3 px-4">
            <div>
                <h3 class="fw-bold mb-1 text-white">
                    @Model.Saludo, @Model.NombreUsuarioActual
                </h3>
                <p class="mb-0 text-info opacity-75 fs-6">
                    <i class="bi bi-shield-check me-1"></i> Sistema de Gestión de Soporte Técnico.
                </p>
            </div>
            <div class="text-md-end system-clock-badge px-3 py-2 rounded-3">
                <div class="fw-semibold text-info"><i class="bi bi-calendar3 me-2"></i><span id="relojFecha">@Model.FechaActualTexto</span></div>
                <div class="fs-5 fw-bold text-white"><i class="bi bi-clock me-2"></i><span id="relojHora">@Model.HoraActualTexto</span></div>
            </div>
        </div>
    </div>

    <!-- Avisos del área y Mis requerimientos -->
    <div class="row g-3 mb-4">

        <div class="@(Model.TienePersonal ? "col-lg-6" : "col-12")">
            <div class="panel-inicio h-100">
                <div class="panel-inicio-encabezado">
                    <h6><i class="bi bi-megaphone-fill me-2"></i>Avisos del área</h6>
                    @if (Model.EsAdmin)
                    {
                        <button type="button" class="btn-aviso-guardar btn-aviso-chico" data-bs-toggle="modal" data-bs-target="#modalPublicarAviso">
                            <i class="bi bi-plus-lg"></i>Publicar aviso
                        </button>
                    }
                </div>

                @if (!Model.Avisos.Any())
                {
                    <p class="panel-inicio-vacio"><i class="bi bi-chat-square-text me-2"></i>No hay avisos por ahora.</p>
                }

                @foreach (var aviso in Model.Avisos)
                {
                    <div class="aviso aviso-@aviso.Tipo.ToLower()">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <strong>@aviso.Titulo</strong>
                            <span class="aviso-tipo">@aviso.Tipo</span>
                        </div>
                        <p>@aviso.Mensaje</p>
                        <div class="aviso-pie">
                            <span>@aviso.PublicadoPor · @aviso.FechaPublicacion.ToString("dd/MM/yyyy")</span>
                            @if (Model.EsAdmin)
                            {
                                <form method="post" asp-page-handler="QuitarAviso" class="form-quitar-aviso">
                                    <input type="hidden" name="id" value="@aviso.IdAviso" />
                                    <button type="submit" class="btn-quitar-aviso" title="Quitar aviso"><i class="bi bi-trash3"></i></button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (Model.TienePersonal)
        {
            <div class="col-lg-6">
                <div class="panel-inicio h-100">
                    <div class="panel-inicio-encabezado">
                        <h6><i class="bi bi-file-earmark-text-fill me-2"></i>Mis requerimientos</h6>
                    </div>

                    @if (!Model.MisRequerimientos.Any())
                    {
                        <p class="panel-inicio-vacio"><i class="bi bi-check2-circle me-2"></i>No tienes requerimientos abiertos.</p>
                    }

                    @foreach (var req in Model.MisRequerimientos)
                    {
                        <button type="button" class="mi-req" onclick="abrirVistaRequerimiento(@req.IdSolicitud)">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <strong>#@req.IdSolicitud.ToString("D4")</strong>
                                <span class="mi-req-fecha">@req.FechaIngreso.ToString("dd/MM/yyyy")</span>
                            </div>
                            @if (req.Descripcion != "")
                            {
                                <p>@req.Descripcion</p>
                            }

                            <div class="mi-req-pasos">
                                <span class="@(req.Paso >= 1 ? "hecho" : "") @(req.Paso == 1 ? "actual" : "")">Registrado</span>
                                <span class="@(req.Paso >= 2 ? "hecho" : "") @(req.Paso == 2 ? "actual" : "")">En atención</span>
                                <span class="@(req.Paso >= 3 ? "hecho" : "")">Resuelto</span>
                            </div>

                            <small>@req.Estatus@(string.IsNullOrEmpty(req.Ejecutivo) ? "" : $" · Atiende: {req.Ejecutivo}")</small>
                        </button>
                    }
                </div>
            </div>
        }

    </div>

    <!-- Título de Sección -->
    <div class="d-flex align-items-center justify-content-between mb-3 px-1">
        <h5 class="fw-bold text-white mb-0">
            <i class="bi bi-grid-1x2-fill me-2 text-warning"></i>Recientes / Prioritarios
        </h5>
        <span class="badge bg-secondary bg-opacity-50 text-light border border-secondary px-3 py-1 rounded-pill fs-7">
            Actividad del Día
        </span>
    </div>

    <!-- Grid de Tarjetas Operativas -->
    @if (!Model.ListaActividades.Any())
    {
        <div class="dashboard-vacio mb-4">
            <i class="bi bi-cup-hot"></i>
            <p class="mb-0">No hay actividad reciente para mostrar.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
            @foreach (var item in Model.ListaActividades)
            {
                <div class="col">
                    <div class="card activity-card @item.BadgeClass h-100 p-3 rounded-4 d-flex flex-column justify-content-between">

                        <div>
                            <!-- Header de Tarjeta -->
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="activity-type-badge">
                                    <i class="bi @item.Icono me-1"></i> @item.Tipo
                                </span>
                                <i class="bi @item.Icono fs-4 activity-header-icon"></i>
                            </div>

                            <!-- Título y Descripción -->
                            <h6 class="fw-bold text-white mb-2">@item.Titulo</h6>
                            <p class="text-light opacity-75 fs-7 mb-3">@item.Descripcion</p>
                        </div>

                        <!-- Botón Ver Detalles -->
                        <div class="text-end border-top border-white border-opacity-10 pt-2">
                            <a href="@item.UrlDetalle" class="btn btn-sm btn-activity-action rounded-pill px-3">
                                Ver detalles <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

    <!-- Botón Ícono de Información del Sistema (i) -->
    <div class="d-flex justify-content-end align-items-center mt-2">
        <button type="button" class="btn btn-sm btn-info-system rounded-circle" data-bs-toggle="modal" data-bs-target="#infoSistemaModal" title="Información del Sistema">
            <i class="bi bi-info-circle-fill fs-5"></i>
        </button>
    </div>

</div>

<!-- Modal: Información del Sistema -->
<div class="modal fade" id="infoSistemaModal" tabindex="-1" aria-labelledby="infoSistemaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content info-modal-content text-light">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h6 class="modal-title text-info font-monospace" id="infoSistemaModalLabel">
                    <i class="bi bi-info-circle-fill me-2"></i>ACERCA DEL SISTEMA
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center px-4 py-3">
                <div class="mb-3">
                    <h2 class="fw-bold text-white mb-1 tracking-wide">SigesST</h2>
                    <p class="text-info opacity-75 fs-7 mb-0">Sistema de Gestión de Soporte Técnico</p>
                </div>

                <hr class="border-secondary opacity-25 my-3" />

                <div class="px-2 text-start fs-6">
                    <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25">
                        <span class="text-light opacity-75">Versión actual:</span>
                        <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-25 px-2 py-1 fs-7">v1.0.0</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom border-secondary border-opacity-25">
                        <span class="text-light opacity-75">Desarrollado por:</span>
                        <span class="fw-semibold text-white">Ing. Justin Sánchez</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-light opacity-75">Fecha de versión:</span>
                        <span class="text-white fw-medium">Junio 2026</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center pb-4">
                <button type="button" class="btn btn-outline-info btn-sm px-4 rounded-pill" data-bs-dismiss="modal">
                    Entendido
                </button>
            </div>
        </div>
    </div>
</div>

@if (Model.EsAdmin)
{
    <!-- Modal: Publicar aviso -->
    <div class="modal fade modal-aviso" id="modalPublicarAviso" tabindex="-1" aria-labelledby="tituloPublicarAviso" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="PublicarAviso">
                    <div class="modal-header">
                        <div class="d-flex align-items-center gap-3">
                            <div class="modal-aviso-icono"><i class="bi bi-megaphone-fill"></i></div>
                            <div>
                                <h5 class="modal-title mb-0" id="tituloPublicarAviso">Publicar aviso</h5>
                                <small class="modal-aviso-subtitulo">Lo verán todos los usuarios en la pantalla principal</small>
                            </div>
                        </div>
                        <button type="button" class="modal-aviso-cerrar" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"><i class="bi bi-x-lg"></i></button>
                    </div>

                    <div class="modal-body form-aviso">
                        <label for="avisoTitulo">Título</label>
                        <input type="text" id="avisoTitulo" name="titulo" maxlength="100" placeholder="Ej. Mantenimiento del servidor" required />

                        <label for="avisoMensaje">Mensaje</label>
                        <textarea id="avisoMensaje" name="mensaje" rows="4" maxlength="500" placeholder="Escribe el aviso..." required></textarea>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label for="avisoTipo">Tipo</label>
                                <select id="avisoTipo" name="tipo">
                                    @foreach (var tipo in SigesTI.Web.Models.TiposAviso.Todos)
                                    {
                                        <option value="@tipo">@tipo</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label for="avisoExpira">Mostrar hasta <span>(opcional)</span></label>
                                <input type="date" id="avisoExpira" name="fechaExpira" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn-aviso-cancelar" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle"></i>Cancelar
                        </button>
                        <button type="submit" class="btn-aviso-guardar">
                            <i class="bi bi-send-fill"></i>Publicar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        @if (TempData["AvisoError"] is string errorAviso)
        {
            <text>mostrarError(@Json.Serialize(errorAviso));</text>
        }

        // Confirmación antes de quitar un aviso
        document.querySelectorAll(".form-quitar-aviso").forEach(function (form) {
            form.addEventListener("submit", function (event) {
                event.preventDefault();

                mostrarConfirmacion({
                    titulo: "¿Quitar este aviso?",
                    mensaje: "Ya no se mostrará en la pantalla principal.",
                    icono: "warning",
                    textoConfirmar: "Quitar",
                    alConfirmar: function () { form.submit(); }
                });
            });
        });
    </script>

    <script>
        // Reloj del encabezado con el mismo formato que el servidor
        (function () {
            const fecha = document.getElementById("relojFecha");
            const hora = document.getElementById("relojHora");

            function actualizarReloj() {
                const ahora = new Date();

                const texto = ahora.toLocaleDateString("es-MX", { weekday: "long", day: "2-digit", month: "long", year: "numeric" });
                fecha.textContent = texto.charAt(0).toUpperCase() + texto.slice(1);

                const horas = ahora.getHours();
                const h12 = String(horas % 12 || 12).padStart(2, "0");
                const minutos = String(ahora.getMinutes()).padStart(2, "0");
                hora.textContent = `${h12}:${minutos} ${horas < 12 ? "a. m." : "p. m."}`;
            }

            setInterval(actualizarReloj, 1000);
        })();
    </script>
}
