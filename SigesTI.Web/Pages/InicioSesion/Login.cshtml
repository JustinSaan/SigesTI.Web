@page
@model SigesTI.Web.Pages.InicioSesion.LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SigesTI</title>

    <!-- Aplica el aspecto guardado antes de pintar la página, para que no parpadee -->
    <script>
        try {
            if (localStorage.getItem("tema") === "claro") document.documentElement.setAttribute("data-tema", "claro");
        } catch (e) { }
    </script>

    <link rel="icon"
          type="image/x-icon"
          href="~/icono.png" />

    <!-- Iconos -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Estilos exclusivos del Login -->
    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
</head>

<body>

    <main class="login-page">

        <!-- Figuras decorativas -->
        <div class="figura figura-izquierda"></div>
        <div class="figura figura-derecha"></div>

        <!-- Cambiar aspecto (oscuro / claro) -->
        <button type="button"
                id="btnCambiarTema"
                class="btn-tema-login"
                title="Cambiar aspecto"
                aria-label="Cambiar aspecto">

            <i class="bi bi-sun-fill icono-oscuro"></i>
            <i class="bi bi-moon-stars-fill icono-claro"></i>

        </button>

        <!-- Tarjeta del Login -->
        <section class="login-card">

            <div class="login-logo">

                <img src="~/SigesST.png"
                     alt="Logo"
                     width="380"
                     height="120" />

            </div>

            <form method="post"
                  id="formLogin">

                <div asp-validation-summary="ModelOnly"
                     class="mensaje-error">
                </div>

                <!-- Usuario -->
                <div class="campo-login">

                    <label asp-for="Login.Usuario"
                           class="login-label">
                    </label>

                    <div class="input-login">

                        <i class="bi bi-person"></i>

                        <input asp-for="Login.Usuario"
                               class="login-input"
                               autocomplete="username"
                               placeholder="Ingresa tu usuario"
                               autofocus />

                    </div>

                    <span asp-validation-for="Login.Usuario"
                          class="mensaje-validacion">
                    </span>

                </div>

                <!-- Contraseña -->
                <div class="campo-login">

                    <label asp-for="Login.Password"
                           class="login-label">
                    </label>

                    <div class="input-login">

                        <i class="bi bi-lock"></i>

                        <input asp-for="Login.Password"
                               id="password"
                               class="login-input"
                               autocomplete="current-password"
                               placeholder="Ingresa tu contraseña" />

                        <button type="button"
                                id="btnMostrarPassword"
                                class="btn-password"
                                aria-label="Mostrar contraseña">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="Login.Password"
                          class="mensaje-validacion">
                    </span>

                    <div id="avisoMayusculas"
                         class="aviso-mayusculas">

                        <i class="bi bi-capslock"></i>

                        <span>
                            Bloq Mayús está activado
                        </span>

                    </div>

                </div>

                <!-- Recordar mi usuario: se guarda solo el usuario, en este navegador (login.js) -->
                <label class="recordar-usuario"
                       for="recordarUsuario">

                    <input type="checkbox"
                           id="recordarUsuario"
                           role="switch" />

                    <span class="recordar-interruptor"></span>

                    <span>Recordar mi usuario</span>

                </label>

                <!-- Botón iniciar sesión -->
                <button type="submit"
                        id="btnIniciarSesion"
                        class="btn-iniciar">

                    <span>Iniciar sesión</span>

                    <i class="bi bi-arrow-right"></i>

                </button>

            </form>

        </section>

        <!-- Acerca del sistema (igual que en la pantalla principal) -->
        <button type="button"
                id="btnAcercaDe"
                class="btn-info-system"
                title="Información del Sistema"
                aria-label="Información del Sistema">

            <i class="bi bi-info-circle-fill"></i>

        </button>

        <!-- Modal: Información del Sistema -->
        <div id="modalAcercaDe"
             class="modal-password"
             aria-hidden="true">

            <div class="info-modal-content"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="tituloAcercaDe">

                <div class="info-modal-encabezado">

                    <h6 id="tituloAcercaDe"
                        class="info-modal-etiqueta">

                        <i class="bi bi-info-circle-fill"></i>ACERCA DEL SISTEMA

                    </h6>

                    <button type="button"
                            id="btnCerrarAcercaDe"
                            class="btn-cerrar-acerca"
                            aria-label="Cerrar"
                            title="Cerrar">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>

                <div class="info-modal-cuerpo">

                    <h2 class="info-modal-titulo">SigesST</h2>
                    <p class="info-modal-subtitulo">Sistema de Gestión de Soporte Técnico</p>

                    <hr />

                    <div class="info-modal-datos">
                        <div><span>Versión actual:</span><span class="info-version">v1.0.0</span></div>
                        <div><span>Desarrollado por:</span><strong>Ing. Justin Sánchez</strong></div>
                        <div><span>Fecha de versión:</span><strong>Junio 2026</strong></div>
                    </div>

                </div>

            </div>

        </div>

        <!-- Modal obligatorio para cambiar contraseña -->
        <div id="modalCambiarPassword"
             class="modal-password @(Model.MostrarModalCambio ? "mostrar" : "")"
             aria-hidden="@(Model.MostrarModalCambio ? "false" : "true")">

            <div class="modal-password-contenido"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="tituloCambioPassword">

                <div class="modal-password-icono">

                    <i class="bi bi-shield-lock"></i>

                </div>

                <h2 id="tituloCambioPassword"
                    class="modal-password-titulo">

                    Cambiar contraseña

                </h2>

                <p class="modal-password-texto">

                    Es necesario cambiar tu contraseña, ingresa una nueva.

                </p>

                <form method="post"
                      asp-page-handler="CambiarPassword"
                      id="formCambiarPassword">

                    <!-- Contraseña nueva -->
                    <div class="campo-login">

                        <label for="passwordNueva"
                               class="login-label">

                            Contraseña nueva

                        </label>

                        <div class="input-login">

                            <i class="bi bi-lock"></i>

                            <input type="password"
                                   id="passwordNueva"
                                   name="passwordNueva"
                                   class="login-input"
                                   autocomplete="new-password"
                                   placeholder="Ingresa la contraseña nueva"
                                   minlength="6"
                                   required />

                            <button type="button"
                                    class="btn-password btn-mostrar-modal"
                                    data-input="passwordNueva"
                                    aria-label="Mostrar contraseña nueva">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                    </div>

                    <!-- Confirmación -->
                    <div class="campo-login">

                        <label for="confirmarPassword"
                               class="login-label">

                            Confirmar contraseña

                        </label>

                        <div class="input-login">

                            <i class="bi bi-lock-fill"></i>

                            <input type="password"
                                   id="confirmarPassword"
                                   name="confirmarPassword"
                                   class="login-input"
                                   autocomplete="new-password"
                                   placeholder="Confirma la contraseña nueva"
                                   minlength="6"
                                   required />

                            <button type="button"
                                    class="btn-password btn-mostrar-modal"
                                    data-input="confirmarPassword"
                                    aria-label="Mostrar confirmación de contraseña">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                    </div>

                    <div id="errorCoincidencia"
                         class="mensaje-modal">

                        @Model.MensajeCambio

                    </div>

                    <div class="modal-acciones">

                        <button type="submit"
                                id="btnCambiarPassword"
                                class="btn-cambiar-password">

                            Cambiar contraseña

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </main>

    <input type="hidden"
           id="sesionEnOtroEquipo"
           value="@Model.SesionEnOtroEquipo.ToString().ToLower()" />

    <input type="hidden"
           id="sesionCaducada"
           value="@Model.SesionCaducada.ToString().ToLower()" />

    <input type="hidden"
           id="passwordCambiada"
           value="@((TempData["PasswordCambiada"] != null).ToString().ToLower())" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Alertas generales -->
    <script src="~/js/alertas.js"
            asp-append-version="true">
    </script>

    <!-- Comportamiento del Login -->
    <script src="~/js/login.js"
            asp-append-version="true">
    </script>

    <!-- Cambiar aspecto -->
    <script src="~/js/tema.js"
            asp-append-version="true">
    </script>

</body>

</html>