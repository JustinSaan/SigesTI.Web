@page
@model SigesTI.Web.Pages.Solicitudes.FormatoModel
@using System.Globalization
@using SigesTI.Web.Models

@{
    Layout = null;

    var cultura = new CultureInfo("es-MX");
    var sol = Model.Solicitud;
    string folio = sol.IdSolicitud.ToString("D4");

    bool tieneEntrega = sol.Estatus == EstatusSolicitud.Resuelto
                        && sol.FechaEntrega.HasValue
                        && sol.FechaEntrega.Value.Year > 1901;

    var sistemas = (sol.SistemasDetalle ?? "")
        .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
        .Where(s => s != "Otros")
        .ToList();

    if (!string.IsNullOrWhiteSpace(sol.OtrosSistemas))
    {
        sistemas.Add(sol.OtrosSistemas);
    }

    if (!sol.ReqSistemas)
    {
        sistemas.Clear();
    }

    bool hayConfiguraciones = sistemas.Any()
                              || !string.IsNullOrWhiteSpace(sol.NuevaUnidadRed)
                              || !string.IsNullOrWhiteSpace(sol.DetalleImpresora);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Requerimiento@(folio)_@Model.FechaGeneracion.ToString("dd-MM-yyyy")</title>
    <link rel="stylesheet" href="~/css/Reportes/reporte-solicitudes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Reportes/reporte-encabezado.css" asp-append-version="true" />
</head>

<body>
    <main class="hoja">

        <!-- Encabezado -->
        <header class="rep-encabezado">
            <div>
                <div class="rep-area">Área de Soporte Técnico</div>
                <div class="rep-titulo">Requerimiento #@folio</div>
            </div>
            <div class="rep-fecha">
                <span>Fecha del reporte</span>
                <strong>@Model.FechaGeneracion.ToString("dd/MM/yyyy")</strong>
            </div>
        </header>

        <!-- Solicitante -->
        <section class="seccion">
            <h2 class="seccion-titulo">Datos del solicitante</h2>
            <dl class="ficha">
                <div><dt>Nombre</dt><dd>@(sol.Personal?.Nombre ?? "N/A")</dd></div>
                <div><dt>Área</dt><dd>@(sol.Personal?.Area ?? "N/A")</dd></div>
                @if (!string.IsNullOrWhiteSpace(sol.PuestoSolicitante))
                {
                    <div><dt>Puesto</dt><dd>@sol.PuestoSolicitante</dd></div>
                }
                @if (!string.IsNullOrWhiteSpace(sol.CorreoSolicitante))
                {
                    <div><dt>Correo electrónico</dt><dd>@sol.CorreoSolicitante</dd></div>
                }
                @if (Model.TieneResponsable)
                {
                    <div><dt>Responsable del área</dt><dd>@Model.ResponsableArea</dd></div>
                }
            </dl>
        </section>

        <!-- Control y asignación -->
        <section class="seccion">
            <h2 class="seccion-titulo">Control y asignación</h2>
            <dl class="ficha">
                <div><dt>Fecha de ingreso</dt><dd>@sol.FechaIngreso.ToString("dd/MM/yyyy")</dd></div>
                <div><dt>Estatus</dt><dd><span class="estatus @ReporteSolicitudesModel.ClaseEstatus(sol.Estatus)">@EstatusSolicitud.Texto(sol.Estatus)</span></dd></div>
                @if (tieneEntrega)
                {
                    <div><dt>Fecha de realización</dt><dd>@sol.FechaEntrega!.Value.ToString("dd/MM/yyyy")</dd></div>
                }
                @if (!string.IsNullOrEmpty(sol.EjecutivoAsignado))
                {
                    <div><dt>Persona asignada</dt><dd>@sol.EjecutivoAsignado</dd></div>
                }
                @if (!string.IsNullOrEmpty(sol.AutorizaAdmin))
                {
                    <div><dt>Autoriza</dt><dd>@sol.AutorizaAdmin</dd></div>
                }
                @if (sol.FechaAutorizacion.HasValue)
                {
                    <div><dt>Autorizado</dt><dd>@sol.FechaAutorizacion.Value.ToString("dd/MM/yyyy hh:mm tt", cultura)</dd></div>
                }
            </dl>
        </section>

        <!-- Descripción del requisito -->
        @if (Model.Descripcion != "")
        {
            <section class="seccion">
                <h2 class="seccion-titulo">Descripción del requisito</h2>
                <div class="descripcion">@Model.Descripcion</div>
            </section>
        }

        <!-- Sistemas y configuraciones (solo lo que se pidió) -->
        @if (hayConfiguraciones)
        {
            <section class="seccion">
                <h2 class="seccion-titulo">Sistemas y configuraciones</h2>
                @if (sistemas.Any())
                {
                    <div class="etiquetas">
                        @foreach (var sistema in sistemas)
                        {
                            <span class="etiqueta">@sistema</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(sol.NuevaUnidadRed) || !string.IsNullOrWhiteSpace(sol.DetalleImpresora))
                {
                    <dl class="ficha">
                        @if (!string.IsNullOrWhiteSpace(sol.NuevaUnidadRed))
                        {
                            <div><dt>Nueva unidad de red</dt><dd>@sol.NuevaUnidadRed</dd></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(sol.DetalleImpresora))
                        {
                            <div><dt>Configurar impresora</dt><dd>@sol.DetalleImpresora</dd></div>
                        }
                    </dl>
                }
            </section>
        }

        <!-- Seguimiento -->
        @if (Model.Seguimiento.Any())
        {
            <section class="seccion">
                <h2 class="seccion-titulo">Seguimiento</h2>
                @foreach (var comentario in Model.Seguimiento)
                {
                    <div class="comentario">
                        @if (comentario.Autor != null)
                        {
                            <div class="comentario-cabecera">
                                <span class="comentario-autor">@comentario.Autor</span>
                                <span class="comentario-fecha">@comentario.Fecha</span>
                            </div>
                        }
                        <div class="comentario-texto">@comentario.Texto</div>
                    </div>
                }
            </section>
        }

        <!-- Firmas -->
        <section class="firmas">
            <div class="firma">
                <strong>@(string.IsNullOrEmpty(sol.AutorizaAdmin) ? " " : sol.AutorizaAdmin)</strong>
                <span>Autoriza</span>
            </div>
            <div class="firma">
                <strong>@(Model.TieneResponsable ? Model.ResponsableArea : " ")</strong>
                <span>Responsable del área</span>
            </div>
            <div class="firma">
                <strong>@(string.IsNullOrEmpty(sol.EjecutivoAsignado) ? " " : sol.EjecutivoAsignado)</strong>
                <span>@Model.AreaEntrega</span>
            </div>
        </section>

        <!-- Pie -->
        <footer class="rep-pie">
            <span>SigesST - Sistema de Gestión de Soporte Técnico</span>
        </footer>

    </main>
</body>
</html>
