@page
@model SigesTI.Web.Pages.Solicitudes.GenerarModel
@{
    ViewData["Title"] = "Nueva Solicitud";
    string[] sistemas = { "Encuentro.NET", "ADMIN", "BDD", "SITA", "COA", "DNLP", "VUCEM", "ADCO" };
}

<link rel="stylesheet" href="~/css/Solicitudes/solicitudes.css" asp-append-version="true" />

<div class="solicitudes-container">

    <div class="sol-encabezado">
        <div class="sol-encabezado-titulo">
            <div class="sol-icono"><i class="bi bi-file-earmark-plus"></i></div>
            <div>
                <h3>Nueva solicitud</h3>
                <p>Formato de requerimientos de Soporte Técnico</p>
            </div>
        </div>
        <div class="sol-acciones">
            <a href="/Solicitudes/Consultar" class="btn btn-primary-sigest">
                <i class="bi bi-collection me-1"></i> Ver solicitudes
            </a>
        </div>
    </div>

    <form method="post" id="formSolicitud">
        <div class="row g-4">

            <div class="col-lg-8">

                <div class="sol-tarjeta">
                    <div class="sol-tarjeta-titulo"><span class="sol-paso">1</span> Datos del solicitante</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="ddlArea">Área</label>
                            <select asp-for="AreaAuxiliar" asp-items="Model.AreasOptions" id="ddlArea" class="form-select" required>
                                <option value="">Seleccione un área</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ddlPersonal">Nombre del solicitante</label>
                            <select asp-for="NuevaSolicitud.IdPersonal" id="ddlPersonal" class="form-select" required>
                                <option value="">Primero seleccione un área</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="txtPuesto">Puesto</label>
                            <input type="text" asp-for="NuevaSolicitud.PuestoSolicitante" id="txtPuesto" class="form-control sol-dato" placeholder="—" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="txtCorreo">Correo electrónico</label>
                            <input type="email" asp-for="NuevaSolicitud.CorreoSolicitante" id="txtCorreo" class="form-control sol-dato" placeholder="—" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="txtResponsable">Responsable del área</label>
                            <input type="text" asp-for="NuevaSolicitud.ResponsableArea" id="txtResponsable" class="form-control sol-dato" placeholder="—" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label d-block">¿Tiene impresora configurada?</label>
                            <div class="sol-segmentos">
                                <input type="radio" name="ImpresoraConfiguradaAux" id="config_si" value="Si">
                                <label for="config_si">Sí</label>
                                <input type="radio" name="ImpresoraConfiguradaAux" id="config_no" value="No" checked>
                                <label for="config_no">No</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="sol-tarjeta">
                    <div class="sol-tarjeta-titulo"><span class="sol-paso">2</span> Requerimiento</div>

                    <label class="form-label" for="txtDescripcion">Descripción del requisito</label>
                    <textarea asp-for="NuevaSolicitud.DescripcionRequisito" id="txtDescripcion" class="form-control" rows="5" required
                              placeholder="Describa con detalle lo que necesita el solicitante..."></textarea>

                    <div class="sol-separador"></div>

                    <label class="sol-switch" for="chkReqSistemas">
                        <span class="sol-switch-texto">
                            <strong>Requiere acceso o soporte a sistemas</strong>
                            <span>Marque los sistemas involucrados en la solicitud</span>
                        </span>
                        <span class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="NuevaSolicitud.ReqSistemas" id="chkReqSistemas">
                        </span>
                    </label>

                    <div id="seccionSistemas" class="sol-desplegable d-none">
                        <div class="sol-chips">
                            @foreach (var sistema in sistemas)
                            {
                                <input type="checkbox" name="SistemasSeleccionados" value="@sistema" id="chk_@sistema">
                                <label for="chk_@sistema">@sistema</label>
                            }
                            <input type="checkbox" name="SistemasSeleccionados" value="Otros" id="chkOtros">
                            <label for="chkOtros">Otros</label>
                        </div>
                        <input type="text" asp-for="NuevaSolicitud.OtrosSistemas" id="txtOtrosSistemas" class="form-control mt-3 d-none" placeholder="Especifique el otro sistema" />
                    </div>
                </div>

                <div class="sol-tarjeta">
                    <div class="sol-tarjeta-titulo"><span class="sol-paso">3</span> Configuraciones adicionales</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="sol-switch" for="chkHabilitarRed">
                                <span class="sol-switch-texto">
                                    <strong>Habilitar unidad de red</strong>
                                    <span>Dar acceso a una carpeta compartida</span>
                                </span>
                                <span class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="chkHabilitarRed">
                                </span>
                            </label>
                            <div id="divContenedorRed" class="sol-desplegable d-none">
                                <input type="text" asp-for="NuevaSolicitud.NuevaUnidadRed" id="txtDetalleRed" class="form-control" placeholder="Nombre de la unidad de red" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="sol-switch" for="chkConfigurarImpresora">
                                <span class="sol-switch-texto">
                                    <strong>Configurar impresora</strong>
                                    <span>Instalar o configurar un equipo de impresión</span>
                                </span>
                                <span class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="chkConfigurarImpresora">
                                </span>
                            </label>
                            <div id="divContenedorImpresora" class="sol-desplegable d-none">
                                <input type="text" asp-for="NuevaSolicitud.DetalleImpresora" id="txtDetalleImpresora" class="form-control" placeholder="Modelo o detalles de la impresora" />
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-lg-4">
                <div class="sol-lateral">

                    <div class="sol-tarjeta">
                        <div class="sol-tarjeta-titulo"><i class="bi bi-clock-history"></i> Control de tiempos</div>

                        <label class="form-label" for="txtFechaIngreso">Fecha de ingreso</label>
                        <input type="date" asp-for="NuevaSolicitud.FechaIngreso" id="txtFechaIngreso" class="form-control mb-3" required />

                        <label class="form-label d-block">Estatus</label>
                        <div class="sol-segmentos mb-3">
                            <input type="radio" asp-for="NuevaSolicitud.Estatus" value="Pendiente" id="estatusPendiente" class="seg-pendiente">
                            <label for="estatusPendiente"><i class="bi bi-hourglass-split"></i> Pendiente</label>
                            <input type="radio" asp-for="NuevaSolicitud.Estatus" value="Resuelto" id="estatusResuelto" class="seg-resuelto">
                            <label for="estatusResuelto"><i class="bi bi-check2-circle"></i> Resuelto</label>
                        </div>

                        <label class="form-label" for="txtFechaEntrega">Fecha de realización</label>
                        <input type="date" asp-for="NuevaSolicitud.FechaEntrega" id="txtFechaEntrega" class="form-control" />
                        <div class="form-text text-secondary small mt-1">Solo aplica cuando la solicitud está resuelta.</div>
                    </div>

                    <div class="sol-tarjeta">
                        <div class="sol-tarjeta-titulo"><i class="bi bi-person-gear"></i> Asignación</div>

                        <label class="form-label" for="ddlEjecutivo">Ejecutivo de soporte</label>
                        <select asp-for="NuevaSolicitud.EjecutivoAsignado" asp-items="Model.SoporteOptions" id="ddlEjecutivo" class="form-select mb-3">
                            <option value="">Sin asignar</option>
                        </select>

                        <label class="form-label" for="ddlAutoriza">Autorización (Administración)</label>
                        <select asp-for="NuevaSolicitud.AutorizaAdmin" asp-items="Model.AdminOptions" id="ddlAutoriza" class="form-select">
                            <option value="">Sin autorización</option>
                        </select>
                        <div class="sol-ayuda">
                            <i class="bi bi-info-circle"></i>
                            Si eliges a alguien, la solicitud queda pendiente por autorizar y le llega una notificación.
                        </div>
                    </div>

                    @if (await Permisos.PuedeAsync(Modulos.GenerarSolicitud, Accion.Crear))
                    {
                        <button type="submit" class="btn btn-guardar sol-btn-generar">
                            <i class="bi bi-save"></i> Generar solicitud
                        </button>
                    }
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/solicitudes.js" asp-append-version="true"></script>
}
