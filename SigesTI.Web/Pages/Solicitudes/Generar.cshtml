@page
@model SigesTI.Web.Pages.Solicitudes.GenerarModel
@{
    ViewData["Title"] = "Nueva Solicitud";
}

<h2>Formato de Requerimientos de Soporte Técnico</h2>
<hr />

<form method="post">
    <h4>Datos del Solicitante</h4>
    <div style="margin-bottom: 15px;">
        <label>Área:</label>
        <select id="ddlArea" name="Solicitud.Area" class="form-control" asp-items="Model.AreasOptions">
            <option value="">-- Seleccione Área --</option>
        </select>
    </div>

    <div style="margin-bottom: 15px;">
        <label>Nombre del Solicitante:</label>
        <select id="ddlPersonal" name="Solicitud.PersonalId" class="form-control">
            <option value="">-- Seleccione Personal --</option>
        </select>
    </div>

    <div style="margin-bottom: 15px;">
        <label>Correo Electrónico:</label>
        <input id="txtCorreo" type="text" name="Solicitud.Correo" class="form-control" readonly />
    </div>

    <hr />

    <h4>Sistemas Requeridos</h4>

    <div style="margin-bottom: 10px;">
        <input type="checkbox" name="Solicitud.ReqEncuentro" value="true" /> ENCUENTRO.NET
    </div>
    <div style="margin-bottom: 10px;">
        <input type="checkbox" name="Solicitud.ReqAdmin" value="true" /> ADMIN
    </div>
    <div style="margin-bottom: 10px;">
        <input type="checkbox" name="Solicitud.ReqChecador" value="true" /> Checador
    </div>
    <div style="margin-bottom: 10px;">
        <input type="checkbox" name="Solicitud.ReqContpaqi" value="true" /> Contpaqi
    </div>
    <div style="margin-bottom: 10px;">
        <input type="checkbox" name="Solicitud.ReqFacturacion" value="true" /> Facturación
    </div>

    <hr />

    <h4>Otros Requerimientos</h4>
    <div style="margin-bottom: 15px;">
        <label>Unidades de Red (Detalles):</label>
        <input type="text" name="Solicitud.UnidadesRedDetalle" class="form-control" />
    </div>

    <div style="margin-bottom: 15px;">
        <label>Impresora (Detalles):</label>
        <input type="text" name="Solicitud.ImpresoraDetalle" class="form-control" />
    </div>

    <div style="border: 1px solid #ccc; padding: 15px; background-color: #f9f9f9; margin-bottom: 15px;">
        <input id="chkOtros" type="checkbox" name="Solicitud.ReqOtros" value="true" /> <strong>OTROS</strong>
        <br /><br />
        <textarea id="txtOtrosDetalle" name="Solicitud.OtrosDetalle" class="form-control" rows="3" disabled></textarea>
    </div>

    <hr />

    <h4>Control Interno</h4>
    <div style="margin-bottom: 15px;">
        <label>Ejecutivo de Soporte Asignado:</label>
        <select name="Solicitud.SoporteAsignadoId" class="form-control" asp-items="Model.SoporteOptions">
            <option value="">-- Seleccione Ejecutivo --</option>
        </select>
    </div>

    <div style="margin-bottom: 15px;">
        <label>Firma Administrativa:</label>
        <select name="Solicitud.StatusAdministracion" class="form-control">
            <option value="Pendiente">Pendiente</option>
            <option value="Autorizado">Autorizado</option>
            <option value="Rechazado">Rechazado</option>
        </select>
    </div>

    <div style="margin-bottom: 15px;">
        <label>Responsable de Área:</label>
        <select name="Solicitud.StatusResponsable" class="form-control">
            <option value="Pendiente">Pendiente</option>
            <option value="Aprobado">Aprobado</option>
        </select>
    </div>

    <br />
    <button type="submit" class="btn btn-success">GUARDAR SOLICITUD</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {

            // 1. Al cambiar el combo de Área, cargamos su personal por AJAX
            $("#ddlArea").change(function () {
                var nombreArea = $(this).val();

                $("#ddlPersonal").empty().append('<option value="">-- Seleccione Personal --</option>');
                $("#txtCorreo").val("");

                if (nombreArea !== "") {
                    // Petición limpia pasando el nombre del área tal como figura en tu C#
                    $.getJSON("?handler=PersonalPorArea&areaNombre=" + encodeURIComponent(nombreArea), function (data) {
                        $.each(data, function (index, item) {
                            // Guardamos el correo en el atributo 'data-correo' de la opción HTML
                            $("#ddlPersonal").append('<option value="' + item.id + '" data-correo="' + item.correo + '">' + item.nombreCompleto + '</option>');
                        });
                    });
                }
            });

            // 2. Al cambiar el personal, leemos el atributo correo y lo pintamos al instante
            $("#ddlPersonal").change(function () {
                var correo = $(this).find(':selected').data('correo');
                if (correo) {
                    $("#txtCorreo").val(correo);
                } else {
                    $("#txtCorreo").val("");
                }
            });

            // 3. Habilitar o deshabilitar el cuadro de texto "Otros" mediante el checkbox
            $("#chkOtros").change(function () {
                if ($(this).is(':checked')) {
                    $("#txtOtrosDetalle").prop('disabled', false);
                } else {
                    $("#txtOtrosDetalle").prop('disabled', true);
                    $("#txtOtrosDetalle").val("");
                }
            });

        });
    </script>
}