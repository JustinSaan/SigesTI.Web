@page
@model SigesTI.Web.Pages.Solicitudes.ConsultarModel
@using SigesTI.Web.Models
@{
    ViewData["Title"] = "Consultar Solicitudes";

    bool permisoCrear = await Permisos.PuedeAsync(Modulos.GenerarSolicitud, Accion.Crear);
    bool permisoEditar = await Permisos.PuedeAsync(Modulos.ConsultarSolicitudes, Accion.Editar);
    bool permisoEliminar = await Permisos.PuedeAsync(Modulos.ConsultarSolicitudes, Accion.Eliminar);
    bool permisoExportar = await Permisos.PuedeAsync(Modulos.ConsultarSolicitudes, Accion.Exportar);

    int totalPorAutorizar = Model.Solicitudes.Count(s => s.Estatus == EstatusSolicitud.PorAutorizar);
    int totalPendientes = Model.Solicitudes.Count(s => s.Estatus == EstatusSolicitud.Pendiente);
    int totalResueltas = Model.Solicitudes.Count(s => s.Estatus == EstatusSolicitud.Resuelto);

    string[] sistemas = { "Encuentro.NET", "ADMIN", "BDD", "SITA", "COA", "DNLP", "VUCEM", "ADCO" };
}

@functions {
    // Clase de color del badge según el área (mismos colores que Plan de Respaldos)
    static string ClaseArea(string? area)
    {
        return area switch
        {
            "Administración" => "area-administracion",
            "Cobranza" => "area-cobranza",
            "Ventas" => "area-ventas",
            "Consultoría" => "area-consultoria",
            "Soporte Técnico" or "Soporte" => "area-soporte",
            _ => ""
        };
    }
}

@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/Solicitudes/solicitudes.css" asp-append-version="true" />

<div id="loaderFiltro" class="sol-cargando d-none">
    <div class="sol-cargando-caja">
        <div class="spinner-border text-info mb-3" role="status"></div>
        <h6 class="fw-bold mb-1">Cargando</h6>
        <span>Sincronizando con el servidor...</span>
    </div>
</div>

<div class="solicitudes-container">

    <div class="sol-encabezado">
        <div class="sol-encabezado-titulo">
            <div class="sol-icono"><i class="bi bi-collection"></i></div>
            <div>
                <h3>Solicitudes de requerimientos</h3>
                <p>Seguimiento de las solicitudes de Soporte Técnico</p>
            </div>
        </div>
        <div class="sol-acciones">
            @if (permisoExportar)
            {
                <button type="button" class="btn btn-imprimir-sigest" data-bs-toggle="modal" data-bs-target="#modalExportarSolicitudes">
                    <i class="bi bi-printer me-1"></i> Exportar
                </button>
            }
            @if (permisoCrear)
            {
                <a href="/Solicitudes/Generar" class="btn btn-primary-sigest">
                    <i class="bi bi-plus-circle-fill me-1"></i> Nueva solicitud
                </a>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="sol-indicador">
                <div class="sol-icono"><i class="bi bi-inboxes"></i></div>
                <div>
                    <div class="sol-indicador-valor">@Model.Solicitudes.Count</div>
                    <div class="sol-indicador-texto">Total</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="sol-indicador por-autorizar">
                <div class="sol-icono"><i class="bi bi-shield-exclamation"></i></div>
                <div>
                    <div class="sol-indicador-valor">@totalPorAutorizar</div>
                    <div class="sol-indicador-texto">Por autorizar</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="sol-indicador pendiente">
                <div class="sol-icono"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="sol-indicador-valor">@totalPendientes</div>
                    <div class="sol-indicador-texto">Pendientes</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="sol-indicador resuelto">
                <div class="sol-icono"><i class="bi bi-check2-circle"></i></div>
                <div>
                    <div class="sol-indicador-valor">@totalResueltas</div>
                    <div class="sol-indicador-texto">Resueltas</div>
                </div>
            </div>
        </div>
    </div>

    <div class="sol-panel overflow-hidden">

        <div class="sol-panel-encabezado">
            <span><i class="bi bi-collection me-2"></i>Solicitudes de requerimientos</span>

            <div class="sol-herramientas">
                <div class="sol-buscador">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" id="inputFiltroReactivo" class="form-control"
                           placeholder="Buscar por folio, solicitante, ejecutivo..." aria-label="Buscar solicitud" autocomplete="off" />
                </div>

                <div class="sol-cantidad">
                    <label for="itemsPorPagina">Mostrar</label>
                    <select id="itemsPorPagina" class="form-select">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>
        </div>

        <form method="get" id="formFiltros" class="sol-filtros">
            <div class="sol-filtro">
                <label>Área</label>
                <select asp-for="FiltrarArea" asp-items="Model.ListaAreas" class="form-select filtro-servidor-auto">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="sol-filtro">
                <label>Solicitante</label>
                <select asp-for="FiltrarSolicitante" asp-items="Model.ListaPersonalFiltro" class="form-select filtro-servidor-auto">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="sol-filtro">
                <label>Fecha de ingreso</label>
                <input type="date" asp-for="FiltrarFecha" class="form-control filtro-servidor-auto" />
            </div>
            <div class="sol-filtro">
                <label>Estatus</label>
                <select asp-for="FiltrarEstatus" class="form-select filtro-servidor-auto">
                    <option value="">Todos</option>
                    <option value="Por autorizar">Pendiente por autorizar</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Resuelto">Resuelto</option>
                </select>
            </div>
            <a href="/Solicitudes/Consultar" class="btn btn-limpiar-filtros">
                <i class="bi bi-eraser me-1"></i> Limpiar filtros
            </a>
        </form>

        <div class="table-responsive sol-tabla-contenedor">
            <table class="sol-tabla align-middle text-center text-nowrap mb-0" id="tablaBitacoraPrincipal">
                <thead>
                    <tr>
                        <th colspan="2" class="th-grupo">Solicitud</th>
                        <th colspan="5" class="th-grupo">Atención</th>
                        <th class="th-grupo">Gestión</th>
                    </tr>
                    <tr>
                        <th>Folio</th>
                        <th>Solicitante y correo</th>
                        <th>Área</th>
                        <th>Ingreso</th>
                        <th>Realización</th>
                        <th>Ejecutivo asignado</th>
                        <th>Estatus</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Solicitudes.Any())
                    {
                        <tr class="sol-fila-vacia">
                            <td colspan="8" class="sol-vacio">
                                <i class="bi bi-inbox"></i>
                                <span>Ninguna solicitud coincide con los filtros aplicados.</span>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Solicitudes)
                    {
                        // Admin edita cualquier solicitud; los demás roles solo las que no están resueltas
                        bool esResuelta = item.Estatus == EstatusSolicitud.Resuelto;
                        bool puedeEditar = Permisos.EsAdmin || !esResuelta;
                        bool tieneEntrega = esResuelta && item.FechaEntrega.HasValue && item.FechaEntrega.Value.Year > 1901;

                        <tr>
                            <td><span class="sol-folio">@item.IdSolicitud.ToString("D4")</span></td>
                            <td>
                                <span class="sol-persona-nombre d-block">@(item.Personal?.Nombre ?? "N/A")</span>
                                <span class="sol-persona-correo">@item.CorreoSolicitante</span>
                            </td>
                            <td>
                                <span class="sol-area @ClaseArea(item.Personal?.Area)">@(item.Personal?.Area ?? "N/A")</span>
                            </td>
                            <td><span class="sol-texto-fecha">@item.FechaIngreso.ToString("dd/MM/yyyy")</span></td>
                            <td>
                                @if (tieneEntrega)
                                {
                                    <span class="sol-texto-fecha">@item.FechaEntrega!.Value.ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <span class="sol-texto-tenue">En proceso</span>
                                }
                            </td>
                            <td>
                                @if (string.IsNullOrEmpty(item.EjecutivoAsignado))
                                {
                                    <span class="sol-texto-tenue">Sin asignar</span>
                                }
                                else
                                {
                                    <span class="sol-celda-nombre">@item.EjecutivoAsignado</span>
                                }
                            </td>
                            <td>
                                @switch (item.Estatus)
                                {
                                    case EstatusSolicitud.PorAutorizar:
                                        <span class="sol-estatus por-autorizar" title="Espera la autorización de @item.AutorizaAdmin">
                                            <i class="bi bi-shield-exclamation"></i>Pendiente por autorizar
                                        </span>
                                        break;
                                    case EstatusSolicitud.Resuelto:
                                        <span class="sol-estatus resuelto"><i class="bi bi-check2"></i>Resuelto</span>
                                        break;
                                    default:
                                        <span class="sol-estatus pendiente"><i class="bi bi-hourglass-split"></i>Pendiente</span>
                                        break;
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-1">
                                    <button type="button" class="btn btn-accion-tabla btn-ver btn-visualizar" data-id="@item.IdSolicitud"
                                            title="Ver solicitud" aria-label="Ver la solicitud @item.IdSolicitud.ToString("D4")">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    @if (permisoEditar)
                                    {
                                        <button type="button" class="btn btn-accion-tabla btn-editar btn-editar-directo" data-id="@item.IdSolicitud"
                                                title="@(puedeEditar ? "Editar solicitud" : "La solicitud ya está resuelta")" disabled="@(!puedeEditar)"
                                                aria-label="Editar la solicitud @item.IdSolicitud.ToString("D4")">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    }
                                    @if (permisoEliminar)
                                    {
                                        <button type="button" class="btn btn-accion-tabla btn-eliminar" data-id="@item.IdSolicitud"
                                                title="Eliminar solicitud" aria-label="Eliminar la solicitud @item.IdSolicitud.ToString("D4")">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                    <tr id="filaSinCoincidencias" class="sol-fila-vacia d-none">
                        <td colspan="8" class="sol-vacio">
                            <i class="bi bi-search"></i>
                            <span>Ninguna solicitud coincide con "<span id="filterQueryValue"></span>".</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="sol-pie-tabla">
            <span id="infoPaginacion">Mostrando 0 solicitudes</span>
            <nav id="contenedorControlesPagina" class="sol-paginacion" aria-label="Paginación de solicitudes"></nav>
        </div>
    </div>
</div>

<!-- Detalle / edición de la solicitud -->
<div class="modal fade modal-solicitud" id="modalSolicitud" data-bs-backdrop="static" tabindex="-1" aria-labelledby="modalSolicitudLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="mer-icono"><i class="bi bi-file-earmark-text"></i></div>
                    <div>
                        <h5 class="modal-title mb-0" id="modalSolicitudLabel">Solicitud <span id="modal_Folio"></span></h5>
                        <small class="mer-subtitulo" id="modal_Subtitulo">Modo lectura</small>
                    </div>
                </div>
                <button type="button" class="mer-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="modal_IdSolicitud" />

                <div class="row g-3">
                    <div class="col-lg-8">

                        <div class="sol-tarjeta">
                            <div class="sol-tarjeta-titulo"><i class="bi bi-person-badge"></i> Solicitante</div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="modal_Area">Área</label>
                                    <select id="modal_Area" class="form-select ctrl-modal">
                                        @foreach (var area in Model.ListaAreas)
                                        {
                                            <option value="@area.Value">@area.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="modal_IdPersonal">Nombre del solicitante</label>
                                    <select id="modal_IdPersonal" class="form-select ctrl-modal"></select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Puesto</label>
                                    <input type="text" id="modal_Puesto" class="form-control sol-dato" readonly />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Correo electrónico</label>
                                    <input type="email" id="modal_Correo" class="form-control sol-dato" readonly />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Responsable del área</label>
                                    <input type="text" id="modal_Responsable" class="form-control sol-dato" readonly />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label d-block">¿Tiene impresora configurada?</label>
                                    <div class="sol-segmentos">
                                        <input type="radio" name="modal_Impresora" id="modal_config_si" value="Si" class="ctrl-modal">
                                        <label for="modal_config_si">Sí</label>
                                        <input type="radio" name="modal_Impresora" id="modal_config_no" value="No" class="ctrl-modal">
                                        <label for="modal_config_no">No</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="sol-tarjeta" id="modal_bloque_global_sistemas">
                            <div class="sol-tarjeta-titulo"><i class="bi bi-cpu"></i> Sistemas requeridos</div>
                            <label class="sol-switch" for="modal_chkReqSistemas">
                                <span class="sol-switch-texto">
                                    <strong>Requiere acceso o soporte a sistemas</strong>
                                </span>
                                <span class="form-check form-switch">
                                    <input class="form-check-input ctrl-modal" type="checkbox" id="modal_chkReqSistemas">
                                </span>
                            </label>
                            <div id="modal_seccionSistemas" class="sol-desplegable d-none">
                                <div class="sol-chips">
                                    @foreach (var sistema in sistemas)
                                    {
                                        <input type="checkbox" class="custom-modal-sistemas-chk ctrl-modal" value="@sistema" id="modal_chk_@sistema">
                                        <label for="modal_chk_@sistema">@sistema</label>
                                    }
                                    <input type="checkbox" class="custom-modal-sistemas-chk ctrl-modal" value="Otros" id="modal_chkOtros">
                                    <label for="modal_chkOtros">Otros</label>
                                </div>
                                <input type="text" id="modal_txtOtrosSistemas" class="form-control ctrl-modal mt-3 d-none" placeholder="Especifique el otro sistema" />
                            </div>
                        </div>

                        <div class="sol-tarjeta" id="modal_tarjeta_config">
                            <div class="sol-tarjeta-titulo"><i class="bi bi-sliders"></i> Configuraciones adicionales</div>
                            <div class="row g-3">
                                <div class="col-md-6" id="modal_bloque_red">
                                    <label class="sol-switch" for="modal_chkHabilitarRed">
                                        <span class="sol-switch-texto"><strong>Habilitar unidad de red</strong></span>
                                        <span class="form-check form-switch">
                                            <input class="form-check-input ctrl-modal" type="checkbox" id="modal_chkHabilitarRed">
                                        </span>
                                    </label>
                                    <div id="modal_divContenedorRed" class="sol-desplegable d-none">
                                        <input type="text" id="modal_txtDetalleRed" class="form-control ctrl-modal" placeholder="Nombre de la unidad de red" />
                                    </div>
                                </div>
                                <div class="col-md-6" id="modal_bloque_impresora">
                                    <label class="sol-switch" for="modal_chkConfigurarImpresora">
                                        <span class="sol-switch-texto"><strong>Configurar impresora</strong></span>
                                        <span class="form-check form-switch">
                                            <input class="form-check-input ctrl-modal" type="checkbox" id="modal_chkConfigurarImpresora">
                                        </span>
                                    </label>
                                    <div id="modal_divContenedorImpresora" class="sol-desplegable d-none">
                                        <input type="text" id="modal_txtDetalleImpresora" class="form-control ctrl-modal" placeholder="Modelo o detalles de la impresora" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="sol-tarjeta mb-0">
                            <div class="sol-tarjeta-titulo"><i class="bi bi-chat-dots"></i> Historial de comentarios</div>

                            <div id="modal_Historial" class="box-historial-comentarios"></div>

                            <div id="modal_bloque_apunte" class="mt-3 d-none">
                                <label class="form-label" for="modal_DescripcionProblema">Agregar nuevo comentario</label>
                                <textarea id="modal_DescripcionProblema" class="form-control ctrl-modal" rows="3"
                                          placeholder="Escribe las notas de seguimiento..."></textarea>
                            </div>
                        </div>

                    </div>

                    <div class="col-lg-4">
                        <div class="sol-tarjeta">
                            <div class="sol-tarjeta-titulo"><i class="bi bi-clock-history"></i> Control de tiempos</div>

                            <label class="form-label" for="modal_FechaIngreso">Fecha de ingreso</label>
                            <input type="date" id="modal_FechaIngreso" class="form-control ctrl-modal mb-3" />

                            <label class="form-label d-block">Estatus</label>

                            <!-- Mientras espera autorización el estatus no se puede cambiar -->
                            <div id="modal_AvisoAutorizacion" class="sol-aviso-autorizacion mb-3 d-none">
                                <i class="bi bi-shield-exclamation"></i>
                                <span>Pendiente por autorizar por <strong id="modal_AvisoAutorizador"></strong></span>
                            </div>

                            <div id="modal_SegmentosEstatus" class="sol-segmentos mb-3">
                                <input type="radio" name="modal_Estatus" id="modal_EstatusPendiente" value="Pendiente" class="ctrl-modal seg-pendiente">
                                <label for="modal_EstatusPendiente"><i class="bi bi-hourglass-split"></i> Pendiente</label>
                                <input type="radio" name="modal_Estatus" id="modal_EstatusResuelto" value="Resuelto" class="ctrl-modal seg-resuelto">
                                <label for="modal_EstatusResuelto"><i class="bi bi-check2-circle"></i> Resuelto</label>
                            </div>

                            <label class="form-label" for="modal_FechaEntrega">Fecha de realización</label>
                            <input type="date" id="modal_FechaEntrega" class="form-control ctrl-modal" />
                        </div>

                        <div class="sol-tarjeta mb-0">
                            <div class="sol-tarjeta-titulo"><i class="bi bi-person-gear"></i> Asignación</div>

                            <label class="form-label" for="modal_EjecutivoAsignado">Ejecutivo de soporte</label>
                            <select id="modal_EjecutivoAsignado" class="form-select ctrl-modal mb-3">
                                <option value="">Sin asignar</option>
                                @foreach (var tecnico in Model.SoporteOptions)
                                {
                                    <option value="@tecnico.Value">@tecnico.Text</option>
                                }
                            </select>

                            <label class="form-label" for="modal_AutorizaAdmin">Autorización (Administración)</label>
                            <select id="modal_AutorizaAdmin" class="form-select ctrl-modal">
                                <option value="">Sin autorización</option>
                                @foreach (var admin in Model.AdminOptions)
                                {
                                    <option value="@admin.Value">@admin.Text</option>
                                }
                            </select>

                            <div id="modal_InfoAutorizacion" class="sol-info-autorizacion mt-3 d-none">
                                <i class="bi bi-patch-check-fill"></i>
                                <span>Autorizado por <strong id="modal_AutorizadoPor"></strong><br /><small id="modal_FechaAutorizacion"></small></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" id="btnVerFormato" class="btn btn-imprimir-sigest me-auto">
                    <i class="bi bi-file-earmark-richtext me-1"></i> Ver formato
                </button>
                @if (permisoEditar)
                {
                    <button type="button" id="btnLiberarEdicion" class="btn btn-filtros-sigest">
                        <i class="bi bi-unlock-fill me-1"></i> Habilitar edición
                    </button>
                }
                <button type="button" class="btn btn-cancelar" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Cerrar
                </button>
                <button type="button" id="btnGuardarCambiosModal" class="btn btn-guardar px-4 d-none">
                    <i class="bi bi-save"></i> Guardar cambios
                </button>
            </div>

        </div>
    </div>
</div>

@if (permisoExportar)
{
    <!-- Filtros del reporte (mismo diseño que Imprimir bitácora) -->
    <div class="modal fade modal-solicitud" id="modalExportarSolicitudes" tabindex="-1" aria-labelledby="tituloExportarSolicitudes" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="mer-icono"><i class="bi bi-file-earmark-text"></i></div>
                        <div>
                            <h5 class="modal-title mb-0" id="tituloExportarSolicitudes">Exportar solicitudes</h5>
                            <small class="mer-subtitulo">Deja un filtro vacío para incluir todas las solicitudes</small>
                        </div>
                    </div>
                    <button type="button" class="mer-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="modal-body">
                    <form id="formReporteSolicitudes" method="get" action="/Solicitudes/ReporteSolicitudes" target="iframeReporteSolicitudes">

                        <div class="sol-tarjeta">
                            <div class="sol-tarjeta-titulo"><i class="bi bi-calendar-range"></i> Periodo</div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="reporteFechaInicio">Fecha inicial</label>
                                    <input type="date" id="reporteFechaInicio" name="FechaInicio" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="reporteFechaFin">Fecha final</label>
                                    <input type="date" id="reporteFechaFin" name="FechaFin" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="sol-tarjeta mb-0">
                            <div class="sol-tarjeta-titulo"><i class="bi bi-funnel"></i> Filtros</div>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="reporteArea">Área</label>
                                    <select id="reporteArea" name="Area" class="form-select">
                                        <option value="">Todas</option>
                                        @foreach (var area in Model.ListaAreas)
                                        {
                                            <option value="@area.Value">@area.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="reporteSolicitante">Solicitante</label>
                                    <select id="reporteSolicitante" name="Solicitante" class="form-select">
                                        <option value="">Todos</option>
                                        @foreach (var persona in Model.ListaPersonalFiltro)
                                        {
                                            <option value="@persona.Value">@persona.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="reporteEstatus">Estatus</label>
                                    <select id="reporteEstatus" name="Estatus" class="form-select">
                                        <option value="">Todos</option>
                                        <option value="Por autorizar">Pendiente por autorizar</option>
                                        <option value="Pendiente">Pendiente</option>
                                        <option value="Resuelto">Resuelto</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-cancelar" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                    <button type="submit" form="formReporteSolicitudes" class="btn btn-guardar px-4">
                        <i class="bi bi-eye"></i> Ver vista previa
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Vista previa del reporte (mismo diseño que la de Bitácora) -->
    <div class="modal fade modal-solicitud" id="modalVistaReporte" tabindex="-1" aria-labelledby="tituloVistaReporte" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-fullscreen-lg-down">
            <div class="modal-content">

                <div class="modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="mer-icono"><i class="bi bi-file-earmark-richtext"></i></div>
                        <div>
                            <h5 class="modal-title mb-0" id="tituloVistaReporte">Vista previa del reporte</h5>
                            <small class="mer-subtitulo">Revisa el reporte antes de imprimirlo o guardarlo en PDF</small>
                        </div>
                    </div>

                    <div class="sol-vista-acciones">
                        <button type="button" class="btn btn-filtros-sigest" data-bs-toggle="modal" data-bs-target="#modalExportarSolicitudes">
                            <i class="bi bi-sliders me-1"></i> Cambiar filtros
                        </button>
                        <button type="button" class="btn btn-imprimir-sigest" id="btnImprimirReporte">
                            <i class="bi bi-printer me-1"></i> Imprimir
                        </button>
                        <button type="button" class="btn btn-pdf-sigest" id="btnDescargarPdf">
                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Descargar PDF
                        </button>
                        <button type="button" class="mer-btn-cerrar ms-1" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>

                <div class="modal-body sol-vista-previa">
                    <iframe id="iframeReporteSolicitudes"
                            name="iframeReporteSolicitudes"
                            title="Vista previa del reporte de solicitudes"></iframe>
                </div>

            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/solicitudes.js" asp-append-version="true"></script>
}
