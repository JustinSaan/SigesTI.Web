@page
@model SigesTI.Web.Pages.Actividades.IndicadoresModel
@{
    ViewData["Title"] = "Indicadores y Métricas del Área de Soporte Técnico";
}

<link rel="stylesheet" href="~/css/indicadores.css" asp-append-version="true" />

<div class="actividades-container px-4 py-3" id="seccionImpresion">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4 header-reporte">
        <div>
            <h3 class="fw-bold text-white mb-1">
                <i class="bi bi-bar-chart-line-fill me-2 text-info d-print-none"></i>Indicadores y Métricas del Área de Soporte Técnico
            </h3>
            <p class="text-muted small mb-0 fs-6">
                <strong class="text-info">Período de Evaluación:</strong> @Model.FechaInicio?.ToString("dd/MM/yyyy") - @Model.FechaFin?.ToString("dd/MM/yyyy")
            </p>
        </div>
        <div class="d-print-none">
            <button class="btn btn-secondary-sigest btn-sm shadow-sm px-3" onclick="imprimirReporte()">
                <i class="bi bi-printer me-1"></i> Imprimir / Guardar PDF
            </button>
        </div>
    </div>

    <!-- Barra de Filtros -->
    <div class="glass-panel mb-4 p-3 d-print-none">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Fecha Inicio</label>
                <input type="date" class="form-control form-control-sm" name="FechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Fecha Fin</label>
                <input type="date" class="form-control form-control-sm" name="FechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Origen Servicio</label>
                <select class="form-select form-select-sm" name="FiltroOrigen" asp-for="FiltroOrigen">
                    <option value="">-- Todos --</option>
                    <option value="Llamada">Llamada Telefónica</option>
                    <option value="Correo">Correo Electrónico</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-primary-sigest w-100">
                    <i class="bi bi-funnel me-1"></i> Actualizar Métricas
                </button>
            </div>
        </form>
    </div>

    <!-- Tarjetas de KPIs (Hoja 1) -->
    <div class="row g-3 mb-4">
        <div class="col-3">
            <div class="glass-panel p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">Total Atendidos</span>
                        <h2 class="fw-bold mb-0 text-info">@Model.Indicadores.TotalAtendidos</h2>
                        <span class="text-success small"><i class="bi bi-arrow-up-right me-1"></i>En el período</span>
                    </div>
                    <div class="fs-1 text-info bg-info bg-opacity-10 p-3 rounded-3 d-print-none">
                        <i class="bi bi-headset"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-3">
            <div class="glass-panel p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">% Eficiencia Resolución</span>
                        <h2 class="fw-bold mb-0 text-success">@Model.Indicadores.PorcentajeEficiencia%</h2>
                        <span class="text-muted small">@Model.Indicadores.TotalCerrados Cerrados / @Model.Indicadores.TotalEnCurso En curso</span>
                    </div>
                    <div class="fs-1 text-success bg-success bg-opacity-10 p-3 rounded-3 d-print-none">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-3">
            <div class="glass-panel p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">Llamada / Correo</span>
                        <h2 class="fw-bold mb-0 text-primary">@Model.Indicadores.PorcentajeLlamadas% / @Model.Indicadores.PorcentajeCorreos%</h2>
                        <span class="text-muted small">@Model.Indicadores.TotalLlamadas Llamadas / @Model.Indicadores.TotalCorreos Correos</span>
                    </div>
                    <div class="fs-1 text-primary bg-primary bg-opacity-10 p-3 rounded-3 d-print-none">
                        <i class="bi bi-telephone-inbound-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-3">
            <div class="glass-panel p-3 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">Tareas Programadas</span>
                        <h2 class="fw-bold mb-0 text-warning">@Model.Indicadores.PorcentajeAvancePrograma%</h2>
                        <span class="text-muted small">Avance del programa</span>
                    </div>
                    <div class="fs-1 text-warning bg-warning bg-opacity-10 p-3 rounded-3 d-print-none">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bloque 1 de Gráficos (Hoja 1) -->
    <div class="row g-3 mb-4">
        <div class="col-6">
            <div class="glass-panel h-100 overflow-hidden">
                <div class="glass-header">
                    <i class="bi bi-pie-chart-fill me-2 text-info d-print-none"></i>Tickets por Sistema (Porcentajes)
                </div>
                <div class="p-3 d-flex justify-content-center align-items-center chart-container-box">
                    <canvas id="chartSistemas"></canvas>
                </div>
            </div>
        </div>

        <div class="col-6">
            <div class="glass-panel h-100 overflow-hidden">
                <div class="glass-header">
                    <i class="bi bi-bar-chart-steps me-2 text-warning d-print-none"></i>Distribución por Tipo de Requerimiento
                </div>
                <div class="p-3 d-flex justify-content-center align-items-center chart-container-box">
                    <canvas id="chartRequerimientos"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Bloque 2 de Gráficos (Hoja 2) -->
    <div class="row g-3 mb-4 salto-pagina-print">
        <div class="col-6">
            <div class="glass-panel h-100 overflow-hidden">
                <div class="glass-header">
                    <i class="bi bi-diagram-3-fill me-2 text-primary d-print-none"></i>Tickets Escalados y Área Destino
                </div>
                <div class="p-3 d-flex justify-content-center align-items-center chart-container-box">
                    <canvas id="chartEscalaciones"></canvas>
                </div>
            </div>
        </div>

        <div class="col-6">
            <div class="glass-panel h-100 overflow-hidden">
                <div class="glass-header">
                    <i class="bi bi-envelope-at-fill me-2 text-success d-print-none"></i>Medio de Entrada (Llamada vs Correo)
                </div>
                <div class="p-3 d-flex justify-content-center align-items-center chart-container-box">
                    <canvas id="chartCanalEntrada"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla (Hoja 2) -->
    <div class="glass-panel mb-4 overflow-hidden">
        <div class="glass-header">
            <i class="bi bi-shield-check me-2 text-success d-print-none"></i>Estado del Programa de Actividades y Mantenimientos
        </div>
        <div class="p-0 table-responsive">
            <table class="tabla-sigest align-middle text-nowrap mb-0 small">
                <thead>
                    <tr>
                        <th>Programa / Actividad</th>
                        <th>Tipo</th>
                        <th>Fecha Programada</th>
                        <th>Estatus</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TablaProgramas != null && Model.TablaProgramas.Any())
                    {
                        @foreach (var item in Model.TablaProgramas)
                        {
                            var badgeClass = item.Estatus switch
                            {
                                "Realizado" or "Completado" => "bg-success",
                                "En Proceso" => "bg-warning text-dark",
                                "Pendiente" => "bg-secondary",
                                "Cancelado" => "bg-danger",
                                _ => "bg-info"
                            };

                            <tr>
                                <td class="fw-bold text-white">@item.Nombre</td>
                                <td>@item.Tipo</td>
                                <td class="text-center">@item.FechaProgramada</td>
                                <td class="text-center"><span class="badge @badgeClass px-2 py-1">@item.Estatus</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">No hay actividades ni mantenimientos registrados en este período.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Observaciones (Hoja 2) -->
    <div class="glass-panel mb-4 overflow-hidden">
        <div class="glass-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-chat-left-text-fill me-2 text-info d-print-none"></i>Observaciones y Notas Ejecutivas</span>
            <div class="form-check form-switch mb-0 d-print-none">
                <input class="form-check-input" type="checkbox" id="chkHabilitarObservaciones" onchange="toggleObservaciones()" />
                <label class="form-check-input-label text-muted small ms-1" for="chkHabilitarObservaciones">Habilitar Observaciones</label>
            </div>
        </div>
        <div class="p-3" id="panelObservaciones" style="display: none;">
            <textarea id="txtObservaciones" class="form-control" rows="3" placeholder="Escriba aquí las observaciones o consideraciones del reporte..."></textarea>
            <div id="printObservacionesText" class="d-none text-white small p-2"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
    
    <script>
        // Puente de datos entre C# y Javascript
        window.dataSistemasServer = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Indicadores.TicketsPorSistema));
        window.dataRequerimientosServer = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Indicadores.TicketsPorTipoRequerimiento));
        window.dataEscalacionesServer = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Indicadores.TicketsEscaladosPorArea));
        window.totalLlamadasServer = @Model.Indicadores.TotalLlamadas;
        window.totalCorreosServer = @Model.Indicadores.TotalCorreos;
    </script>

    <script src="~/js/actividades-indicadores.js" asp-append-version="true"></script>
}