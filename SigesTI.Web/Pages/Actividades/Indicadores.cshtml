@page
@model SigesTI.Web.Pages.Actividades.IndicadoresModel
@using SigesTI.Web.Pages.Shared
@{
    ViewData["Title"] = "Indicadores y Métricas";

    var ind = Model.Indicadores;
    var periodo = Model.Periodo;
    bool puedeExportar = await Permisos.PuedeAsync(Modulos.Indicadores, Accion.Exportar);

    // Recuadro con título, contador y la gráfica en SVG (GraficasSvg.cs); si no hay datos, un aviso
    void Panel(string icono, string titulo, int contador, bool hayDatos, Func<string> grafica, string avisoVacio, string iconoVacio = "bi-inbox")
    {
        <div class="ind-panel">
            <div class="ind-panel-header">
                <span><i class="bi @icono"></i> @titulo</span>
                <span class="ind-contador">@contador</span>
            </div>
            <div class="ind-grafica">
                @if (hayDatos)
                {
                    @Html.Raw(grafica())
                }
                else
                {
                    <div class="ind-vacio"><i class="bi @iconoVacio"></i>@avisoVacio</div>
                }
            </div>
        </div>
    }
}

<link rel="stylesheet" href="~/css/Actividades/indicadores.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Claro/indicadores.claro.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Reportes/reporte-encabezado.css" asp-append-version="true" />

<div class="indicadores" id="seccionImpresion">
    <!-- Encabezado del reporte impreso -->
    <div class="rep-encabezado solo-impresion">
        <div>
            <div class="rep-area">Área de Soporte Técnico</div>
            <div class="rep-titulo">Indicadores y Métricas del Área de Soporte Técnico</div>
        </div>
        <div class="rep-fecha">
            <span>Fecha del reporte</span>
            <strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong>
        </div>
    </div>
    <p class="solo-impresion ind-periodo-reporte">
        <strong>Período de evaluación:</strong> @periodo
        @if (!string.IsNullOrWhiteSpace(Model.FiltroOrigen))
        {
            <span> · <strong>Origen:</strong> @Model.FiltroOrigen</span>
        }
    </p>

    <!-- Encabezado de la pantalla -->
    <header class="ind-header d-print-none">
        <div class="ind-header-texto">
            <span class="ind-icono-titulo"><i class="bi bi-bar-chart-line-fill"></i></span>
            <div>
                <h1 class="ind-titulo">Indicadores y Métricas</h1>
                <p class="ind-subtitulo">Área de Soporte Técnico · <i class="bi bi-calendar3"></i> @periodo</p>
            </div>
        </div>
        @if (puedeExportar)
        {
            <!-- Manda los filtros y las observaciones para armar el PDF -->
            <form method="post" asp-page-handler="Pdf" id="formPdf" class="d-none">
                <input type="hidden" name="FechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="FechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="FiltroOrigen" value="@Model.FiltroOrigen" />
            </form>
        }
    </header>

    <!-- Filtros: se aplican solos al cambiar una fecha o el origen -->
    <form method="get" id="formFiltros" class="ind-filtros d-print-none">
        <div class="ind-campo">
            <label for="FechaInicio">Fecha inicio</label>
            <input type="date" id="FechaInicio" name="FechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="ind-campo">
            <label for="FechaFin">Fecha fin</label>
            <input type="date" id="FechaFin" name="FechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="ind-campo">
            <label for="FiltroOrigen">Origen</label>
            <select asp-for="FiltroOrigen">
                <option value="">Todos</option>
                <option value="Llamada">Llamada</option>
                <option value="Correo">Correo</option>
                <option value="Interno">Interno</option>
            </select>
        </div>
        <div class="ind-filtros-botones">
            <a href="?" class="btn btn-filtros-sigest" title="Volver al mes actual">
                <i class="bi bi-calendar-event me-1"></i> Mes actual
            </a>
            @if (puedeExportar)
            {
                <button type="button" class="btn btn-imprimir-sigest" onclick="imprimirReporte()">
                    <i class="bi bi-printer me-1"></i> Imprimir
                </button>
                <button type="submit" form="formPdf" class="btn btn-pdf-sigest">
                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> Descargar PDF
                </button>
            }
        </div>
    </form>

    <!-- Tarjetas de indicadores -->
    <section class="ind-kpis">
        <article class="ind-kpi ind-azul">
            <div class="ind-kpi-top">
                <span class="ind-kpi-label">Tickets atendidos</span>
                <i class="bi bi-headset ind-kpi-icono"></i>
            </div>
            <div class="ind-kpi-valor">@ind.TotalTickets</div>
            <div class="ind-kpi-detalle ind-kpi-desglose">
                <span><i class="bi bi-telephone"></i> Llamadas: <strong>@ind.TotalLlamadas</strong></span>
                <span><i class="bi bi-envelope"></i> Correos: <strong>@ind.TotalCorreos</strong></span>
                <span><i class="bi bi-building"></i> Internos: <strong>@ind.TotalInternos</strong></span>
            </div>
        </article>

        <article class="ind-kpi ind-verde">
            <div class="ind-kpi-top">
                <span class="ind-kpi-label">Eficiencia de resolución</span>
                <i class="bi bi-check2-circle ind-kpi-icono"></i>
            </div>
            <div class="ind-kpi-valor">@ind.PorcentajeEficiencia<small>%</small></div>
            <!-- Barra partida: en tiempo, retrasados y en curso -->
            <div class="ind-barra ind-barra-partes">
                <span class="ind-parte-tiempo" style="width: @ind.ParteDe(ind.CerradosEnTiempo).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span>
                <span class="ind-parte-retraso" style="width: @ind.ParteDe(ind.CerradosRetrasados).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span>
                <span class="ind-parte-curso" style="width: @ind.ParteDe(ind.TotalEnCurso).ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span>
            </div>
            <div class="ind-kpi-partes">
                <span><i class="ind-punto ind-parte-tiempo"></i>@ind.CerradosEnTiempo en tiempo</span>
                <span><i class="ind-punto ind-parte-retraso"></i>@ind.CerradosRetrasados retrasados</span>
                <span><i class="ind-punto ind-parte-curso"></i>@ind.TotalEnCurso en curso</span>
            </div>
        </article>

        <article class="ind-kpi ind-violeta">
            <div class="ind-kpi-top">
                <span class="ind-kpi-label">Tickets escalados</span>
                <i class="bi bi-diagram-3 ind-kpi-icono"></i>
            </div>
            <div class="ind-kpi-valor">@ind.TotalEscalados</div>
            <div class="ind-kpi-detalle">@ind.PorcentajeEscalados% del total de tickets</div>
            <div class="ind-kpi-partes">
                @foreach (var area in ind.EscaladosPorArea)
                {
                    <span class="ind-chip">@area.Key <b>@area.Value</b></span>
                }
                @if (!ind.EscaladosPorArea.Any())
                {
                    <span>Ningún ticket escalado</span>
                }
            </div>
        </article>

        <article class="ind-kpi ind-ambar">
            <div class="ind-kpi-top">
                <span class="ind-kpi-label">Avance de tareas programadas</span>
                <i class="bi bi-calendar2-check ind-kpi-icono"></i>
            </div>
            <div class="ind-kpi-valor">@ind.PorcentajeAvancePrograma<small>%</small></div>
            <div class="ind-barra"><span style="width: @ind.PorcentajeAvancePrograma.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
            <div class="ind-kpi-detalle">@ind.TareasResueltas de @ind.TotalTareas resueltas</div>
        </article>
    </section>

    <!-- Gráficas en SVG: nítidas en pantalla, al imprimir y en el PDF (mismo dibujo en los tres) -->
    <section class="ind-graficas">
        @{
            Panel("bi-pie-chart-fill", "Tickets por sistema", ind.TotalTickets, ind.TicketsPorSistema.Any(),
                () => GraficasSvg.Dona(AnchoGrafica, AltoGrafica, Model.PartesSistemas), "Sin tickets en el período");
            Panel("bi-bar-chart-steps", "Tipo de requerimiento", ind.TicketsPorTipo.Count, ind.TicketsPorTipo.Any(),
                () => GraficasSvg.Barras(AnchoGrafica, AltoGrafica, Model.PartesTipos), "Sin tickets en el período");
        }
    </section>

    <section class="ind-graficas salto-pagina-print">
        @{
            Panel("bi-bar-chart-fill", "Medio de entrada", ind.TotalLlamadas + ind.TotalCorreos, ind.TotalLlamadas + ind.TotalCorreos > 0,
                () => GraficasSvg.Columnas(AnchoGrafica, AltoGrafica, ind.FechasEntrada, Model.SeriesOrigen, ind.AgrupacionEntrada), "Sin llamadas ni correos en el período");
            Panel("bi-diagram-3-fill", "Escalados por área destino", ind.TotalEscalados, ind.EscaladosPorArea.Any(),
                () => GraficasSvg.Radar(AnchoGrafica, AltoGrafica, Model.PartesEscalados, IndicadoresModel.ColorEscalados), "No hubo tickets escalados", "bi-check2-all");
        }
    </section>

    <section class="ind-graficas">
        @{
            Panel("bi-building", "Clientes más frecuentes", ind.ClientesFrecuentes.Count, ind.ClientesFrecuentes.Any(),
                () => GraficasSvg.Paletas(AnchoGrafica, AltoGrafica, Model.PartesClientes, ind.TotalTickets), "Sin tickets en el período");
            Panel("bi-arrow-left-right", "Servicios internos y externos", ind.ServiciosInternos + ind.TotalTickets, ind.ServiciosInternos + ind.TotalTickets > 0,
                () => GraficasSvg.Comparativo(AnchoGrafica, AltoGrafica, Model.ParteInternos, Model.DetalleInternos, Model.ParteExternos, Model.DetalleExternos),
                "Sin servicios en el período");
        }
    </section>

    <!-- Observaciones: solo salen en el reporte si se escribió algo -->
    <section class="ind-panel" id="panelObservaciones">
        <div class="ind-panel-header">
            <span><i class="bi bi-chat-left-text-fill"></i> Observaciones</span>
        </div>
        <div class="ind-panel-cuerpo">
            <textarea id="txtObservaciones" name="Observaciones" form="formPdf" class="ind-textarea" rows="3" placeholder="Escriba aquí las observaciones que deben aparecer en el reporte (opcional)..."></textarea>
            <div id="printObservacionesText" class="ind-observaciones-reporte"></div>
        </div>
    </section>

    <div class="rep-pie solo-impresion">
        <span>SigesST - Sistema de Gestión de Soporte Técnico</span>
    </div>
</div>

@section Scripts {
    <script src="~/js/Actividades/actividades-indicadores.js" asp-append-version="true"></script>
}

@functions {
    // Tamaño de dibujo de las gráficas en pantalla; el SVG se estira al recuadro y conserva su forma
    private const float AnchoGrafica = 420;
    private const float AltoGrafica = 230;
}
