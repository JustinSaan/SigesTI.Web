<!-- Modal 3: Vista Previa y PDF del Reporte -->
<div class="modal fade" id="modalVistaPreviaReporte" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
        <div class="modal-content modal-ticket text-white border-0">
            <div class="modal-header border-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icono"><i class="bi bi-file-earmark-pdf"></i></div>
                    <div>
                        <h5 class="modal-title fs-6 fw-bold text-white mb-0">Vista Previa del Reporte Diario</h5>
                        <small class="modal-subtitulo">Revisa el reporte antes de imprimirlo o guardarlo en PDF</small>
                    </div>
                </div>
                <button type="button" class="btn-cerrar-modal" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>

            <!-- Contenedor de Impresión: la hoja blanca sobre un fondo oscuro tipo visor -->
            <div class="modal-body vista-previa-fondo">
            <div class="hoja-reporte p-4 text-dark bg-white" id="seccionImpresion">

                <!-- ENCABEZADO -->
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-2 border-primary">
                    <div>
                        <h2 class="fw-bold mb-0 text-uppercase text-dark" style="font-size: 16pt; color: #0f172a !important;">
                            Reporte Diario de Tickets
                        </h2>
                        <span class="text-muted small">Área de Soporte Técnico</span>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-dark text-white px-3 py-2 fs-6">
                            Fecha: @(Model.FechaReporte?.ToString("dd/MM/yyyy"))
                        </span>
                    </div>
                </div>

                <!-- 1. RESUMEN DE INDICADORES -->
                <h6 class="fw-bold text-dark mb-2" style="font-size: 10pt; color: #0f172a !important;">
                    <i class="bi bi-bar-chart-fill me-1 text-primary"></i> 1. Resumen de Indicadores
                </h6>
                <div id="contenedorIndicadoresPrint" class="mb-3"></div>

                <!-- CONCENTRADO Y GRÁFICAS POR SISTEMA EN IMPRESIÓN -->
                <h6 class="fw-bold text-dark mb-2" style="font-size: 10pt; color: #0f172a !important;">
                    <i class="bi bi-pie-chart-fill me-1 text-primary"></i> Concentrado del Día por Sistema
                </h6>

                <!-- Contenedor dinámico de gráficas -->
                <div class="row g-2 mb-3" id="contenedorGraficasPrint">
                    <div class="col-6 text-center">
                        <div class="fw-bold text-dark small mb-1" style="font-size: 8.5pt;">Distribución por sistema</div>
                        <img id="imgChartSistemasPrint" style="max-width: 100%; height: auto; max-height: 190px;" />
                    </div>
                    <div class="col-6 text-center">
                        <div class="fw-bold text-dark small mb-1" style="font-size: 8.5pt;">Estatus de atención por sistema</div>
                        <img id="imgChartEstatusPrint" style="max-width: 100%; height: auto; max-height: 190px;" />
                    </div>
                </div>

                <!-- Tabla de Concentrado para Impresión -->
                <div class="mb-3">
                    <table class="tabla-print-detalle tabla-print-concentrado">
                        <thead>
                            <tr>
                                <th rowspan="2" class="col-sistema">SISTEMA</th>
                                <th rowspan="2">TOTAL</th>
                                <th colspan="3">TIPO</th>
                                <th colspan="3">ORIGEN</th>
                                <th colspan="3">ESTATUS</th>
                                <th rowspan="2">% EN TIEMPO</th>
                            </tr>
                            <tr>
                                <th>INCIDENCIAS</th>
                                <th>SERVICIOS</th>
                                <th>OTROS</th>
                                <th>TELÉFONO</th>
                                <th>CORREO</th>
                                <th>INTERNO</th>
                                <th>TIEMPO Y FORMA</th>
                                <th>ATRASADOS</th>
                                <th>EN CURSO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (concentradoSistemas.Any())
                            {
                                var filasPrint = concentradoSistemas.Append(Model.ConcentradoTotal);
                                @foreach (var s in filasPrint)
                                {
                                    bool esTotal = s == Model.ConcentradoTotal;
                                    <tr style="@(esTotal ? "font-weight: bold; background-color: #e2e8f0;" : "")">
                                        <td class="col-sistema">
                                            @if (esTotal)
                                            {
                                                <b>TOTAL</b>
                                            }
                                            else
                                            {
                                                <span class="badge @ReporteTicketsModel.ClaseSistema(s.Sistema)" style="font-size: 6.5pt !important;">@s.Sistema</span>
                                            }
                                        </td>
                                        <td class="fw-bold">@s.Total</td>
                                        <td>@s.Incidencias</td>
                                        <td>@s.Servicios</td>
                                        <td>@s.Otros</td>
                                        <td>@s.Telefono</td>
                                        <td>@s.Correo</td>
                                        <td>@s.Interno</td>
                                        <td><span class="badge-print-cerrado">@s.TiempoForma</span></td>
                                        <td><span class="badge-print-atrasado">@s.CerradosAtrasados</span></td>
                                        <td><span class="badge-print-encurso">@s.EnCurso</span></td>
                                        <td>@(s.PorcentajeEnTiempo.HasValue ? s.PorcentajeEnTiempo + "%" : "—")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="12" class="text-center py-2 text-muted">No hay datos de concentrado para mostrar.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PUNTOS RELEVANTES DEL DÍA -->
                <h6 class="fw-bold text-dark mb-2" style="font-size: 10pt; color: #0f172a !important;">
                    <i class="bi bi-card-text me-1 text-primary"></i> 2. Puntos Relevantes del Día
                </h6>
                <div class="box-print-resumen text-dark mb-3" style="white-space: pre-wrap; font-size: 9pt;" id="printPuntosRelevantes"></div>

                <!-- DETALLE COMPLETO DE TICKETS EN IMPRESIÓN -->
                <div class="mt-3">
                    <h6 class="fw-bold text-dark mb-2" style="font-size: 10pt; color: #0f172a !important;">
                        <i class="bi bi-list-check me-1 text-primary"></i> Detalle Completo de Tickets
                    </h6>
                    <table class="tabla-print-detalle" id="tablaDetallePrint">
                        <thead>
                            <tr style="background-color: #1e293b; color: #ffffff;">
                                <th class="col-fecha text-center">FECHA DE APERTURA</th>
                                <th class="col-fechasol text-center">FECHA DE SOLUCIÓN</th>
                                <th class="col-hora text-center">HORA DEL REPORTE</th>
                                <th class="col-nocliente text-center">NO. DE CLIENTE</th>
                                <th class="col-cliente text-center">NOMBRE DEL CLIENTE</th>
                                <th class="col-ejecutivo text-center">EJECUTIVO</th>
                                <th class="col-ticket text-center">TICKET</th>
                                <th class="col-estatus text-center">ESTATUS</th>
                                <th class="col-reporto text-center">CONTACTO</th>
                                <th class="col-sistema text-center">SISTEMA</th>
                                <th class="col-entrada text-center">ENTRADA</th>
                                <th class="col-tipo text-center">TIPO</th>
                                <th class="col-descripcion text-center">DESCRIPCIÓN</th>
                                <th class="col-comentarios text-center">COMENTARIOS</th>
                                <th class="col-solucion text-center">SOLUCIÓN</th>
                                <th class="col-escalado text-center">ESCALADO</th>
                                <th class="col-area text-center">ÁREA ESCALADA</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ListaTickets != null && Model.ListaTickets.Any())
                            {
                                @foreach (var item in Model.ListaTickets)
                                {
                                    <tr>
                                        <td class="text-center">@item.FechaEntrada.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">@(item.FechaSolucion.HasValue ? item.FechaSolucion.Value.ToString("dd/MM/yyyy") : "—")</td>
                                        <td class="text-center">@item.Hora</td>
                                        <td class="text-center">@(Model.ClaveCliente(item.Cliente) == "" ? "—" : Model.ClaveCliente(item.Cliente))</td>
                                        <td class="text-center fw-bold">@item.Cliente</td>
                                        <td class="text-center">@item.Ejecutivo</td>
                                        <td class="text-center"><b>@item.NumeroTicket</b></td>
                                        <td class="text-center">
                                            @if (Model.EstatusEnFecha(item) == "Cerrado")
                                            {
                                                <span class="badge-print-cerrado">Cerrado</span>
                                            }
                                            else
                                            {
                                                <span class="badge-print-encurso">En curso</span>
                                            }
                                        </td>
                                        <td class="text-center">@item.Reporto</td>
                                        <td class="text-center col-sistema">
                                            <span class="badge badge-print-sistema @ReporteTicketsModel.ClaseSistema(item.Sistema)">@ReporteTicketsModel.NormalizarSistema(item.Sistema)</span>
                                        </td>
                                        <td class="text-center">@item.Origen</td>
                                        <td class="text-center col-tipo">@item.Tipo</td>
                                        <td class="col-texto-largo col-descripcion">@item.Descripcion</td>
                                        <td class="col-texto-largo col-comentarios">@item.Comentarios</td>
                                        <td class="col-texto-largo col-solucion">@item.Solucion</td>
                                        <td class="text-center">@(item.Escalado ? "Sí" : "No")</td>
                                        <td class="text-center">@(string.IsNullOrEmpty(item.AreaEscalada) ? "Ninguna" : item.AreaEscalada)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="17" class="text-center py-3 text-muted">No hay tickets registrados en esta fecha.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
            </div>

            <div class="modal-footer border-0">
                <button type="button" class="btn btn-sm btn-cancelar px-3" data-bs-dismiss="modal"><i class="bi bi-x-circle"></i> Cerrar</button>
                <button type="button" class="btn btn-sm btn-guardar px-3" onclick="imprimirContenidoLimpio()">
                    <i class="bi bi-printer"></i> Imprimir / Guardar PDF
                </button>
            </div>
        </div>
    </div>
</div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
        <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

        <!-- Mantenemos SOLO las variables de C# (Razor) aquí, ya que el archivo .js no las reconoce -->
        <script>
                const rolUsuario = "@(HttpContext.Session.GetString("Rol") ?? "")";
                const usuarioSesion = "@(HttpContext.Session.GetString("Usuario") ?? "")";
                const nombreSesion = "@(HttpContext.Session.GetString("NombreCompleto") ?? "")";
                const fechaReporteActual = "@(Model.FechaReporte?.ToString("dd-MM-yyyy"))";

                const labelsSistemas = @Json.Serialize(concentradoSistemas.Select(s => s.Sistema));
                const dataTotales = @Json.Serialize(concentradoSistemas.Select(s => s.Total));
                const dataTiempoForma = @Json.Serialize(concentradoSistemas.Select(s => s.TiempoForma));
                const dataCerradosAtrasados = @Json.Serialize(concentradoSistemas.Select(s => s.CerradosAtrasados));
                const dataEnCurso = @Json.Serialize(concentradoSistemas.Select(s => s.EnCurso));
        </script>
    <script src="~/js/Actividades/reporte-tickets.js" asp-append-version="true"></script>
}
