@page
@model SigesTI.Web.Pages.Actividades.ReporteTicketsModel
@{
    ViewData["Title"] = "Reporte Diario de Tickets";
    var fechaConsultaDate = Model.FechaReporte?.Date ?? DateTime.Today;
}

<link rel="stylesheet" href="~/css/actividades.css" asp-append-version="true" />

<div class="actividades-container px-4 py-3">

    <input type="hidden" id="mensajeExito" value="@TempData["MensajeExito"]" />
    <input type="hidden" id="mensajeError" value="@TempData["MensajeError"]" />

    <!-- Encabezado y Acciones -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-white mb-1"><i class="bi bi-journal-check me-2 text-info"></i>Reporte Diario de Tickets</h3>
            <p class="text-muted small mb-0">Gestión de atención diaria y generación de reportes consolidados.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-outline-success btn-secondary-sigest shadow-sm" id="btnExportarExcel" type="button">
                <i class="bi bi-file-earmark-excel me-1 text-success"></i> Exportar Excel
            </button>
            <button class="btn btn-primary-sigest shadow-sm px-3 fw-bold" id="btnGenerarReporte" type="button">
                <i class="bi bi-printer me-1"></i> Generar Reporte
            </button>
            <!-- BOTÓN NUEVO TICKET -->
            <button type="button" 
                    class="btn shadow-sm d-flex align-items-center gap-2 px-3 py-2 ms-1" 
                    data-bs-toggle="modal" 
                    data-bs-target="#modalNuevoTicket"
                    style="background: linear-gradient(135deg, #0284c7, #2563eb); color: #ffffff; border: 1px solid #38bdf8; border-radius: 10px; font-weight: 700; font-size: 0.88rem; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.4); transition: all 0.2s ease;"
                    onmouseover="this.style.background='linear-gradient(135deg, #0369a1, #1d4ed8)'; this.style.transform='translateY(-1px)';"
                    onmouseout="this.style.background='linear-gradient(135deg, #0284c7, #2563eb)'; this.style.transform='translateY(0)';">
                <i class="bi bi-plus-circle-fill fs-6 text-cyan"></i>
                <span>Nuevo Ticket</span>
            </button>
        </div>
    </div>

    <!-- Filtros de Búsqueda -->
    <div class="glass-panel mb-4 p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Fecha de Consulta</label>
                <input type="date" id="fechaReporteConsulta" class="form-control form-control-sm" name="fechaReporte" value="@(Model.FechaReporte?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Sistema</label>
                <select class="form-select form-select-sm" name="filtroSistema" asp-for="FiltroSistema">
                    <option value="">-- Todos los Sistemas --</option>
                    <option value="DIA" style="background-color: #0f172a; color: #60a5fa;">DIA</option>
                    <option value="DIAWEB" style="background-color: #0f172a; color: #38bdf8;">DIAWEB</option>
                    <option value="ConectorDiawebZoe" style="background-color: #704332; color: #ffffff;">CONECTOR DIAWEB-ZOÉ</option>
                    <option value="SITA" style="background-color: #0f172a; color: #fb923c;">SITA</option>
                    <option value="VUCEM" style="background-color: #1d4ed8; color: #ffffff;">VUCEM</option>
                    <option value="DIAENLINEA PREMIUM" style="background-color: #0f172a; color: #4ade80;">DIAENLINEA PREMIUM</option>
                    <option value="COA" style="background-color: #0f172a; color: #22c55e;">COA</option>
                    <option value="ADMIN" style="background-color: #0f172a; color: #ffffff;">ADMIN</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Origen Servicio</label>
                <select class="form-select form-select-sm" name="filtroOrigen" asp-for="FiltroOrigen">
                    <option value="">-- Todos --</option>
                    <option value="Llamada">Llamada</option>
                    <option value="Correo">Correo</option>
                    <option value="Interno">Interno</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-primary-sigest w-100"><i class="bi bi-filter me-1"></i> Filtrar</button>
            </div>
        </form>
    </div>

    <!-- Tabla 1: Indicadores Resumen -->
    <div class="glass-panel mb-4 overflow-hidden">
        <div class="glass-header">
            <i class="bi bi-bar-chart-steps me-2"></i>Indicadores de Atención del Día
        </div>
        <div class="p-0 table-responsive">
            <table class="tabla-sigest text-center align-middle mb-0 small" id="tablaIndicadores">
                <thead>
                    <tr>
                        <th rowspan="2" class="align-middle th-tickets text-center">Tickets</th>
                        <th rowspan="2" class="align-middle th-total text-center">Total</th>
                        <th colspan="4" class="th-tipo text-center">Tipo</th>
                        <th colspan="7" class="th-sistemas-ext text-center">Sistemas Externos</th>
                        <th colspan="1" class="th-sistema-int text-center">Sistema Int.</th>
                        <th colspan="2" class="th-origen text-center">Origen del Ticket</th>
                        <th colspan="4" class="th-escalados text-center">Escalados</th>
                        <th colspan="2" class="th-estatus text-center">Estatus</th>
                    </tr>
                    <tr>
                        <th class="th-tipo text-center">Servicio</th>
                        <th class="th-tipo text-center">Incidencia</th>
                        <th class="th-tipo text-center">Ajuste</th>
                        <th class="th-tipo text-center">Mejora</th>
                        <th class="th-sistemas-ext text-center">DIA</th>
                        <th class="th-sistemas-ext text-center">DIAWEB</th>
                        <th class="th-sistemas-ext text-center">CONECTOR DIAWEB-ZOE</th>
                        <th class="th-sistemas-ext text-center">SITA</th>
                        <th class="th-sistemas-ext text-center">VUCEM</th>
                        <th class="th-sistemas-ext text-center">DIAENLINEA PREMIUM</th>
                        <th class="th-sistemas-ext text-center">COA</th>
                        <th class="th-sistema-int text-center">ADMIN</th>
                        <th class="th-origen text-center">Llamada</th>
                        <th class="th-origen text-center">Correo</th>
                        <th class="th-escalados text-center">Desarrollo</th>
                        <th class="th-escalados text-center">Consultoría</th>
                        <th class="th-escalados text-center">Ventas</th>
                        <th class="th-escalados text-center">Cobranza</th>
                        <th class="th-estatus text-center">Cerrado</th>
                        <th class="th-estatus text-center">En Curso</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-warning text-center">Seguimiento</td>
                        <td class="fw-bold text-center">@Model.IndicadoresSeguimiento.Total</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.Servicio</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.Incidencia</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.Ajuste</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.Mejora</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.DIA</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.DIAWEB</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.ConectorDiawebZoe</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.SITA</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.VUCEM</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.DIAENLINEA</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.COA</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.ADMIN</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.Llamada</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.Correo</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.EscaladoDesarrollo</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.EscaladoConsultoria</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.EscaladoVentas</td>
                        <td class="text-center">@Model.IndicadoresSeguimiento.EscaladoCobranza</td>
                        <td class="text-center"><span class="badge bg-success">@Model.IndicadoresSeguimiento.Cerrado</span></td>
                        <td class="text-center"><span class="badge bg-warning text-dark">@Model.IndicadoresSeguimiento.EnCurso</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-info text-center">Resumen del Día</td>
                        <td class="fw-bold text-center">@Model.IndicadoresDia.Total</td>
                        <td class="text-center">@Model.IndicadoresDia.Servicio</td>
                        <td class="text-center">@Model.IndicadoresDia.Incidencia</td>
                        <td class="text-center">@Model.IndicadoresDia.Ajuste</td>
                        <td class="text-center">@Model.IndicadoresDia.Mejora</td>
                        <td class="text-center">@Model.IndicadoresDia.DIA</td>
                        <td class="text-center">@Model.IndicadoresDia.DIAWEB</td>
                        <td class="text-center">@Model.IndicadoresDia.ConectorDiawebZoe</td>
                        <td class="text-center">@Model.IndicadoresDia.SITA</td>
                        <td class="text-center">@Model.IndicadoresDia.VUCEM</td>
                        <td class="text-center">@Model.IndicadoresDia.DIAENLINEA</td>
                        <td class="text-center">@Model.IndicadoresDia.COA</td>
                        <td class="text-center">@Model.IndicadoresDia.ADMIN</td>
                        <td class="text-center">@Model.IndicadoresDia.Llamada</td>
                        <td class="text-center">@Model.IndicadoresDia.Correo</td>
                        <td class="text-center">@Model.IndicadoresDia.EscaladoDesarrollo</td>
                        <td class="text-center">@Model.IndicadoresDia.EscaladoConsultoria</td>
                        <td class="text-center">@Model.IndicadoresDia.EscaladoVentas</td>
                        <td class="text-center">@Model.IndicadoresDia.EscaladoCobranza</td>
                        <td class="text-center"><span class="badge bg-success">@Model.IndicadoresDia.Cerrado</span></td>
                        <td class="text-center"><span class="badge bg-warning text-dark">@Model.IndicadoresDia.EnCurso</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- CÁLCULO C# PARA CONCENTRADO POR SISTEMA -->
    @{
        var concentradoSistemas = Enumerable.Empty<dynamic>();

        if (Model.ListaTickets != null && Model.ListaTickets.Any())
        {
            concentradoSistemas = Model.ListaTickets
                .GroupBy(t => string.IsNullOrWhiteSpace(t.Sistema) ? "SIN SISTEMA" : t.Sistema.ToUpper().Trim())
                .Select(g => new {
                    Sistema = g.Key,
                    Total = g.Count(),
                    Incidencias = g.Count(x => x.Tipo == "Incidencia"),
                    Servicios = g.Count(x => x.Tipo == "Servicio"),
                    Telefono = g.Count(x => x.Origen == "Llamada"),
                    Correo = g.Count(x => x.Origen == "Correo"),
                    TiempoForma = g.Count(x => (x.Estatus == "Cerrado" || x.Estatus == "Resuelto") && x.FechaEntrada.Date == fechaConsultaDate),
                    CerradosAtrasados = g.Count(x => (x.Estatus == "Cerrado" || x.Estatus == "Resuelto") && x.FechaEntrada.Date < fechaConsultaDate),
                    EnCurso = g.Count(x => x.Estatus == "En curso" || x.Estatus == "Pendiente")
                }).OrderByDescending(x => x.Total).ToList();
        }
    }

    <!-- Sección: Concentrado y Gráficas del Día por Sistema -->
    <div class="glass-panel mb-4 p-3 overflow-hidden">
        <div class="glass-header mb-3">
            <i class="bi bi-pie-chart-fill me-2 text-info"></i>Concentrado del Día por Sistema
        </div>
        
        <div class="row g-3">
            <!-- Gráfica 1 -->
            <div class="col-md-5">
                <div class="bg-dark bg-opacity-50 p-3 rounded border border-secondary text-center h-100 d-flex flex-column justify-content-center align-items-center">
                    <span class="small fw-bold text-info mb-2">Distribución de Tickets por Sistema</span>
                    <div style="position: relative; height: 210px; width: 100%;">
                        <canvas id="chartSistemas"></canvas>
                    </div>
                </div>
            </div>

            <!-- Gráfica 2 -->
            <div class="col-md-7">
                <div class="bg-dark bg-opacity-50 p-3 rounded border border-secondary text-center h-100 d-flex flex-column justify-content-center align-items-center">
                    <span class="small fw-bold text-info mb-2">Tiempo y Forma vs Cerrados (Atrasados) vs En Curso</span>
                    <div style="position: relative; height: 210px; width: 100%;">
                        <canvas id="chartEstatusSistema"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla Concentrada por Sistema -->
        <div class="table-responsive mt-3">
            <table class="tabla-sigest text-center align-middle mb-0 small" id="tablaConcentradoSistema">
                <thead>
                    <tr>
                        <th class="text-center col-sistema">Sistema</th>
                        <th class="text-center">Total Tickets</th>
                        <th class="text-center">Incidencias</th>
                        <th class="text-center">Servicios</th>
                        <th class="text-center">Por Teléfono</th>
                        <th class="text-center">Por Correo</th>
                        <th class="text-center">Atendidos (Tiempo y Forma)</th>
                        <th class="text-center">Cerrados (Atrasados)</th>
                        <th class="text-center">En Curso (Seguimiento)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (concentradoSistemas.Any())
                    {
                        @foreach (var s in concentradoSistemas)
                        {
                            string sisUpper = (s.Sistema ?? "").ToString().ToUpper().Trim();
                            string claseSistema = "badge-sistema-med";
                            bool esConector = sisUpper.Contains("CONECTOR") || sisUpper.Contains("ZOE");

                            if (esConector) claseSistema = "badge-sistema-med";
                            else if (sisUpper.Contains("DIAWEB")) claseSistema = "badge-sistema-diaweb";
                            else if (sisUpper.Contains("DIAENLINEA")) claseSistema = "badge-sistema-diaenlinea";
                            else if (sisUpper == "DIA") claseSistema = "badge-sistema-dia";
                            else if (sisUpper == "SITA") claseSistema = "badge-sistema-sita";
                            else if (sisUpper == "VUCEM") claseSistema = "badge-sistema-vucem";
                            else if (sisUpper == "COA") claseSistema = "badge-sistema-coa";
                            else if (sisUpper == "ADMIN") claseSistema = "badge-sistema-admin";

                            <tr>
                                <td class="text-center align-middle col-sistema">
                                    <span class="badge @claseSistema text-wrap" style="line-height: 1.2;">
                                        @if (esConector)
                                        {
                                            @:CONECTOR<br />DIAWEB-ZOÉ
                                        }
                                        else
                                        {
                                            @s.Sistema
                                        }
                                    </span>
                                </td>
                                <td class="fw-bold text-center">@s.Total</td>
                                <td class="text-center">@s.Incidencias</td>
                                <td class="text-center">@s.Servicios</td>
                                <td class="text-center">@s.Telefono</td>
                                <td class="text-center">@s.Correo</td>
                                <td class="text-center"><span class="badge bg-success">@s.TiempoForma</span></td>
                                <td class="text-center"><span class="badge bg-info">@s.CerradosAtrasados</span></td>
                                <td class="text-center"><span class="badge bg-warning text-dark">@s.EnCurso</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-3 text-muted">No hay datos agrupados para mostrar.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Sección de Redacción -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="glass-panel h-100 overflow-hidden">
                <div class="glass-header">
                    <i class="bi bi-card-text me-2"></i>Puntos Relevantes del Día
                </div>
                <div class="p-3">
                    <textarea id="txtPuntosRelevantes" class="form-control" rows="5" placeholder="Escribe un breve resumen de cada uno de los tickets atendidos hoy..."></textarea>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="glass-panel h-100 overflow-hidden">
                <div class="glass-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-person-workspace me-2"></i>Soportes Internos / Actividades Adicionales</span>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="chkActividades">
                        <label class="form-check-label text-white small" for="chkActividades">Indicar actividades adicionales</label>
                    </div>
                </div>
                <div class="p-3 d-none" id="boxActividades">
                    <textarea id="txtSoportesInternos" class="form-control" rows="4" placeholder="Escribe aquí el soporte brindado a compañeros o actividades adicionales..." disabled></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla 2: Matriz Detallada Módulo Pantalla -->
    <div class="glass-panel mb-4 overflow-hidden">
        <div class="glass-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-table me-2"></i>Detalle Completo de Tickets</span>
            <span class="badge bg-primary px-3 py-2 rounded-pill">Registros: @Model.ListaTickets.Count</span>
        </div>
        <div class="p-0 table-responsive">
            <table class="tabla-sigest text-nowrap small" id="tablaDetalleTickets">
                <thead>
                    <tr>
                        <th class="text-center">Fecha Entrada</th>
                        <th class="text-center">Última Modif.</th>
                        <th class="text-center">Hora</th>
                        <th class="text-center">No. Ticket</th>
                        <th class="text-center">Cliente</th>
                        <th class="text-center">Ejecutivo</th>
                        <th class="text-center">Reportó</th>
                        <th class="text-center">Estatus</th>
                        <th class="text-center col-sistema">Sistema</th>
                        <th class="text-center col-tipo">Tipo</th>
                        <th class="text-center">Descripción</th>
                        <th class="text-center">Comentarios</th>
                        <th class="text-center">Solución</th>
                        <th class="text-center">Escalado</th>
                        <th class="text-center">Área Escalada</th>
                        <th class="text-center">Fecha Solución</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaTickets != null && Model.ListaTickets.Any())
                    {
                        @foreach (var item in Model.ListaTickets)
                        {
                            <tr style="cursor: pointer;"
                                data-id="@item.Id"
                                data-fechaentrada="@item.FechaEntrada.ToString("yyyy-MM-dd")"
                                data-hora="@item.Hora"
                                data-numticket="@item.NumeroTicket"
                                data-cliente="@item.Cliente"
                                data-reporto="@item.Reporto"
                                data-ejecutivo="@item.Ejecutivo"
                                data-sistema="@item.Sistema"
                                data-tipo="@item.Tipo"
                                data-estatus="@item.Estatus"
                                data-escalado="@item.Escalado.ToString().ToLower()"
                                data-areaescalada="@item.AreaEscalada"
                                data-fechasolucion="@(item.FechaSolucion.HasValue ? item.FechaSolucion.Value.ToString("yyyy-MM-dd") : "")"
                                data-descripcion="@item.Descripcion"
                                data-comentarios="@item.Comentarios"
                                data-solucion="@item.Solucion"
                                ondblclick="abrirModalDetalleDesdeFila(this)">

                                <td class="text-center">@item.FechaEntrada.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">@(item.FechaUltimaModificacion.HasValue ? item.FechaUltimaModificacion.Value.ToString("dd/MM/yyyy") : "-")</td>
                                <td class="text-center">@item.Hora</td>
                                <td class="text-center"><span class="badge bg-info text-dark fw-bold">@item.NumeroTicket</span></td>
                                <td class="text-center fw-bold">@item.Cliente</td>
                                <td class="text-center">@item.Ejecutivo</td>
                                <td class="text-center">@item.Reporto</td>
                                <td class="text-center">
                                    @if (item.Estatus == "Cerrado")
                                    {
                                        <span class="badge bg-success">Cerrado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">En curso</span>
                                    }
                                </td>
                                <td class="text-center align-middle col-sistema">
                                    @{
                                        string sistemaUpper = (item.Sistema ?? "").ToUpper().Trim();
                                        string claseSistema = "badge-sistema-med";
                                        bool esConectorItem = sistemaUpper.Contains("CONECTOR") || sistemaUpper.Contains("ZOE");

                                        if (esConectorItem) claseSistema = "badge-sistema-med";
                                        else if (sistemaUpper.Contains("DIAWEB")) claseSistema = "badge-sistema-diaweb";
                                        else if (sistemaUpper.Contains("DIAENLINEA")) claseSistema = "badge-sistema-diaenlinea";
                                        else if (sistemaUpper == "DIA") claseSistema = "badge-sistema-dia";
                                        else if (sistemaUpper == "SITA") claseSistema = "badge-sistema-sita";
                                        else if (sistemaUpper == "VUCEM") claseSistema = "badge-sistema-vucem";
                                        else if (sistemaUpper == "COA") claseSistema = "badge-sistema-coa";
                                        else if (sistemaUpper == "ADMIN") claseSistema = "badge-sistema-admin";
                                    }
                                    <span class="badge @claseSistema text-wrap" style="line-height: 1.2;">
                                        @if (esConectorItem)
                                        {
                                            @:CONECTOR<br />DIAWEB-ZOÉ
                                        }
                                        else
                                        {
                                            @item.Sistema
                                        }
                                    </span>
                                </td>
                                <td class="text-center col-tipo">@item.Tipo</td>
                                <td class="col-corta text-truncate" style="max-width: 150px;" title="@item.Descripcion">
                                    @(string.IsNullOrEmpty(item.Descripcion) ? "-" : item.Descripcion)
                                </td>
                                <td class="col-corta text-truncate" style="max-width: 150px;" title="@item.Comentarios">
                                    @(string.IsNullOrEmpty(item.Comentarios) ? "-" : item.Comentarios)
                                </td>
                                <td class="col-corta text-truncate" style="max-width: 150px;" title="@item.Solucion">
                                    @(string.IsNullOrEmpty(item.Solucion) ? "-" : item.Solucion)
                                </td>
                                <td class="text-center">
                                    @if (item.Escalado)
                                    {
                                        <span class="badge bg-danger">SI</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">NO</span>
                                    }
                                </td>
                                <td class="text-center">@(string.IsNullOrEmpty(item.AreaEscalada) ? "-" : item.AreaEscalada)</td>
                                <td class="text-center">@(item.FechaSolucion.HasValue ? item.FechaSolucion.Value.ToString("dd/MM/yyyy") : "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="16" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No hay tickets registrados para la fecha seleccionada.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal 1: Nuevo Ticket -->
<div class="modal fade" id="modalNuevoTicket" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-panel border-0 text-white">
            <div class="modal-header glass-header border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2 text-info"></i>Registrar Nuevo Ticket</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="CrearTicket">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label small text-muted">Fecha Entrada</label>
                            <input type="date" name="FechaEntrada" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted">No. Ticket / Folio</label>
                            <input type="text" name="NumeroTicket" class="form-control form-control-sm" required placeholder="Ej: 7016" />
                        </div>
                        <div class="col-md-3">
                            <label for="regHora" class="form-label small text-muted">Hora de Entrada</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light text-secondary">
                                    <i class="bi bi-clock"></i>
                                </span>
                                <input type="time" class="form-control form-control-sm" id="regHora" name="Hora" required />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted">Origen del Ticket</label>
                            <select name="Origen" class="form-select form-select-sm" required>
                                <option value="Llamada">Llamada</option>
                                <option value="Correo">Correo</option>
                                <option value="Interno">Interno</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-muted">Cliente (Empresa)</label>
                            <select id="ddlClientes" name="ClienteId" class="form-select form-select-sm" onchange="cambiarCliente(this)">
                                <option value="">-- Selecciona Cliente --</option>
                                @foreach (var c in Model.ListaClientes)
                                {
                                    <option value="@c.Id">@c.Clave - @c.Nombre</option>
                                }
                                <option value="OTRO">+ Agregar Cliente Nuevo...</option>
                            </select>
                        </div>

                        <div id="boxClienteNuevo" class="col-md-6 row g-2 d-none">
                            <div class="col-md-5">
                                <label class="form-label small text-muted">Clave Cliente</label>
                                <input type="text" name="NuevaClaveCliente" class="form-control form-control-sm" placeholder="Ej: CLI01" />
                            </div>
                            <div class="col-md-7">
                                <label class="form-label small text-muted">Nombre Empresa</label>
                                <input type="text" name="NuevoNombreCliente" class="form-control form-control-sm" placeholder="Razón Social" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-muted">Persona que Reportó</label>
                            <select id="ddlContactos" name="Reporto" class="form-select form-select-sm" onchange="cambiarContacto(this)">
                                <option value="">-- Selecciona quien reporta --</option>
                                <option value="OTRO">+ Agregar otra persona...</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-muted">Nombre Persona (Si es otro)</label>
                            <input type="text" id="txtReportoManual" name="ReportoManual" class="form-control form-control-sm d-none" placeholder="Nombre completo" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Correo Electrónico</label>
                            <input type="email" id="txtCorreoReporto" name="CorreoReporto" class="form-control form-control-sm" placeholder="correo@empresa.com" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-muted">Ejecutivo de Soporte</label>
                            <select name="Ejecutivo" class="form-select form-select-sm" required>
                                <option value="">-- Selecciona Ejecutivo --</option>
                                @foreach (var pers in Model.ListaEjecutivosSoporte)
                                {
                                    <option value="@pers.Nombre">@pers.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small text-muted">Sistema</label>
                            <select id="regSistema" name="Sistema" class="form-select form-select-sm" onchange="aplicarColorSelectSistema(this)" required>
    <option value="DIA" style="background-color: #2563eb; color: #ffffff;">DIA</option>
    <option value="DIAWEB" style="background-color: #0284c7; color: #ffffff;">DIAWEB</option>
    <option value="CONECTOR DIAWEB-ZOÉ" style="background-color: #704332; color: #ffffff;">CONECTOR DIAWEB-ZOÉ</option>
    <option value="SITA" style="background-color: #ea580c; color: #ffffff;">SITA</option>
    <option value="VUCEM" style="background-color: #1d4ed8; color: #ffffff;">VUCEM</option>
    <option value="DIAENLINEA PREMIUM" style="background-color: #16a34a; color: #ffffff;">DIAENLINEA PREMIUM</option>
    <option value="COA" style="background-color: #15803d; color: #ffffff;">COA</option>
    <option value="ADMIN" style="background-color: #0f172a; color: #ffffff;">ADMIN</option>
</select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted">Tipo Requerimiento</label>
                            <select name="Tipo" class="form-select form-select-sm" required>
                                <option value="Servicio">Servicio</option>
                                <option value="Incidencia">Incidencia</option>
                                <option value="Ajuste">Ajuste</option>
                                <option value="Mejora">Mejora</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted">Estatus Inicial</label>
                            <select name="Estatus" class="form-select form-select-sm" onchange="evaluarFechaSolucionNuevo(this.value)" required>
                                <option value="En curso">En curso</option>
                                <option value="Cerrado">Cerrado</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-muted">Fecha de Solución</label>
                            <input type="date" id="regFechaSolucion" name="FechaSolucion" class="form-control form-control-sm" disabled />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small text-muted">¿Se escala?</label>
                            <select id="ddlEscalado" name="Escalado" class="form-select form-select-sm" onchange="cambiarEscalado(this)">
                                <option value="false">NO</option>
                                <option value="true">SI</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-none" id="boxAreaEscalada">
                            <label class="form-label small text-muted">Área Escalada</label>
                            <select name="AreaEscalada" class="form-select form-select-sm">
                                <option value="">-- Selecciona Área --</option>
                                <option value="Desarrollo">Desarrollo</option>
                                <option value="Consultoría">Consultoría</option>
                                <option value="Ventas">Ventas</option>
                                <option value="Cobranza">Cobranza</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small text-muted">Descripción del Ticket</label>
                            <textarea name="Descripcion" class="form-control form-control-sm" rows="4" placeholder="Escribe aquí la bitácora o historial..." required></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small text-muted">Comentarios / Falla Reportada</label>
                            <textarea name="Comentarios" class="form-control form-control-sm" rows="3" placeholder="Descripción detallada..."></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small text-muted">Solución Brindada</label>
                            <textarea name="Solucion" class="form-control form-control-sm" rows="3" placeholder="Detalles de la resolución técnica..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-secondary-sigest px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary-sigest px-3"><i class="bi bi-save me-1"></i> Guardar Ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Detalle / Edición -->
