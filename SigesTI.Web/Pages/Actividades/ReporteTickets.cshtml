<!-- Modal 3: Vista Previa y PDF del Reporte -->
<div class="modal fade" id="modalVistaPreviaReporte" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
        <div class="modal-content glass-panel border-0 text-white">
            <div class="modal-header glass-header border-0">
                <h5 class="modal-title fw-bold text-white">
                    <i class="bi bi-file-earmark-pdf me-2 text-info"></i>Vista Previa del Reporte Diario
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- Contenedor de Impresión -->
            <div class="modal-body p-4 text-dark bg-white" id="seccionImpresion">

                <!-- ENCABEZADO -->
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-2 border-primary">
                    <div>
                        <h2 class="fw-bold mb-0 text-uppercase text-dark" style="font-size: 16pt; color: #0f172a !important;">
                            Reporte Diario de Tickets
                        </h2>
                        <span class="text-muted small">Área de Soporte Técnico</span>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-dark text-white px-3 py-2 fs-6">
                            Fecha: @(Model.FechaReporte?.ToString("dd/MM/yyyy"))
                        </span>
                    </div>
                </div>

                <!-- 1. RESUMEN DE INDICADORES -->
                <h6 class="fw-bold text-dark mb-2" style="font-size: 10pt; color: #0f172a !important;">
                    <i class="bi bi-bar-chart-fill me-1 text-primary"></i> 1. Resumen de Indicadores
                </h6>
                <div id="contenedorIndicadoresPrint" class="mb-3"></div>

                <!-- CONCENTRADO Y GRÁFICAS POR SISTEMA EN IMPRESIÓN -->
                <h6 class="fw-bold text-dark mb-2" style="font-size: 10pt; color: #0f172a !important;">
                    <i class="bi bi-pie-chart-fill me-1 text-primary"></i> Concentrado del Día por Sistema
                </h6>

                <!-- Contenedor dinámico de gráficas -->
                <div class="row g-2 mb-3" id="contenedorGraficasPrint">
                    <div class="col-6 text-center">
                        <div class="fw-bold text-dark small mb-1" style="font-size: 8.5pt;">Distribución de Tickets por Sistema</div>
                        <img id="imgChartSistemasPrint" style="max-width: 100%; height: auto; max-height: 180px;" />
                    </div>
                    <div class="col-6 text-center">
                        <div class="fw-bold text-dark small mb-1" style="font-size: 8.5pt;">Tiempo y Forma vs Cerrados (Atrasados) vs En Curso</div>
                        <img id="imgChartEstatusPrint" style="max-width: 100%; height: auto; max-height: 180px;" />
                    </div>
                </div>

                <!-- Tabla de Concentrado para Impresión -->
                <div class="mb-3">
                    <table class="tabla-print-detalle">
                        <thead>
                            <tr style="background-color: #2563eb; color: #ffffff;">
                                <th class="text-center col-sistema">SISTEMA</th>
                                <th class="text-center">TOTAL TICKETS</th>
                                <th class="text-center">INCIDENCIAS</th>
                                <th class="text-center">SERVICIOS</th>
                                <th class="text-center">POR TELÉFONO</th>
                                <th class="text-center">POR CORREO</th>
                                <th class="text-center">ATENDIDOS (TIEMPO Y FORMA)</th>
                                <th class="text-center">CERRADOS (ATRASADOS)</th>
                                <th class="text-center">EN CURSO (SEGUIMIENTO)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (concentradoSistemas.Any())
                            {
                                @foreach (var s in concentradoSistemas)
                                {
                                    string sisPrintCheck = (s.Sistema ?? "").ToString().ToUpper().Trim();
                                    bool esConectorPrint = sisPrintCheck.Contains("CONECTOR") || sisPrintCheck.Contains("ZOE");

                                    <tr>
                                        <td class="text-center fw-bold text-dark col-sistema" style="line-height: 1.2;">
                                            @if (esConectorPrint)
                                            {
                                                @:CONECTOR<br />DIAWEB-ZOÉ
                                            }
                                            else
                                            {
                                                @s.Sistema
                                            }
                                        </td>
                                        <td class="text-center fw-bold">@s.Total</td>
                                        <td class="text-center">@s.Incidencias</td>
                                        <td class="text-center">@s.Servicios</td>
                                        <td class="text-center">@s.Telefono</td>
                                        <td class="text-center">@s.Correo</td>
                                        <td class="text-center"><span class="badge-print-cerrado">@s.TiempoForma</span></td>
                                        <td class="text-center"><span class="badge-print-atrasado">@s.CerradosAtrasados</span></td>
                                        <td class="text-center"><span class="badge-print-encurso">@s.EnCurso</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-2 text-muted">No hay datos de concentrado para mostrar.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- 2. PUNTOS RELEVANTES DEL DÍA -->
                <h6 class="fw-bold text-dark mb-2" style="font-size: 10pt; color: #0f172a !important;">
                    <i class="bi bi-card-text me-1 text-primary"></i> 2. Puntos Relevantes del Día
                </h6>
                <div class="box-print-resumen text-dark mb-3" style="white-space: pre-wrap; font-size: 9pt;" id="printPuntosRelevantes"></div>

                <!-- 3. SOPORTES INTERNOS / ACTIVIDADES ADICIONALES (SI APLICA) -->
                <div id="contenedorActividadesPrint" class="d-none mb-3">
                    <h6 class="fw-bold text-dark mb-2" style="font-size: 10pt; color: #0f172a !important;">
                        <i class="bi bi-person-workspace me-1 text-primary"></i> 3. Soportes Internos / Actividades Adicionales
                    </h6>
                    <div class="box-print-resumen text-dark" style="white-space: pre-wrap; font-size: 9pt;" id="printSoportesInternos"></div>
                </div>

                <!-- DETALLE COMPLETO DE TICKETS EN IMPRESIÓN -->
                <div class="mt-3">
                    <h6 class="fw-bold text-dark mb-2" style="font-size: 10pt; color: #0f172a !important;">
                        <i class="bi bi-list-check me-1 text-primary"></i> Detalle Completo de Tickets
                    </h6>
                    <table class="tabla-print-detalle">
                        <thead>
                            <tr style="background-color: #1e293b; color: #ffffff;">
                                <th class="col-fecha text-center">FECHA ENTRADA</th>
                                <th class="col-hora text-center">HORA</th>
                                <th class="col-ticket text-center">NO. TICKET</th>
                                <th class="col-cliente text-center">CLIENTE</th>
                                <th class="col-ejecutivo text-center">EJECUTIVO</th>
                                <th class="col-reporto text-center">REPORTÓ</th>
                                <th class="col-estatus text-center">ESTATUS</th>
                                <th class="col-sistema text-center">SISTEMA</th>
                                <th class="col-tipo text-center">TIPO</th>
                                <th class="col-descripcion text-center">DESCRIPCIÓN</th>
                                <th class="col-comentarios text-center">COMENTARIOS</th>
                                <th class="col-solucion text-center">SOLUCIÓN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ListaTickets != null && Model.ListaTickets.Any())
                            {
                                @foreach (var item in Model.ListaTickets)
                                {
                                    <tr>
                                        <td class="text-center">@item.FechaEntrada.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">@item.Hora</td>
                                        <td class="text-center"><b>#@item.NumeroTicket</b></td>
                                        <td class="text-center fw-bold">@item.Cliente</td>
                                        <td class="text-center">@item.Ejecutivo</td>
                                        <td class="text-center">@item.Reporto</td>
                                        <td class="text-center">
                                            @if (item.Estatus == "Cerrado")
                                            {
                                                <span class="badge-print-cerrado">Cerrado</span>
                                            }
                                            else
                                            {
                                                <span class="badge-print-encurso">En curso</span>
                                            }
                                        </td>
                                        <td class="text-center align-middle col-sistema" style="padding: 2px !important;">
                                            @{
                                                string sisPrintUpper = (item.Sistema ?? "").ToUpper().Trim();
                                                string clasePrintSistema = "badge-sistema-med";
                                                bool esConectorItemPrint = sisPrintUpper.Contains("CONECTOR") || sisPrintUpper.Contains("ZOE");

                                                if (esConectorItemPrint)
                                                {
                                                    clasePrintSistema = "badge-sistema-med";
                                                }
                                                else if (sisPrintUpper.Contains("DIAWEB")) clasePrintSistema = "badge-sistema-diaweb";
                                                else if (sisPrintUpper.Contains("DIAENLINEA")) clasePrintSistema = "badge-sistema-diaenlinea";
                                                else if (sisPrintUpper == "DIA") clasePrintSistema = "badge-sistema-dia";
                                                else if (sisPrintUpper == "SITA") clasePrintSistema = "badge-sistema-sita";
                                                else if (sisPrintUpper == "VUCEM") clasePrintSistema = "badge-sistema-vucem";
                                                else if (sisPrintUpper == "COA") clasePrintSistema = "badge-sistema-coa";
                                                else if (sisPrintUpper == "ADMIN") clasePrintSistema = "badge-sistema-admin";
                                            }
                                            <span class="badge @clasePrintSistema" style="white-space: pre-line !important; font-size: 6.5pt !important; display: inline-block; width: 100%; word-break: break-word !important; line-height: 1.1; padding: 3px 2px !important;">
                                                @if (esConectorItemPrint)
                                                {
                                                    @:CONECTOR<br />DIAWEB-ZOÉ
                                                }
                                                else
                                                {
                                                    @item.Sistema
                                                }
                                            </span>
                                        </td>
                                        <td class="text-center align-middle col-tipo">
                                            @item.Tipo
                                        </td>
                                        <td class="col-texto-largo col-descripcion">@item.Descripcion</td>
                                        <td class="col-texto-largo col-comentarios">@item.Comentarios</td>
                                        <td class="col-texto-largo col-solucion">@item.Solucion</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="12" class="text-center py-3 text-muted">No hay tickets registrados en esta fecha.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

            <div class="modal-footer border-top bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary fw-bold" onclick="imprimirContenidoLimpio()">
                    <i class="bi bi-printer me-1"></i> Imprimir / Guardar PDF
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>

    <script>
        const rolUsuario = "@(HttpContext.Session.GetString("Rol") ?? "")";
        const usuarioSesion = "@(HttpContext.Session.GetString("Usuario") ?? "")";
        const fechaReporteActual = "@(Model.FechaReporte?.ToString("dd-MM-yyyy"))";

        // Función para cambiar dinámicamente la clase/color del <select> de Sistema
        function aplicarColorSelectSistema(selectElement) {
            if (!selectElement) return;
            const val = (selectElement.value || '').toUpperCase().trim();
            
            // Remover todas las clases de sistemas previas
            selectElement.classList.remove(
                'badge-sistema-dia', 
                'badge-sistema-diaweb', 
                'badge-sistema-med', 
                'badge-sistema-sita', 
                'badge-sistema-vucem', 
                'badge-sistema-diaenlinea', 
                'badge-sistema-coa', 
                'badge-sistema-admin'
            );

            if (val.includes('CONECTOR') || val.includes('ZOE')) {
                selectElement.classList.add('badge-sistema-med');
            } else if (val.includes('DIAWEB')) {
                selectElement.classList.add('badge-sistema-diaweb');
            } else if (val.includes('DIAENLINEA')) {
                selectElement.classList.add('badge-sistema-diaenlinea');
            } else if (val === 'DIA') {
                selectElement.classList.add('badge-sistema-dia');
            } else if (val === 'SITA') {
                selectElement.classList.add('badge-sistema-sita');
            } else if (val === 'VUCEM') {
                selectElement.classList.add('badge-sistema-vucem');
            } else if (val === 'COA') {
                selectElement.classList.add('badge-sistema-coa');
            } else if (val === 'ADMIN') {
                selectElement.classList.add('badge-sistema-admin');
            } else {
                selectElement.classList.add('badge-sistema-dia');
            }
        }

        Chart.register(ChartDataLabels);

        window.chartSistemasInstance = null;
        window.chartEstatusInstance = null;

        document.addEventListener('DOMContentLoaded', function () {
            // Inicializar color del select al cargar
            const regSys = document.getElementById('regSistema');
            const editSys = document.getElementById('editSistema');
            if (regSys) aplicarColorSelectSistema(regSys);
            if (editSys) aplicarColorSelectSistema(editSys);

            const labelsSistemas = [
                @Html.Raw(string.Join(",", concentradoSistemas.Select(s => $"'{s.Sistema}'")))
            ];
            const dataTotales = [
                @Html.Raw(string.Join(",", concentradoSistemas.Select(s => s.Total)))
            ];
            const dataTiempoForma = [
                @Html.Raw(string.Join(",", concentradoSistemas.Select(s => s.TiempoForma)))
            ];
            const dataCerradosAtrasados = [
                @Html.Raw(string.Join(",", concentradoSistemas.Select(s => s.CerradosAtrasados)))
            ];
            const dataEnCurso = [
                @Html.Raw(string.Join(",", concentradoSistemas.Select(s => s.EnCurso)))
            ];

            const obtenerColorSistema = (sistema) => {
                const sysUpper = (sistema || '').toUpperCase().trim();
                
                if (sysUpper.includes('CONECTOR') || sysUpper.includes('ZOE')) return '#704332';
                if (sysUpper.includes('DIAWEB')) return '#0284c7';
                if (sysUpper.includes('DIAENLINEA')) return '#16a34a';
                if (sysUpper === 'DIA') return '#2563eb';
                if (sysUpper === 'SITA') return '#ea580c';
                if (sysUpper === 'VUCEM') return '#1d4ed8';
                if (sysUpper === 'COA') return '#15803d';
                if (sysUpper === 'ADMIN') return '#0f172a';
                
                return '#38bdf8';
            };

            const coloresDona = labelsSistemas.map(sys => obtenerColorSistema(sys));

            // 1. Gráfica de Dona
            const ctx1 = document.getElementById('chartSistemas');
            if (ctx1 && labelsSistemas.length > 0) {
                window.chartSistemasInstance = new Chart(ctx1, {
                    type: 'doughnut',
                    data: {
                        labels: labelsSistemas,
                        datasets: [{
                            data: dataTotales,
                            backgroundColor: coloresDona,
                            borderWidth: 1,
                            borderColor: '#0f172a'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: false,
                        plugins: {
                            title: { display: false },
                            legend: {
                                position: 'right',
                                labels: { color: '#ffffff', font: { size: 10, weight: 'bold' } }
                            },
                            datalabels: {
                                color: '#ffffff',
                                font: { weight: 'bold', size: 11 },
                                formatter: (value, ctx) => {
                                    if (!value || value === 0) return '';
                                    let sum = 0;
                                    let dataArr = ctx.chart.data.datasets[0].data;
                                    dataArr.map(data => { sum += data; });
                                    let percentage = (value * 100 / sum).toFixed(1) + "%";
                                    return percentage;
                                }
                            }
                        }
                    }
                });
            }

            // 2. Gráfica de Barras
            const ctx2 = document.getElementById('chartEstatusSistema');
            if (ctx2 && labelsSistemas.length > 0) {
                window.chartEstatusInstance = new Chart(ctx2, {
                    type: 'bar',
                    data: {
                        labels: labelsSistemas,
                        datasets: [
                            {
                                label: 'Tiempo y Forma',
                                data: dataTiempoForma,
                                backgroundColor: '#22c55e'
                            },
                            {
                                label: 'Cerrado (Atrasados)',
                                data: dataCerradosAtrasados,
                                backgroundColor: '#3b82f6'
                            },
                            {
                                label: 'En Curso',
                                data: dataEnCurso,
                                backgroundColor: '#eab308'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: false,
                        scales: {
                            x: {
                                ticks: { color: '#ffffff', font: { size: 9, weight: 'bold' } },
                                grid: { display: false }
                            },
                            y: {
                                ticks: { color: '#ffffff', precision: 0, font: { weight: 'bold' } },
                                grid: { color: 'rgba(255,255,255,0.1)' }
                            }
                        },
                        plugins: {
                            title: { display: false },
                            legend: {
                                position: 'top',
                                labels: { color: '#ffffff', font: { size: 9, weight: 'bold' } }
                            },
                            datalabels: {
                                anchor: 'end',
                                align: 'start',
                                color: '#ffffff',
                                font: { weight: 'bold', size: 10 },
                                formatter: (value) => {
                                    return value > 0 ? value : '';
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
    <script src="~/js/modales.js" asp-append-version="true"></script>
}