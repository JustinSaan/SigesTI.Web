@page
@model SigesTI.Web.Pages.Actividades.TareasProgramadasModel
@{
    ViewData["Title"] = "Tareas Programadas Generales";
}

<link rel="stylesheet" href="~/css/actividades.css" asp-append-version="true" />

<div class="actividades-container px-4 py-3">
    <!-- Encabezado y Acciones -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-white mb-1">
                <i class="bi bi-list-task me-2 text-info"></i>Tareas Programadas Generales
            </h3>
            <p class="text-muted small mb-0">Programa de mantenimientos, renovaciones y actividades pendientes del área.</p>
        </div>
        <button class="btn btn-primary-sigest shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#modalNuevaTarea">
            <i class="bi bi-plus-lg me-1"></i> Nueva Tarea Programada
        </button>
    </div>

    <!-- Tabla de Tareas (Glass Panel & Tabla SigesST) -->
    <div class="glass-panel mb-4 overflow-hidden">
        <div class="glass-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-calendar-check me-2"></i>Programa de Actividades</span>
            <span class="badge bg-primary px-3 py-2 rounded-pill">Pendientes: 1</span>
        </div>
        <div class="p-0 table-responsive">
            <table class="tabla-sigest align-middle text-nowrap mb-0 small">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tarea / Pendiente</th>
                        <th>Tipo</th>
                        <th>Origen</th>
                        <th>Persona Asignada</th>
                        <th>Fecha Compromiso</th>
                        <th>Fecha Realización</th>
                        <th>Estatus</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">1</td>
                        <td class="fw-bold text-white">Renovación de Licencias ESET Antivirus</td>
                        <td class="text-center">Licenciamiento</td>
                        <td class="text-center"><span class="badge bg-secondary px-2 py-1">Interno</span></td>
                        <td>Ing. Justin Sánchez</td>
                        <td class="text-center">05/10/2026</td>
                        <td class="text-center"><span class="text-muted">-</span></td>
                        <td class="text-center"><span class="badge bg-warning text-dark px-2 py-1">Pendiente</span></td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-success shadow-sm fw-bold px-2 py-1" style="border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#modalResolverTarea">
                                <i class="bi bi-check-lg me-1"></i> Marcar Resuelta
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para Capturar Fecha de Solución (Glassmorphism Style) -->
<div class="modal fade" id="modalResolverTarea" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-panel text-white border-0">
            <div class="modal-header glass-header border-0">
                <h5 class="modal-title fs-6 fw-bold text-white">
                    <i class="bi bi-check-circle me-2 text-success"></i>Completar Tarea
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted mb-3">Ingresa la fecha exacta en la que se concluyó la actividad:</p>
                <div class="mb-3">
                    <label class="form-label small text-muted">Fecha Real de Solución</label>
                    <input type="date" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Observaciones / Comentarios</label>
                    <textarea class="form-control" rows="3" placeholder="Detalles de la conclusión..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0 bg-transparent pt-0">
                <button type="button" class="btn btn-sm btn-secondary-sigest px-3" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-sm btn-primary-sigest px-3">Guardar y Marcar Resuelta</button>
            </div>
        </div>
    </div>
</div>