@page
@model SigesTI.Web.Pages.Actividades.TareasProgramadasModel
@{
    ViewData["Title"] = "Tareas Programadas Generales";
    var meses = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat;

    bool puedeCrear = await Permisos.PuedeAsync(Modulos.TareasGenerales, Accion.Crear);
    bool puedeEditar = await Permisos.PuedeAsync(Modulos.TareasGenerales, Accion.Editar);
    bool puedeEliminar = await Permisos.PuedeAsync(Modulos.TareasGenerales, Accion.Eliminar);
    bool puedeExportar = await Permisos.PuedeAsync(Modulos.TareasGenerales, Accion.Exportar);
}
<link rel="stylesheet" href="~/css/Actividades/tareasg.css" asp-append-version="true" />

<div class="actividades-container px-4 py-3" data-rol-usuario="@Model.RolUsuario" data-puede-editar="@puedeEditar.ToString().ToLower()">
    <!-- Encabezado y Acciones Principal -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-white mb-1">
                <i class="bi bi-list-task me-2 text-info"></i>Tareas Generales
            </h3>
            <p class="text-muted small mb-0">Programa de tareas pendientes y actividades del día del área de Soporte Técnico.</p>
        </div>
        <!--<div class="d-flex gap-2">
            <button class="btn btn-imprimir-reporte shadow-sm px-3 fw-bold" id="btnImprimirReporte">
                <i class="bi bi-file-earmark-pdf-fill me-2"></i> Generar Reporte
            </button>
            <button class="btn btn-primary-sigest shadow-sm px-3" id="btnNuevaTarea">
                <i class="bi bi-plus-circle-fill me-1"></i> Nueva Tarea
            </button>
        </div>-->
    </div>

    <!-- Panel de Filtros Automáticos -->
    <div class="glass-panel panel-resumen mb-4">
        <div class="panel-resumen-header">
            <div class="panel-titulo">
                <span class="panel-icono"><i class="bi bi-funnel-fill"></i></span>Filtros de Búsqueda
            </div>
        </div>

        <form method="get" id="formFiltrosFechas" class="panel-resumen-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="filtro-label" for="filtroFechaSolicitud">Fecha Solicitud</label>
                    <div class="filtro-campo">
                        <i class="bi bi-calendar-plus"></i>
                        <input type="date" id="filtroFechaSolicitud" name="FiltroFechaInicio" value="@Model.FiltroFechaInicio?.ToString("yyyy-MM-dd")" class="form-control filtro-auto" onchange="this.form.submit()" />
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="filtro-label" for="filtroFechaRealizacion">Fecha Realización</label>
                    <div class="filtro-campo">
                        <i class="bi bi-calendar-check"></i>
                        <input type="date" id="filtroFechaRealizacion" name="FiltroFechaFin" value="@Model.FiltroFechaFin?.ToString("yyyy-MM-dd")" class="form-control filtro-auto" onchange="this.form.submit()" />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="filtro-label" for="filtroGeneral">Búsqueda general</label>
                    <div class="filtro-campo">
                        <i class="bi bi-search"></i>
                        <input type="text" id="filtroGeneral" class="form-control filtro-auto" placeholder="Buscar tareas..." />
                    </div>
                </div>

                <div class="col-auto">
                    <button type="button" class="btn-limpiar-filtros" id="btnLimpiarFiltros" title="Limpiar filtros">
                        <i class="bi bi-eraser-fill me-1"></i> Limpiar
                    </button>
                </div>

                <div class="col d-flex justify-content-end gap-2">
                    @if (puedeExportar)
                    {
                        <button type="button" class="btn btn-imprimir-reporte shadow-sm px-3 fw-bold" id="btnImprimirReporte">
                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Generar Reporte
                        </button>
                    }
                    @if (puedeCrear)
                    {
                        <button type="button" class="btn btn-primary-sigest shadow-sm px-3" id="btnNuevaTarea">
                            <i class="bi bi-plus-circle-fill me-1"></i> Nueva Tarea
                        </button>
                    }
                </div>
            </div>
        </form>
    </div>
            <!-- <div class="col-md-2">
                <label class="form-label small text-muted">Estatus</label>
                <select id="filtroEstatus" class="form-select form-select-sm filtro-auto">
                    <option value="">-- Todos --</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="En Curso">En Curso</option>
                    <option value="Resuelta">Resuelta</option>
                </select>
                </div>-->


    <!-- Bloques Superiores: Soportes Internos + Campañas de Renovación -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="glass-panel panel-resumen h-100">
                <div class="panel-resumen-header">
                    <div class="panel-titulo">
                        <span class="panel-icono"><i class="bi bi-chat-dots-fill"></i></span>Comentarios Adicionales
                    </div>
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input mt-0" type="checkbox" role="switch" id="switchActividadesAdicionales">
                    </div>
                </div>

                <div id="panelActividadesAdicionales" class="panel-resumen-body d-none">
                    <textarea id="txtSoportesInternos"
                              class="form-control txt-comentarios-adicionales"
                              rows="3"
                              placeholder="Escribe aquí los comentarios adicionales..."></textarea>
                    <div class="d-flex justify-content-end mt-1">
                        <small id="lblEstadoGuardado" class="lbl-estado-guardado text-muted fst-italic"></small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="glass-panel panel-resumen h-100">
                <div class="panel-resumen-header">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <div class="panel-titulo">
                            <span class="panel-icono panel-icono-campana"><i class="bi bi-patch-check-fill"></i></span>Avances campaña de renovación
                        </div>
                        <select id="ddlMesCampana" class="select-campana-custom">
                            @for (int m = 1; m <= 12; m++)
                            {
                                string nombreMes = meses.GetMonthName(m);
                                <option value="@m" selected="@(m == DateTime.Now.Month)">@(char.ToUpper(nombreMes[0]) + nombreMes.Substring(1))</option>
                            }
                        </select>

                        <select id="ddlAnioCampana" class="select-campana-custom">
                            @foreach (var a in Model.AniosCampana)
                            {
                                <option value="@a" selected="@(a == DateTime.Now.Year)">@a</option>
                            }
                        </select>

                    </div>
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input mt-0" type="checkbox" role="switch" id="switchCampanaRenovacion">
                    </div>
                </div>

                <div id="panelCampanaRenovacion" class="panel-resumen-body d-none">
                    <!-- Avance general -->
                    <div class="campana-avance">
                        <div class="d-flex justify-content-between align-items-end mb-2">
                            <div>
                                <div class="campana-avance-etiqueta">Porcentaje de avance</div>
                                <div id="campPorcentaje" class="campana-avance-valor">-</div>
                            </div>
                            <div class="text-end">
                                <div class="campana-avance-etiqueta">Total clientes</div>
                                <div id="campTotalClientes" class="campana-total-valor">-</div>
                            </div>
                        </div>
                        <div class="campana-barra">
                            <div id="barraAvanceCampana" class="campana-barra-relleno" style="width: 0%;"></div>
                        </div>
                    </div>

                    <!-- Detalle -->
                    <div class="campana-indicadores">
                        <div class="campana-indicador ind-finalizadas">
                            <i class="bi bi-check-circle-fill"></i>
                            <span class="campana-indicador-texto">Encuestas finalizadas</span>
                            <span id="campEncuestasFin" class="campana-indicador-valor">-</span>
                        </div>
                        <div class="campana-indicador ind-encurso">
                            <i class="bi bi-hourglass-split"></i>
                            <span class="campana-indicador-texto">Encuestas en curso</span>
                            <span id="campEncuestasCurso" class="campana-indicador-valor">-</span>
                        </div>
                        <div class="campana-indicador ind-pendiente">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span class="campana-indicador-texto">Seguimiento pendiente</span>
                            <span id="campSeguimientoPend" class="campana-indicador-valor">-</span>
                        </div>
                        <div class="campana-indicador ind-contactados">
                            <i class="bi bi-telephone-fill"></i>
                            <span class="campana-indicador-texto">Contactados hoy</span>
                            <span id="campContactadosHoy" class="campana-indicador-valor">-</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla Principal de Tareas -->
    <div class="glass-panel mb-4 overflow-hidden">
        <div class="glass-header d-flex justify-content-between align-items-center">
            <div class="panel-titulo">
                <span class="panel-icono"><i class="bi bi-calendar-check"></i></span>Programa de Actividades
            </div>
            <span class="badge-contador" id="badgeContadorTareas">
                Pendientes: @Model.ListaTareas.Count(t => t.Estatus == "Pendiente" || t.Estatus == "En Curso")
            </span>
        </div>

        <div class="wrapper-scroll-top" id="scrollTopContainer">
            <div class="div-scroll-top" id="scrollTopDummy"></div>
        </div>

        <div class="p-0 table-responsive" id="scrollTableContainer">
            <table class="tabla-sigest align-middle mb-0 small" id="tablaTareasOriginal">
                <thead>
                    <tr>
                        <th class="text-center celda-sin-recorte">#</th>
                        <th class="text-center">Tarea programada</th>
                        <th class="text-center celda-sin-recorte">Tipo</th>
                        <th class="text-center">Persona Solicitante</th>
                        <th class="text-center">Persona Asignada</th>
                        <th class="text-center celda-sin-recorte">Fecha Solicitud</th>
                        <th class="text-center celda-sin-recorte">Fecha Realización</th>
                        <th class="d-none">Objetivo</th>
                        <th class="text-center">Observaciones</th>
                        <th class="text-center celda-sin-recorte">Estatus</th>
                        <th class="text-center celda-sin-recorte">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ListaTareas.Any())
                    {
                        <tr id="rowSinTareas">
                            <td colspan="11" class="text-center text-muted py-4">No hay tareas programadas registradas.</td>
                        </tr>
                    }
                    else
                    {
                        int index = 1;
                        foreach (var item in Model.ListaTareas)
                        {
                            bool soloBusqueda = !Model.FiltroFechaInicio.HasValue && !Model.FiltroFechaFin.HasValue && item.Estatus == "Resuelta";
                            <tr class="fila-tarea" data-id="@item.Id" data-solo-busqueda="@(soloBusqueda ? "true" : "false")" data-objetivo="@(string.IsNullOrWhiteSpace(item.Objetivo) ? "-" : item.Objetivo)" style="cursor: pointer;">
                                <td class="text-center fw-bold text-index celda-sin-recorte">@(soloBusqueda ? "-" : (index++).ToString())</td>
                                
                                <td class="fw-bold text-white text-center text-tarea align-middle">
                                    @item.Tarea
                                </td>
                                <td class="text-center text-tipo align-middle celda-sin-recorte" data-tipo="@(item.TipoTarea?.Nombre ?? "General")">
                                    <span class="badge-tipo-tabla">@(item.TipoTarea?.Nombre ?? "General")</span>
                                </td>
                                <td class="text-center text-solicitante align-middle">
                                    @(item.PersonaSolicitante ?? "Sin Especificar")
                                </td>
                                <td class="text-center text-asignado align-middle">
                                    @(item.PersonaAsignada?.Nombre ?? "Sin Asignar")
                                </td>
                                <td class="text-center text-fechasolicitud align-middle celda-sin-recorte" data-fecha="@item.FechaSolicitud.ToString("yyyy-MM-dd")">
                                    @item.FechaSolicitud.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center text-fechareal align-middle celda-sin-recorte" data-fecha="@(item.FechaRealizacion.HasValue ? item.FechaRealizacion.Value.ToString("yyyy-MM-dd") : "")">
                                    @(item.FechaRealizacion.HasValue ? item.FechaRealizacion.Value.ToString("dd/MM/yyyy") : "-")
                                </td>
                                <td class="text-objetivo d-none">
                                    @(string.IsNullOrWhiteSpace(item.Objetivo) ? "-" : item.Objetivo)
                                </td>
                                <td class="text-obs align-middle col-observaciones-pantalla" title="@item.Observaciones">
                                    <div class="box-observaciones-resumen">
                                        @(string.IsNullOrWhiteSpace(item.Observaciones) ? "-" : item.Observaciones)
                                    </div>
                                </td>
                                <td class="text-center text-estatus align-middle celda-sin-recorte" onclick="event.stopPropagation();">
                                    <select class="form-select form-select-sm ddl-estatus-tabla text-center fw-bold py-1 px-2" data-id="@item.Id" disabled="@(!puedeEditar)">
                                        <!option value="Pendiente" @(item.Estatus == "Pendiente" ? "selected" : "")>Pendiente</!option>
                                        <!option value="En Curso" @(item.Estatus == "En Curso" ? "selected" : "")>En Curso</!option>
                                        <!option value="Resuelta" @(item.Estatus == "Resuelta" ? "selected" : "")>Resuelta</!option>
                                    </select>
                                </td>
                                <td class="text-center align-middle celda-sin-recorte" onclick="event.stopPropagation();">
                                    <div class="d-flex justify-content-center gap-1">
                                        @if (puedeEditar)
                                        {
                                            <button class="btn btn-accion-tabla btn-editar btn-editar-tarea" data-id="@item.Id" title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        }
                                        @if (puedeEliminar)
                                        {
                                            <button class="btn btn-accion-tabla btn-eliminar btn-eliminar-tarea" data-id="@item.Id" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    <tr id="rowSinResultados" class="d-none">
                        <td colspan="11" class="text-center text-muted py-4">
                            <i class="bi bi-search me-2"></i>No hay tareas que coincidan con los filtros.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Principal para Crear/Editar Tarea -->
<div class="modal fade" id="modalTarea" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-panel text-white border-0">
            <div class="modal-header glass-header border-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icono"><i id="modalTareaIcono" class="bi bi-pencil-square"></i></div>
                    <div>
                        <h5 class="modal-title fs-6 fw-bold text-white mb-0" id="modalTareaTitulo">Tarea Programada</h5>
                        <small id="modalTareaSubtitulo" class="modal-subtitulo"></small>
                    </div>
                </div>
                <button type="button" class="btn-cerrar-modal" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="formTarea">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" id="tareaId" name="TareaInput.Id" value="0" />

                    <div class="modal-seccion">
                        <div class="modal-seccion-titulo"><i class="bi bi-card-text"></i>Datos generales</div>
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label small text-muted">Tarea / Actividad</label>
                                <input type="text" id="txtTarea" name="TareaInput.Tarea" class="form-control form-control-sm" required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small text-muted">Tipo de Tarea</label>
                                <select id="ddlTipo" name="TareaInput.TipoTareaId" class="form-select form-select-sm" required>
                                    <option value="">-- Seleccione --</option>
                                    @foreach (SelectListItem item in Model.SelectTipos)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                    <option value="-1" class="fw-bold text-info">+ Agregar tipo...</option>
                                </select>
                                <div id="divNuevoTipo" class="mt-2 d-none">
                                    <input type="text" id="txtNuevoTipo" name="TareaInput.NuevoTipo" class="form-control form-control-sm" placeholder="Escriba el nuevo tipo de tarea" />
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small text-muted">Persona Solicitante</label>
                                <select id="ddlPersonaSolicitante" name="TareaInput.PersonaSolicitante" class="form-select form-select-sm" required>
                                    <option value="">-- Seleccione Solicitante --</option>
                                    @foreach (SelectListItem p in Model.SelectPersonal)
                                    {
                                        <option value="@p.Value">@p.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small text-muted">Persona Asignada</label>
                                <select id="ddlUsuario" name="TareaInput.PersonaAsignadaId" class="form-select form-select-sm" required>
                                    <option value="">-- Seleccione Ejecutivo --</option>
                                    @foreach (SelectListItem user in Model.SelectUsuarios)
                                    {
                                        <option value="@user.Value">@user.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="modal-seccion">
                        <div class="modal-seccion-titulo"><i class="bi bi-calendar-event"></i>Fechas y estatus</div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small text-muted">Fecha de Solicitud</label>
                                <input type="date" id="txtFechaSolicitud" name="TareaInput.FechaSolicitud" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small text-muted">Estatus</label>
                                <select id="ddlEstatusModal" name="TareaInput.Estatus" class="form-select form-select-sm">
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="En Curso">En Curso</option>
                                    <option value="Resuelta">Resuelta</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small text-muted">Fecha de Realización</label>
                                <input type="date" id="txtFechaRealizacion" name="TareaInput.FechaRealizacion" class="form-control form-control-sm" disabled title="Se habilita cuando el estatus es Resuelta" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-seccion mb-0">
                        <div class="modal-seccion-titulo"><i class="bi bi-chat-left-text"></i>Seguimiento</div>
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label small text-muted">Objetivo</label>
                                <textarea id="txtObjetivo" name="TareaInput.Objetivo" class="form-control form-control-sm" rows="2" placeholder="Detalle qué se espera realizar con esta tarea..."></textarea>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small text-muted">Historial de Comentarios</label>
                                <div id="contenedorHistorialComentarios" class="box-historial-comentarios">
                                    <span class="text-muted small fst-italic">No hay observaciones registradas.</span>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small text-muted">Agregar Nuevo Comentario</label>
                                <textarea id="txtNuevoComentario" name="TareaInput.NuevoComentario" class="form-control form-control-sm" rows="3" placeholder="Escribe las notas de seguimiento..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-transparent pt-0">
                    <button type="button" class="btn btn-sm btn-cancelar px-3" data-bs-dismiss="modal"><i class="bi bi-x-circle"></i> Cancelar</button>
                    <button type="submit" id="btnGuardarTarea" class="btn btn-sm btn-guardar px-3" data-bs-dismiss="modal"><i class="bi bi-save"></i> Guardar Tarea</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Vista Previa de Impresión -->
<div class="modal fade" id="modalVistaPreviaReporte" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content glass-panel text-white border-0">
            <div class="modal-header glass-header border-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icono"><i class="bi bi-printer"></i></div>
                    <div>
                        <h5 class="modal-title fs-6 fw-bold text-white mb-0">Vista Previa de Impresión del Reporte</h5>
                        <small class="modal-subtitulo">Revisa el reporte antes de imprimirlo o guardarlo como PDF</small>
                    </div>
                </div>
                <button type="button" class="btn-cerrar-modal" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body reporte-fondo" id="contenedorVistaPreviaPDF">
                <!-- Todo lo que está dentro de #seccionImpresion es lo que se imprime -->
                <div id="seccionImpresion">
                    <div class="rep-encabezado">
                        <div>
                            <div class="rep-area">Área de Soporte Técnico</div>
                            <div class="rep-titulo">Reporte de Tareas Programadas Generales</div>
                        </div>
                        <div class="rep-fecha">
                            <span>Fecha del reporte</span>
                            <strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>

                    <div class="rep-resumen">
                        <div class="rep-resumen-item rep-total">
                            <span>Total de tareas</span>
                            <strong id="repTotalTareas">0</strong>
                        </div>
                        <div class="rep-resumen-item rep-pendiente">
                            <span>Pendientes</span>
                            <strong id="repPendientes">0</strong>
                        </div>
                        <div class="rep-resumen-item rep-encurso">
                            <span>En curso</span>
                            <strong id="repEnCurso">0</strong>
                        </div>
                        <div class="rep-resumen-item rep-resuelta">
                            <span>Resueltas</span>
                            <strong id="repResueltas">0</strong>
                        </div>
                    </div>

                    <div id="printSoportesContainer" class="rep-bloque d-none">
                        <div class="rep-bloque-titulo">Comentarios Adicionales</div>
                        <div id="printSoportesTexto" class="rep-bloque-texto"></div>
                    </div>

                    <div id="printCampanaContainer" class="rep-bloque rep-bloque-campana d-none">
                        <div class="rep-bloque-titulo" id="printCampanaTitulo">Avances Campaña de Renovación</div>
                        <table class="rep-tabla-campana">
                            <thead>
                                <tr>
                                    <th>Total Clientes</th>
                                    <th>Encuestas Finalizadas</th>
                                    <th>Seguimiento Pendiente</th>
                                    <th>Encuestas en Curso</th>
                                    <th>Porcentaje</th>
                                    <th>Contactados Hoy</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td id="printCampTotal">-</td>
                                    <td id="printCampFin">-</td>
                                    <td id="printCampPend">-</td>
                                    <td id="printCampCurso">-</td>
                                    <td id="printCampPorcentaje">-</td>
                                    <td id="printCampContactados">-</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="rep-seccion-titulo">Programa General de Actividades</div>
                    <table class="tabla-print-detalle">
                        <thead>
                            <tr>
                                <th class="col-print-num">#</th>
                                <th class="col-print-tarea">Tarea / Pendiente</th>
                                <th class="col-print-tipo">Tipo</th>
                                <th class="col-print-asignado">Persona Asignada</th>
                                <th class="col-print-fecha">Fecha Solicitud</th>
                                <th class="col-print-fecha">Fecha Realización</th>
                                <th class="col-print-objetivo">Objetivo</th>
                                <th class="col-print-obs">Observaciones</th>
                                <th class="col-print-estatus">Estatus</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyTareasPrint">
                        </tbody>
                    </table>

                    <div class="rep-pie">
                        <span>SigesTI · Área de Soporte Técnico</span>
                        <span>Generado el @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-transparent">
                <button type="button" class="btn-cancelar" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Cancelar
                </button>
                <button type="button" class="btn-modal-imprimir" id="btnConfirmarImpresion">
                    <i class="bi bi-printer-fill"></i> Imprimir / Guardar PDF
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
