@page
@model SigesTI.Web.Pages.Actividades.TareasProgramadasModel
@{
    ViewData["Title"] = "Tareas Programadas Generales";
}

<div class="container-fluid px-4 mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-white mb-1"><i class="bi bi-list-task me-2"></i>Tareas Programadas Generales</h3>
            <p class="text-muted small mb-0">Programa de mantenimientos, renovaciones y actividades pendientes del área.</p>
        </div>
        <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNuevaTarea">
            <i class="bi bi-plus-lg me-1"></i> Nueva Tarea Programada
        </button>
    </div>

    <!-- Tabla de Tareas -->
    <div class="card bg-dark border-secondary shadow-sm">
        <div class="card-body p-0 table-responsive">
            <table class="table table-dark table-hover align-middle mb-0 small">
                <thead>
                    <tr class="table-active">
                        <th>#</th>
                        <th>Tarea / Pendiente</th>
                        <th>Tipo</th>
                        <th>Origen</th>
                        <th>Persona Asignada</th>
                        <th>Fecha Compromiso</th>
                        <th>Fecha Realización</th>
                        <th>Estatus</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td class="fw-bold">Renovación de Licencias ESET Antivirus</td>
                        <td>Licenciamiento</td>
                        <td><span class="badge bg-secondary">Interno</span></td>
                        <td>Ing. Justin Sánchez</td>
                        <td>05/10/2026</td>
                        <td><span class="text-muted">-</span></td>
                        <td><span class="badge bg-warning text-dark">Pendiente</span></td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#modalResolverTarea">
                                <i class="bi bi-check-lg me-1"></i> Marcar Resuelta
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para Capturar Fecha de Solución -->
<div class="modal fade" id="modalResolverTarea" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title"><i class="bi bi-check-circle me-2 text-success"></i>Completar Tarea</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">Ingresa la fecha exacta en la que se concluyó la actividad:</p>
                <div class="mb-3">
                    <label class="form-label small">Fecha Real de Solución</label>
                    <input type="date" class="form-control bg-dark text-white border-secondary" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="mb-3">
                    <label class="form-label small">Observaciones / Comentarios</label>
                    <textarea class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Detalles de la conclusión..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success btn-sm">Guardar y Marcar Resuelta</button>
            </div>
        </div>
    </div>
</div>