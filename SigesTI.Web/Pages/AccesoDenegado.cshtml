@page
@model SigesTI.Web.Pages.AccesoDenegadoModel

@{
    ViewData["Title"] = "Acceso denegado";
}

<link rel="stylesheet" href="~/css/Claro/accesoDenegado.claro.css" asp-append-version="true" />

<div class="acceso-denegado">

    <div class="acceso-card">

        <div class="acceso-icono">
            <i class="bi bi-shield-lock-fill"></i>
        </div>

        <h1>Acceso denegado</h1>

        <p>
            Tu rol no tiene permiso para entrar a esta sección o realizar esta acción.
            Si lo necesitas, pide a un administrador que revise los permisos de tu rol.
        </p>

        <a class="btn-volver" asp-page="/Index">
            <i class="bi bi-house-door"></i>
            Volver al inicio
        </a>

    </div>

</div>
