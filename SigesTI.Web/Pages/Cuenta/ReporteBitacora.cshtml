@page
@model SigesTI.Web.Pages.Cuenta.ReporteBitacoraModel
@using System.Globalization

@{
    Layout = null;

    var cultura = new CultureInfo("es-MX");
    string nombreReporte = $"ReporteBitacoraDeActividades_{Model.FechaGeneracion:dd-MM-yyyy}";

    // Cuántos registros hay de cada tipo de acción (para los recuadros del resumen)
    int creaciones = Model.Registros.Count(r => ReporteBitacoraModel.ObtenerClaseAccion(r.Accion) == "creacion");
    int ediciones = Model.Registros.Count(r => ReporteBitacoraModel.ObtenerClaseAccion(r.Accion) == "edicion");
    int eliminaciones = Model.Registros.Count(r => ReporteBitacoraModel.ObtenerClaseAccion(r.Accion) == "eliminacion");
    int otros = Model.Registros.Count - creaciones - ediciones - eliminaciones;

    // Los registros se agrupan por día para la tabla
    var registrosPorDia = Model.Registros.GroupBy(r => r.FechaHora.Date);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@nombreReporte</title>
    <link rel="stylesheet" href="~/css/Reportes/reporte-bitacora.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Reportes/reporte-encabezado.css" asp-append-version="true" />
</head>

<body>
    <main class="hoja">

        <!-- Encabezado -->
        <header class="rep-encabezado">
            <div>
                <div class="rep-area">Área de Soporte Técnico</div>
                <div class="rep-titulo">Bitácora de Actividades</div>
            </div>
            <div class="rep-fecha">
                <span>Fecha del reporte</span>
                <strong>@Model.FechaGeneracion.ToString("dd/MM/yyyy")</strong>
            </div>
        </header>

        <!-- Resumen -->
        <section class="resumen">
            <div class="resumen-dato total">
                <span class="resumen-valor">@Model.Registros.Count</span>
                <span class="resumen-titulo">Registros</span>
            </div>
            <div class="resumen-dato creacion">
                <span class="resumen-valor">@creaciones</span>
                <span class="resumen-titulo">Creaciones</span>
            </div>
            <div class="resumen-dato edicion">
                <span class="resumen-valor">@ediciones</span>
                <span class="resumen-titulo">Ediciones</span>
            </div>
            <div class="resumen-dato eliminacion">
                <span class="resumen-valor">@eliminaciones</span>
                <span class="resumen-titulo">Eliminaciones</span>
            </div>
            @if (otros > 0)
            {
                <div class="resumen-dato acceso">
                    <span class="resumen-valor">@otros</span>
                    <span class="resumen-titulo">Otros</span>
                </div>
            }
        </section>

        <!-- Detalle agrupado por día -->
        @if (Model.Registros.Any())
        {
            <table class="tabla">
                <thead>
                    <tr>
                        <th class="col-hora">Hora</th>
                        <th class="col-usuario">Realizado por</th>
                        <th class="col-modulo">Módulo</th>
                        <th class="col-accion">Acción</th>
                        <th>Descripción</th>
                    </tr>
                </thead>

                @foreach (var dia in registrosPorDia)
                {
                    <tbody class="dia">
                        <tr class="dia-titulo">
                            <td colspan="5">
                                <span class="dia-fecha">@ReporteBitacoraModel.TituloDia(dia.Key)</span>
                                <span class="dia-cantidad">@dia.Count() @(dia.Count() == 1 ? "movimiento" : "movimientos")</span>
                            </td>
                        </tr>

                        @foreach (var item in dia)
                        {
                            <tr>
                                <td class="col-hora">@item.FechaHora.ToString("hh:mm tt", cultura)</td>
                                <td class="col-usuario">
                                    <span class="usuario-nombre">@(item.NombreCompleto ?? "Usuario eliminado")</span>
                                    <span class="usuario-correo">@(item.Correo ?? "—")</span>
                                </td>
                                <td class="col-modulo">@item.Modulo</td>
                                <td class="col-accion">
                                    <span class="accion @ReporteBitacoraModel.ObtenerClaseAccion(item.Accion)">@item.Accion</span>
                                </td>
                                <td>@item.Descripcion</td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
        }
        else
        {
            <div class="sin-registros">
                <strong>Sin registros</strong>
                <span>No hay movimientos que coincidan con el periodo y los filtros seleccionados.</span>
            </div>
        }

        <!-- Pie -->
        <footer class="rep-pie">
            <span>SigesST - Sistema de Gestión de Soporte Técnico</span>
        </footer>

    </main>
</body>
</html>
