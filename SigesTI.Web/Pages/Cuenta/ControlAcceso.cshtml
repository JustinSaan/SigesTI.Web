<!-- ====================================================================
     MODAL CONFIGURAR REPORTE DE BITÁCORA
     ==================================================================== -->
@if (puedeExportar)
{
    <div class="modal fade modal-cuenta" id="modalConfigurarReporte" tabindex="-1" aria-labelledby="tituloConfigurarReporte" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="mer-icono"><i class="bi bi-file-earmark-text"></i></div>
                        <div>
                            <h5 class="modal-title mb-0" id="tituloConfigurarReporte">Imprimir bitácora</h5>
                            <small class="mer-subtitulo">Deja un filtro vacío para incluir todos los registros</small>
                        </div>
                    </div>
                    <button type="button" class="mer-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="modal-body">
                    <form id="formReporteBitacora" method="get" asp-page="/Cuenta/ReporteBitacora" target="iframeReporteBitacora">

                        <div class="mer-tarjeta mb-3">
                            <div class="mer-tarjeta-titulo"><i class="bi bi-calendar-range"></i>Periodo</div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="reporteFechaInicio">Fecha inicial</label>
                                    <input id="reporteFechaInicio" name="fechaInicio" type="date" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="reporteFechaFin">Fecha final</label>
                                    <input id="reporteFechaFin" name="fechaFin" type="date" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="mer-tarjeta">
                            <div class="mer-tarjeta-titulo"><i class="bi bi-funnel"></i>Filtros</div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="reporteNombre">Nombre</label>
                                    <select id="reporteNombre" name="filtroNombre" class="form-select">
                                        <option value="">Todos</option>
                                        @foreach (var nombre in Model.ListaNombresBitacora)
                                        {
                                            <option value="@nombre">@nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="reporteCorreo">Correo</label>
                                    <select id="reporteCorreo" name="filtroCorreo" class="form-select">
                                        <option value="">Todos</option>
                                        @foreach (var correo in Model.ListaCorreosBitacora)
                                        {
                                            <option value="@correo">@correo</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="reporteModulo">Módulo</label>
                                    <select id="reporteModulo" name="filtroModulo" class="form-select">
                                        <option value="">Todos</option>
                                        @foreach (var modulo in Model.ListaModulosBitacora)
                                        {
                                            <option value="@modulo">@modulo</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="reporteAccion">Acción</label>
                                    <select id="reporteAccion" name="filtroAccion" class="form-select">
                                        <option value="">Todas</option>
                                        @foreach (var accion in Model.ListaAccionesBitacora)
                                        {
                                            <option value="@accion">@accion</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>

                <div class="modal-footer">
                    <button type="submit" form="formReporteBitacora" class="btn btn-guardar px-4">
                        <i class="bi bi-eye"></i> Ver vista previa
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- ================================================================
         MODAL VISTA PREVIA DEL REPORTE
         ================================================================ -->
    <div class="modal fade modal-cuenta" id="modalVistaPreviaReporte" tabindex="-1" aria-labelledby="tituloVistaPrevia" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-fullscreen-lg-down">
            <div class="modal-content">

                <div class="modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="mer-icono"><i class="bi bi-file-earmark-richtext"></i></div>
                        <div>
                            <h5 class="modal-title mb-0" id="tituloVistaPrevia">Vista previa del reporte</h5>
                            <small class="mer-subtitulo">Revisa el reporte antes de imprimirlo o guardarlo en PDF</small>
                        </div>
                    </div>

                    <div class="cuenta-vista-acciones">
                        <button type="button" class="btn btn-filtros-sigest" data-bs-toggle="modal" data-bs-target="#modalConfigurarReporte">
                            <i class="bi bi-sliders me-1"></i> Cambiar filtros
                        </button>
                        <button type="button" class="btn btn-imprimir-sigest" onclick="imprimirReporteBitacora()">
                            <i class="bi bi-printer me-1"></i> Imprimir
                        </button>
                        <button type="button" id="btnDescargarPdf" class="btn btn-pdf-sigest" onclick="descargarPdfBitacora()">
                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Descargar PDF
                        </button>
                        <button type="button" class="mer-btn-cerrar ms-1" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>

                <div class="modal-body cuenta-vista-previa">
                    <iframe id="iframeReporteBitacora"
                            name="iframeReporteBitacora"
                            title="Vista previa del reporte de bitácora"></iframe>
                </div>

            </div>
        </div>
    </div>
}

<!-- ====================================================================
     MODAL DEPURAR BITÁCORA (solo Admin)
     ==================================================================== -->
@if (Model.EsAdmin)
{
    <div class="modal fade modal-cuenta" id="modalDepurarBitacora" tabindex="-1" aria-labelledby="tituloDepurarBitacora" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="mer-icono mer-icono-peligro"><i class="bi bi-trash3"></i></div>
                        <div>
                            <h5 class="modal-title mb-0" id="tituloDepurarBitacora">Depurar bitácora</h5>
                            <small class="mer-subtitulo">Elimina registros antiguos para liberar espacio</small>
                        </div>
                    </div>
                    <button type="button" class="mer-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="modal-body">
                    <form method="post" asp-page-handler="DepurarBitacora" id="formDepurarBitacora">

                        <div class="cuenta-aviso-peligro mb-3">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>
                                Solo se pueden eliminar registros con más de @ControlAccesoModel.MesesMinimosBitacora meses
                                (anteriores al <strong>@Model.FechaLimiteDepuracion.ToString("dd/MM/yyyy")</strong>).
                                Esta acción no se puede deshacer.
                            </span>
                        </div>

                        <div class="mer-tarjeta">
                            <div class="mer-tarjeta-titulo"><i class="bi bi-calendar-range"></i>Rango a eliminar</div>

                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="form-label" for="depurarDesde">Desde</label>
                                    <input id="depurarDesde" name="desde" type="date" class="form-control"
                                           max="@Model.UltimoDiaDepurable.ToString("yyyy-MM-dd")" />
                                    <small class="cuenta-nota">Vacío = desde el primer registro</small>
                                </div>

                                <div class="col-sm-6">
                                    <label class="form-label" for="depurarHasta">Hasta</label>
                                    <input id="depurarHasta" name="hasta" type="date" class="form-control" required
                                           max="@Model.UltimoDiaDepurable.ToString("yyyy-MM-dd")"
                                           value="@Model.UltimoDiaDepurable.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>

                            <div class="cuenta-depurar-conteo mt-3">
                                <span id="conteoDepuracion" class="cuenta-depurar-numero">—</span>
                                <span id="textoDepuracion">registros se eliminarán</span>
                            </div>
                        </div>

                        <p class="cuenta-nota mt-3 mb-0">
                            <i class="bi bi-printer"></i>
                            ¿Quieres conservar una copia?
                            <button type="button" id="btnImprimirRangoDepurar" class="btn-enlace">Imprime este rango antes de eliminarlo</button>.
                        </p>

                    </form>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btnConfirmarDepuracion" class="btn btn-peligro px-4" disabled>
                        <i class="bi bi-trash3"></i> Eliminar registros
                    </button>
                </div>

            </div>
        </div>
    </div>
}

