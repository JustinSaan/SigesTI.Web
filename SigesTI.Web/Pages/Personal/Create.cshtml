@page
@model SigesTI.Web.Pages.CreateModel
@{
    ViewData["Title"] = "Registrar Personal";
}

<div class="container mt-4 mb-5">
    <div class="form-personal-card">

        <div class="form-personal-header">
            <h5 class="mb-0">
                <i class="bi bi-person-plus-fill me-2"></i>
                Registrar Nuevo Personal
            </h5>
            <small>Alta de personal</small>
        </div>

        <div class="form-personal-body">
            <form method="post">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nombre Completo</label>
                        <input asp-for="Personal.Nombre" class="form-control input-dark" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Área / Departamento</label>
                        <select asp-for="Personal.Area" class="form-select input-dark">
                            <option value="">-- Selecciona un Área --</option>
                            <option>Ventas</option>
                            <option>Administración</option>
                            <option>Soporte Técnico</option>
                            <option>Consultoría</option>
                            <option>Cobranza</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Puesto</label>
                        <input asp-for="Personal.Puesto" class="form-control input-dark" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Correo Electrónico</label>
                        <input asp-for="Personal.Correo" class="form-control input-dark" />
                    </div>

                </div>

                <div class="mb-3">
                    <label class="form-label">Acceso a Unidades de Red</label>
                    <input asp-for="Personal.UnidadesRed"
                           class="form-control input-dark" />
                </div>

                <div class="row mt-3">

                    <div class="col-md-6">
                        <div class="check-panel h-100">
                            <div class="form-check">
                                <input asp-for="Personal.Activo"
                                       class="form-check-input"
                                       type="checkbox" />

                                <label class="form-check-label">
                                    Personal Activo
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="check-panel responsable h-100">
                            <div class="form-check">
                                <input asp-for="Personal.EsResponsable"
                                       class="form-check-input"
                                       id="chkJefe"
                                       type="checkbox" />

                                <label class="form-check-label fw-bold" for="chkJefe">
                                    Responsable del Área
                                </label>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="form-actions">
                    <a asp-page="./Index" class="btn-regresar-personal">
                        <i class="bi bi-arrow-left me-1"></i>
                        Regresar
                    </a>

                    <button type="submit" class="btn-guardar-personal">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        Guardar Registro
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>