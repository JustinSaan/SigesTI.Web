@page
@model SigesTI.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Lista de Personal";
}

<div class="container mt-4 mb-5">
    <div class="header-modulo d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="titulo-modulo m-0">Catálogo de Personal</h2>
            <small class="text-muted-custom">Administración y control de usuarios del sistema</small>
        </div>
        <a asp-page="./Create" class="btn btn-registrar-custom">
            <i class="bi bi-person-plus-fill me-2"></i> Registrar Personal
        </a>
    </div>

    <div class="panel-personal card-principal">
        <div class="table-responsive">
            <table class="table tabla-sigesti m-0">
                <thead>
                    <tr>
                        <th>Nombre Completo</th>
                        <th>Área</th>
                        <th>Puesto</th>
                        <th>Correo Electrónico</th>
                        <th>Unidades de Red</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaPersonal.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted-custom">
                                <i class="bi bi-people text-muted d-block mb-2 fs-3"></i>
                                No hay personal registrado todavía en la base de datos.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var persona in Model.ListaPersonal)
                        {
                            <tr>
                                <td class="fw-semibold text-bright font-accent">@persona.Nombre</td>
                                <td>
                                    <span class="badge-area @persona.Area.ToLower().Replace(" ", "-")">
                                        @persona.Area
                                    </span>
                                </td>
                                <td>@persona.Puesto</td>
                                <td class="text-lowercase text-muted-custom">@persona.Correo</td>
                                <td>
                                    @if (string.IsNullOrEmpty(persona.UnidadesRed))
                                    {
                                        <span class="text-muted-dim fs-7">Ninguna</span>
                                    }
                                    else
                                    {
                                        <span class="text-unidades"><i class="bi bi-folder-symlink me-1"></i> @persona.UnidadesRed</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (persona.Activo)
                                    {
                                        <span class="badge-estatus activo">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge-estatus inactivo">Inactivo</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>