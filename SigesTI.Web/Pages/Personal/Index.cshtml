@page
@model SigesTI.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Lista de Personal";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Lista de Personal</h2>
        <a asp-page="./Create" class="btn btn-primary">Registrar Nuevo</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Nombre Completo</th>
                <th>Área</th>
                <th>Correo Electrónico</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ListaPersonal.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No hay personal registrado todavía.</td>
                </tr>
            }
            else
            {
                @foreach (var persona in Model.ListaPersonal)
                {
                    <tr>
                        <td>@persona.Nombre</td>
                        <td>@persona.Area</td>
                        <td>@persona.Correo</td>
                        <td>
                            @if (persona.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>