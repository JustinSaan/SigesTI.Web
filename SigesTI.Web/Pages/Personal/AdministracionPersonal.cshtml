@page
@model SigesTI.Web.Pages.Personal.AdministracionPersonalModel
@{
    ViewData["Title"] = "Administración de Personal";

    bool puedeCrear = await Permisos.PuedeAsync(Modulos.Personal, Accion.Crear);
    bool puedeEditar = await Permisos.PuedeAsync(Modulos.Personal, Accion.Editar);
    bool puedeEliminar = await Permisos.PuedeAsync(Modulos.Personal, Accion.Eliminar);
}
@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/Personal/administracionPersonal.css" asp-append-version="true" />

<div class="actividades-container px-4 py-3">
    <!-- Encabezado y Acciones -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-white mb-1">
                <i class="bi bi-people-fill me-2 text-info"></i>Administración de Personal
            </h3>
            <p class="text-muted small mb-0">Gestión y control del personal de la empresa.</p>
        </div>
        @if (puedeCrear)
        {
            <button type="button" class="btn btn-primary-sigest shadow-sm px-3" onclick="abrirModalNuevoPersonal()">
                <i class="bi bi-person-plus-fill me-1"></i> Registrar Personal
            </button>
        }
    </div>

    <!-- Tabla de Personal -->
    <div class="glass-panel mb-4 overflow-hidden">
        <div class="glass-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-people me-2"></i>Lista de Personal (Arrastra <i class="bi bi-grip-vertical"></i> para reordenar)</span>
            <span class="badge bg-primary px-3 py-2 rounded-pill">Personal Registrado: @Model.ListaPersonal.Count</span>
        </div>
        <div class="table-responsive tabla-contenedor-personal">
            <table class="tabla-sigest tabla-personal align-middle text-center text-nowrap mb-0 small">
                <thead>
                    <tr>
                        <th rowspan="2" style="width: 40px;"></th>
                        <th colspan="4" class="th-grupo">Información del Personal</th>
                        <th colspan="2" class="th-grupo">Estado del Personal</th>
                        <th class="th-grupo">Gestión</th>
                    </tr>
                    <tr>
                        <th>Nombre</th>
                        <th>Área</th>
                        <th>Puesto</th>
                        <th>Correo Electrónico</th>
                        <th>Usuario del sistema</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="tablaPersonalBody">
                    @if (!Model.ListaPersonal.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-muted py-4">No hay personal registrado todavía.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var persona in Model.ListaPersonal)
                        {
                            <tr class="@(!persona.Activo ? "fila-inactiva" : "")"
                                data-id="@persona.Id"
                                data-nombre="@persona.Nombre"
                                data-area="@persona.Area"
                                data-puesto="@persona.Puesto"
                                data-correo="@persona.Correo"
                                data-activo="@persona.Activo.ToString().ToLower()"
                                data-responsable="@persona.EsResponsable.ToString().ToLower()"
                                data-usuario="@persona.IdUsuario">

                                <td class="drag-handle" title="Arrastra para reordenar"><i class="bi bi-grip-vertical fs-5"></i></td>

                                <td class="celda-nombre">@persona.Nombre</td>
                                <td>
                                    <span class="badge-area-sigest @AdministracionPersonalModel.ClaseArea(persona.Area)">@persona.Area</span>
                                </td>
                                <td class="celda-puesto">@persona.Puesto</td>
                                <td><span class="texto-correo">@persona.Correo</span></td>
                                <td>
                                    @if (persona.IdUsuario.HasValue && Model.Usuarios.TryGetValue(persona.IdUsuario.Value, out var usuario))
                                    {
                                        <span class="badge-usuario-ligado" title="Le llegan las notificaciones de solicitudes">
                                            <i class="bi bi-person-check-fill"></i>@usuario.NombreUsuario
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="texto-sin-usuario">Sin usuario</span>
                                    }
                                </td>
                                <td>
                                    @if (persona.Activo)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-circle-fill me-1 small"></i>Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-dash-circle me-1 small"></i>Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        @if (puedeEditar)
                                        {
                                            <button type="button" class="btn btn-accion-tabla btn-editar" title="Editar" onclick="abrirModalEditarPersonal(this)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        }
                                        @if (puedeEliminar)
                                        {
                                            <button type="button" class="btn btn-accion-tabla btn-eliminar" title="Eliminar" onclick="eliminarPersonal(this)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Registrar / Editar Personal (el mismo modal sirve para ambos) -->
<div class="modal fade modal-personal" id="modalPersonal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="mer-icono"><i class="bi bi-person-plus-fill" id="iconoModalPersonal"></i></div>
                    <div>
                        <h5 class="modal-title mb-0" id="tituloModalPersonal">Registrar Personal</h5>
                        <small class="mer-subtitulo" id="subtituloModalPersonal">Nuevo integrante del personal</small>
                    </div>
                </div>
                <button type="button" class="mer-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="txtPersonalId" value="0" />
                <div class="mer-tarjeta">
                    <div class="mer-tarjeta-titulo"><i class="bi bi-person-vcard"></i> Datos del Personal</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="txtNombre">Nombre Completo</label>
                            <input type="text" class="form-control" id="txtNombre" maxlength="150" placeholder="Ej. Juan Pérez" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="selectArea">Área</label>
                            <select class="form-select" id="selectArea">
                                <option value="">-- Selecciona un Área --</option>
                                @foreach (var area in Model.Areas)
                                {
                                    <option value="@area">@area</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="txtPuesto">Puesto</label>
                            <input type="text" class="form-control" id="txtPuesto" maxlength="100" placeholder="Ej. Gerente, Auxiliar, Coordinador" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="txtCorreo">Correo Electrónico</label>
                            <input type="email" class="form-control" id="txtCorreo" maxlength="150" placeholder="ejemplo@sigesti.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="selectActivo">Estado</label>
                            <select class="form-select" id="selectActivo">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" role="switch" id="chkResponsable" />
                                <label class="form-check-label" for="chkResponsable">Responsable del Área</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mer-tarjeta mt-3">
                    <div class="mer-tarjeta-titulo"><i class="bi bi-person-badge"></i> Usuario del sistema</div>
                    <label class="form-label" for="selectUsuario">Usuario</label>
                    <select class="form-select" id="selectUsuario">
                        <option value="">Sin usuario</option>
                        @foreach (var usuario in Model.Usuarios.Values.OrderBy(u => u.NombreUsuario))
                        {
                            <option value="@usuario.IdUsuario">@usuario.NombreUsuario · @usuario.NombreCompleto@(usuario.Activo ? "" : " (inactivo)")</option>
                        }
                    </select>
                    <div class="texto-ayuda-usuario">
                        <i class="bi bi-info-circle"></i>
                        A este usuario le llegan las notificaciones de solicitudes cuando la persona es solicitante, autoriza o es el ejecutivo de soporte.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancelar" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Cancelar
                </button>
                <button type="button" class="btn btn-guardar px-4" id="btnGuardarPersonal" onclick="guardarPersonal()">
                    <i class="bi bi-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Sin permiso de editar no se carga Sortable, así no se pueden reordenar las filas *@
    @if (puedeEditar)
    {
        <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    }
    <script src="~/js/Personal/administracionPersonal.js" asp-append-version="true"></script>
}
