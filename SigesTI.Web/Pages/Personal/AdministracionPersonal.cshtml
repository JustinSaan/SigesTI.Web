@page
@model SigesTI.Web.Pages.Personal.IndexModel
@{
    ViewData["Title"] = "Lista de Personal";
}

<div class="container-fluid px-4 mt-4 mb-5">
    <div class="header-modulo d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="titulo-modulo m-0">Administración de Personal</h2>
            <small class="text-muted-custom">Gestión y control de usuarios del sistema</small>
        </div>
        <button type="button"
                class="btn-registrar-custom"
                onclick="abrirModalRegistrar()">
            <i class="bi bi-person-plus-fill"></i>
            <span>Registrar Personal</span>
        </button>
    </div>

    <div class="panel-personal card-principal">
        <div class="table-responsive">
            <table class="table tabla-sigesti m-0">
                <thead>
                    <tr>
                        <th class="text-center">Nombre</th>
                        <th class="text-center">Área</th>
                        <th class="text-center">Puesto</th>
                        <th class="text-center">Correo Electrónico</th>
                        <th class="text-center">Unidades de Red</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaPersonal.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted-custom">
                                <i class="bi bi-people text-muted d-block mb-2 fs-3"></i>
                                No hay personal registrado todavía en la base de datos.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var persona in Model.ListaPersonal)
                        {
                            <tr>
                                <td class="fw-semibold text-bright font-accent">@persona.Nombre</td>
                                <td class="text-center">
                                    <span class="badge-area @persona.Area.ToLower().Replace(" ", "-")">
                                        @persona.Area
                                    </span>
                                </td>
                                <td>@persona.Puesto</td>
                                <td class="text-lowercase text-muted-custom">@persona.Correo</td>
                                <td>
                                    @if (string.IsNullOrEmpty(persona.UnidadesRed))
                                    {
                                        <span class="text-muted-dim fs-7">Ninguna</span>
                                    }
                                    else
                                    {
                                        <span class="text-unidades">@persona.UnidadesRed</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (persona.Activo)
                                    {
                                        <span class="badge-estatus activo">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge-estatus inactivo">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="acciones-personal">
                                        <button type="button"
                                                class="btn-accion-tabla btn-editar"
                                                title="Editar"
                                                onclick="editarEmpleado(@persona.Id)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <button type="button"
                                                class="btn-accion-tabla btn-eliminar"
                                                title="Eliminar"
                                                onclick="eliminarEmpleado(@persona.Id, `@persona.Nombre`)">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-dark">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-pencil-square me-2"></i>
                    Editar Personal
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

<div class="modal-body">

    <input type="hidden" id="editId" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label>Nombre Completo</label>
            <input id="editNombre" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <label>Área</label>
            <select id="editArea" class="form-select">
                <option value="Ventas">Ventas</option>
                <option value="Administración">Administración</option>
                <option value="Soporte Técnico">Soporte Técnico</option>
                <option value="Consultoría">Consultoría</option>
                <option value="Cobranza">Cobranza</option>
            </select>
        </div>

        <div class="col-md-6 mb-3">
            <label>Puesto</label>
            <input id="editPuesto" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <label>Correo</label>
            <input id="editCorreo" class="form-control" />
        </div>

        <div class="col-md-12 mb-3">
            <label>Unidades de Red</label>
            <input id="editUnidadesRed" class="form-control" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="check-panel h-100">
                <div class="form-check">
                    <input id="editActivo"
                           class="form-check-input"
                           type="checkbox">
                    <label class="form-check-label">
                        Personal Activo
                    </label>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="check-panel responsable h-100">
                <div class="form-check">
                    <input id="editResponsable"
                           class="form-check-input"
                           type="checkbox">
                    <label class="form-check-label fw-bold">
                        Responsable del Área
                    </label>
                </div>
            </div>
        </div>
    </div>

</div>

            <div class="modal-footer">
                <button type="button"
                        class="btn-cancelar-modal"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancelar
                </button>

                <button type="button"
                        class="btn-guardar-modal"
                        onclick="guardarCambios()">
                    <i class="bi bi-check-circle-fill me-1"></i>
                    Guardar Cambios
                </button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalRegistrar" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-dark">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-person-plus-fill me-2"></i>
                    Registrar Nuevo Personal
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>


            @* Modal de registro *@
            <div class="modal-body">

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Nombre Completo</label>
                        <input id="regNombre" class="form-control" placeholder="Ej. Juan Pérez" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Área</label>
                        <select id="regArea" class="form-select">
                            <option value="">-- Selecciona un Área --</option>
                            <option value="Ventas">Ventas</option>
                            <option value="Administración">Administración</option>
                            <option value="Soporte Técnico">Soporte Técnico</option>
                            <option value="Consultoría">Consultoría</option>
                            <option value="Cobranza">Cobranza</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Puesto</label>
                        <input id="regPuesto" class="form-control" placeholder="Ej. Gerente, Auxiliar, Coordinador" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Correo</label>
                        <input id="regCorreo" type="email" class="form-control" placeholder="ejemplo@sigesti.com" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label>Unidades de Red</label>
                        <input id="regUnidadesRed" class="form-control" placeholder="Compartida, Ventas..." />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="check-panel h-100">
                            <div class="form-check">
                                <input id="regActivo"
                                       type="checkbox"
                                       class="form-check-input"
                                       checked />
                                <label class="form-check-label">Personal Activo</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="check-panel responsable h-100">
                            <div class="form-check">
                                <input id="regResponsable"
                                       type="checkbox"
                                       class="form-check-input" />
                                <label class="form-check-label fw-bold">
                                    Responsable del Área
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn-cancelar-modal"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancelar
                </button>

                <button type="button"
                        class="btn-guardar-modal"
                        onclick="guardarRegistro()">
                    <i class="bi bi-check-circle-fill me-1"></i>
                    Guardar Registro
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

 <!-- Logout -->
    <script src="~/js/modales.js"
            asp-append-version="true"></script>