<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="icon"
          type="image/x-icon"
          href="~/icono.png" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SigesTI.Web.styles.css"
          asp-append-version="true" />
</head>

<body class="layout-body">

    <header class="layout-header">

        <nav class="layout-navbar">

            <div class="layout-navbar-inner">

                <!-- Logo izquierdo -->
                <a class="layout-brand"
                   asp-area=""
                   asp-page="/Index">

                    <img src="~/titulo2.png"
                         alt="Logo"
                         width="180"
                         height="60">
                </a>

                <!-- Menú centrado -->
                <div class="layout-menu">

                    <a class="layout-link"
                       asp-area=""
                       asp-page="/Solicitudes/Generar">

                        <i class="bi bi-plus-square-fill"></i>
                        Registro
                    </a>

                    <a class="layout-link"
                       asp-area=""
                       asp-page="/Solicitudes/Consultar">

                        <i class="bi bi-search"></i>
                        Consultas
                    </a>

                    <a class="layout-link"
                       asp-area=""
                       asp-page="/Personal/Index">

                        <i class="bi bi-people-fill"></i>
                        Personal
                    </a>

                    <a class="layout-link"
                       asp-area=""
                       asp-page="/Cuenta/AdminVista">

                        <i class="bi bi-person-badge-fill"></i>
                        Cuenta
                    </a>

                </div>

                <!-- Bienvenida derecha -->
                <div class="layout-user">

                    <i class="bi bi-person-circle"></i>

                    <span>
                        Bienvenido(a):
                        <strong>Usuario</strong>
                    </span>

                </div>

            </div>

        </nav>

    </header>

    <main role="main"
          class="layout-main">

        <div class="layout-content">
            @RenderBody()
        </div>

    </main>

    <footer class="layout-footer">

        <div class="container-fluid px-4">

            <span>
                &copy; 2026 - SigesST
            </span>

            <span>
                Área de Soporte Técnico
            </span>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <!-- Librería SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Alertas globales -->
    <script src="~/js/alertas.js"
            asp-append-version="true"></script>

    <!-- Modales globales -->
    <script src="~/js/modales.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>