@using Microsoft.AspNetCore.Http

@{
    string nombreUsuario = Context.Session.GetString("Usuario") ?? "Usuario";
    string rolUsuario = Context.Session.GetString("Rol") ?? "Sin rol";

    // Solo se muestran las opciones del menú que el rol puede ver
    bool verGenerar = await Permisos.PuedeAsync(Modulos.GenerarSolicitud, Accion.Ver);
    bool verConsultar = await Permisos.PuedeAsync(Modulos.ConsultarSolicitudes, Accion.Ver);
    bool verTickets = await Permisos.PuedeAsync(Modulos.ReporteTickets, Accion.Ver);
    bool verRespaldos = await Permisos.PuedeAsync(Modulos.PlanRespaldos, Accion.Ver);
    bool verTareas = await Permisos.PuedeAsync(Modulos.TareasGenerales, Accion.Ver);
    bool verCampana = await Permisos.PuedeAsync(Modulos.CampanaRenovacion, Accion.Ver);
    bool verIndicadores = await Permisos.PuedeAsync(Modulos.Indicadores, Accion.Ver);
    bool verCuenta = await Permisos.PuedeAsync(Modulos.Cuenta, Accion.Ver);
    bool verPersonal = await Permisos.PuedeAsync(Modulos.Personal, Accion.Ver);

    bool verMenuRequerimientos = verGenerar || verConsultar;
    bool verMenuActividades = verTickets || verRespaldos || verTareas || verCampana || verIndicadores;
    bool verMenuCuenta = verCuenta || verPersonal;
}<!DOCTYPE html><html lang="es"><head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="icon" type="image/x-icon" href="~/icono.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notificaciones.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SigesTI.Web.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)</head><body class="layout-body">

    <header class="layout-header">
        <nav class="layout-navbar">
            <div class="layout-navbar-inner">

                <!-- Logo izquierdo -->
                <a class="layout-brand" asp-area="" asp-page="/Index">
                    <img src="~/SigesST.png" alt="Logo" width="190" height="52">
                </a>

                <!-- Menú centrado -->
                <div class="layout-menu">

                    <!-- Dropdown: Requerimientos -->
                    @if (verMenuRequerimientos)
                    {
                        <div class="dropdown d-inline-block">
                            <a class="layout-link dropdown-toggle"
                               href="#"
                               id="navbarUserDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <i class="bi bi-clipboard2-fill"></i>
                                <span>Requerimientos</span>
                            </a>

                            <ul class="dropdown-menu custom-dropdown-menu shadow-lg border-0" aria-labelledby="navbarUserDropdown">
                                @if (verGenerar)
                                {
                                    <li>
                                        <a class="dropdown-item item-emerald py-2" asp-page="/Solicitudes/Generar">
                                            <i class="bi bi-plus-square me-2"></i>Generar Solicitud
                                        </a>
                                    </li>
                                }
                                @if (verConsultar)
                                {
                                    <li>
                                        <a class="dropdown-item item-cyan py-2" asp-page="/Solicitudes/Consultar">
                                            <i class="bi bi-search me-2"></i>Consultar Solicitudes
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Dropdown: Actividades -->
                    @if (verMenuActividades)
                    {
                        <div class="dropdown d-inline-block">
                            <a class="layout-link dropdown-toggle"
                               href="#"
                               id="navbarDropdownActividades"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <i class="bi bi-file-earmark-text"></i>
                                <span>Actividades</span>
                            </a>

                            <ul class="dropdown-menu custom-dropdown-menu shadow-lg border-0" aria-labelledby="navbarDropdownActividades">
                                @if (verTickets)
                                {
                                    <li>
                                        <a class="dropdown-item item-cyan py-2" asp-page="/Actividades/ReporteTickets">
                                            <i class="bi bi-journal-check me-2"></i>Reporte de Tickets
                                        </a>
                                    </li>
                                }
                                @if (verRespaldos)
                                {
                                    <li>
                                        <a class="dropdown-item item-purple py-2" asp-page="/Actividades/PlanRespaldos">
                                            <i class="bi bi-hdd-network me-2"></i>Plan de Respaldos
                                        </a>
                                    </li>
                                }
                                @if (verTareas)
                                {
                                    <li>
                                        <a class="dropdown-item item-amber py-2" asp-page="/Actividades/TareasProgramadas">
                                            <i class="bi bi-list-task me-2"></i>Tareas Generales
                                        </a>
                                    </li>
                                }
                                @if (verCampana)
                                {
                                    <li>
                                        <a class="dropdown-item item-rose py-2" asp-page="/Actividades/CampañaR">
                                            <i class="bi bi-arrow-repeat me-2"></i>Campaña de Renovación
                                        </a>
                                    </li>
                                }
                                @if (verIndicadores)
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item item-emerald py-2" asp-page="/Actividades/Indicadores">
                                            <i class="bi bi-bar-chart-line me-2"></i>Indicadores y Métricas
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Dropdown: Cuenta -->
                    @if (verMenuCuenta)
                    {
                        <div class="dropdown d-inline-block">
                            <a class="layout-link dropdown-toggle"
                               href="#"
                               id="navbarDropdownCuenta"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <i class="bi bi-person-badge-fill"></i>
                                <span>Cuenta</span>
                            </a>

                            <ul class="dropdown-menu custom-dropdown-menu shadow-lg border-0" aria-labelledby="navbarDropdownCuenta">
                                @if (verCuenta)
                                {
                                    <li>
                                        <a class="dropdown-item item-cyan py-2" asp-page="/Cuenta/ControlAcceso">
                                            <i class="bi bi-person-lock me-2"></i>Control de acceso
                                        </a>
                                    </li>
                                }
                                @if (verPersonal)
                                {
                                    <li>
                                        <a class="dropdown-item item-purple py-2" asp-page="/Personal/AdministracionPersonal">
                                            <i class="bi bi-people-fill me-2"></i>Administrar Personal
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                </div>

                <!-- Notificaciones y usuario (Derecha) -->
                <div class="layout-derecha">

                <!-- Notificaciones (notificaciones.js) -->
                <div class="dropdown notif-dropdown">
                    <button type="button"
                            class="notif-boton"
                            id="btnNotificaciones"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false"
                            aria-label="Notificaciones"
                            title="Notificaciones">
                        <i class="bi bi-bell-fill"></i>
                        <span class="notif-contador d-none" id="contadorNotificaciones">0</span>
                    </button>

                    <div class="dropdown-menu dropdown-menu-end notif-menu" aria-labelledby="btnNotificaciones">
                        <div class="notif-menu-encabezado">
                            <span><i class="bi bi-bell me-2"></i>Notificaciones</span>
                            <button type="button" class="notif-leer-todas" id="btnLeerTodas">Marcar todas como leídas</button>
                        </div>
                        <div class="notif-lista" id="listaNotificaciones">
                            <div class="notif-vacio"><i class="bi bi-bell-slash"></i>No tienes notificaciones.</div>
                        </div>
                    </div>
                </div>

                <!-- Usuario y menú desplegable -->
                <div class="dropdown layout-user-dropdown">

                    <button type="button"
                            class="layout-user"
                            id="menuUsuario"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">

                        <i class="bi bi-person-circle"></i>

                        <span class="layout-user-text">
                            <span class="layout-user-welcome">
                                Bienvenido(a):
                            </span>
                            <strong>
                                @nombreUsuario
                            </strong>
                            <small>
                                @rolUsuario
                            </small>
                        </span>

                        <i class="bi bi-chevron-down layout-user-arrow"></i>

                    </button>

                    <ul class="dropdown-menu dropdown-menu-end layout-user-menu custom-dropdown-menu shadow-lg border-0"
                        aria-labelledby="menuUsuario">

                        <li class="layout-user-menu-header">
                            <span>
                                Sesión iniciada como
                            </span>
                            <strong>
                                @nombreUsuario
                            </strong>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <form method="post"
                                  asp-page="/InicioSesion/CerrarSesion"
                                  id="formCerrarSesion">
                                <button type="submit"
                                        class="dropdown-item layout-logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Cerrar sesión
                                </button>
                            </form>
                        </li>

                    </ul>

                </div>

                </div>

            </div>

        </nav>

    </header>

    <main role="main" class="layout-main">
        <div class="layout-content">
            @RenderBody()
        </div>
    </main>

    <!-- Vista previa de un requerimiento (se abre desde las notificaciones y desde Consultar) -->
    <div class="modal fade modal-notificacion" id="modalVistaRequerimiento" tabindex="-1" aria-labelledby="tituloVistaRequerimiento" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-fullscreen-lg-down">
            <div class="modal-content">

                <div class="modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="notif-modal-icono"><i class="bi bi-file-earmark-richtext"></i></div>
                        <div>
                            <h5 class="modal-title mb-0" id="tituloVistaRequerimiento">Requerimiento</h5>
                            <small class="notif-modal-subtitulo" id="subtituloVistaRequerimiento"></small>
                        </div>
                    </div>

                    <div class="notif-modal-acciones">
                        <button type="button" class="notif-btn-imprimir" id="btnImprimirRequerimiento">
                            <i class="bi bi-printer me-1"></i> Imprimir
                        </button>
                        <button type="button" class="notif-btn-autorizar d-none" id="btnAutorizarRequerimiento">
                            <i class="bi bi-patch-check-fill me-1"></i> Autorizar requerimiento
                        </button>
                        <button type="button" class="notif-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>

                <div class="modal-body notif-vista-previa">
                    <iframe id="iframeVistaRequerimiento" title="Vista previa del requerimiento"></iframe>
                </div>

            </div>
        </div>
    </div>

    <footer class="layout-footer">
        <div class="container-fluid px-4">
            <span>
                &copy; 2026 - SigesST
            </span>

            <span>
                Área de Soporte Técnico
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/alertas.js" asp-append-version="true"></script>
    <script src="~/js/modales.js" asp-append-version="true"></script>
    <script src="~/js/logout.js" asp-append-version="true"></script>
    <script src="~/js/notificaciones.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)</body></html>