@using Microsoft.AspNetCore.Http

@{
    string nombreUsuario =
        /* Context.Session.GetString("NombreCompleto")
        ??*/ Context.Session.GetString("Usuario")
        ?? "Usuario";

    string rolUsuario =
        Context.Session.GetString("Rol")
        ?? "Sin rol";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="icon"
          type="image/x-icon"
          href="~/icono.png" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SigesTI.Web.styles.css"
          asp-append-version="true" />
</head>

<body class="layout-body">

    <header class="layout-header">

        <nav class="layout-navbar">

            <div class="layout-navbar-inner">

                <!-- Logo izquierdo -->
                <a class="layout-brand"
                   asp-area=""
                   asp-page="/Index">

                    <img src="~/SigesST.png"
                         alt="Logo"
                         width="200"
                         height="55">
                </a>

                <!-- Menú centrado -->
                <div class="layout-menu">

                    <!-- Dropdown: Requerimientos -->
                    <div class="dropdown d-inline-block">
                        <a class="layout-link dropdown-toggle" 
                           href="#" 
                           id="navbarUserDropdown" 
                           role="button" 
                           data-bs-toggle="dropdown" 
                           aria-expanded="false">
                            <i class="bi bi-clipboard2-fill"></i>
                            Requerimientos
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="navbarUserDropdown">
                            <li>
                                <a class="dropdown-item py-2" asp-page="/Solicitudes/Generar">
                                    <i class="bi bi-plus-square me-2 text-secondary"></i>Generar Solicitud
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-page="/Solicitudes/Consultar">
                                    <i class="bi bi-search me-2 text-secondary"></i>Consultar Solicitudes
                                </a>
                            </li>
                        </ul>
                    </div>

                     <!-- Dropdown: Actividades -->
                    <div class="dropdown d-inline-block">
                        <a class="layout-link dropdown-toggle" 
                           href="#" 
                           id="navbarUserDropdown" 
                           role="button" 
                           data-bs-toggle="dropdown" 
                           aria-expanded="false">
                            <i class="bi bi-file-earmark-check-filll"></i>
                            Actividades
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="navbarUserDropdown">
                            <li>
                                <a class="dropdown-item py-2" asp-page="/Solicitudes/Generar">
                                    <i class="bi bi-plus-square me-2 text-secondary"></i>Generar Solicitud
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-page="/Solicitudes/Consultar">
                                    <i class="bi bi-search me-2 text-secondary"></i>Consultar Solicitudes
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Enlace: Personal -->
                    <a class="layout-link"
                       asp-area=""
                       asp-page="/Personal/AdministracionPersonal">
                        <i class="bi bi-people-fill"></i>
                        Personal
                    </a>

                    <!-- Enlace: Cuenta -->
                    <a class="layout-link"
                       asp-area=""
                       asp-page="/Cuenta/AdminVista">
                        <i class="bi bi-person-badge-fill"></i>
                        Cuenta
                    </a>

                </div>

                <!-- Usuario y menú desplegable (Derecha) -->
                <div class="dropdown layout-user-dropdown">

                    <button type="button"
                            class="layout-user"
                            id="menuUsuario"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">

                        <i class="bi bi-person-circle"></i>

                        <span class="layout-user-text">
                            <span class="layout-user-welcome">
                                Bienvenido(a):
                            </span>
                            <strong>
                                @nombreUsuario
                            </strong>
                            <small>
                                @rolUsuario
                            </small>
                        </span>

                        <i class="bi bi-chevron-down layout-user-arrow"></i>

                    </button>

                    <ul class="dropdown-menu dropdown-menu-end layout-user-menu"
                        aria-labelledby="menuUsuario">

                        <li class="layout-user-menu-header">
                            <span>
                                Sesión iniciada como
                            </span>
                            <strong>
                                @nombreUsuario
                            </strong>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <form method="post"
                                  asp-page="/InicioSesion/CerrarSesion"
                                  id="formCerrarSesion">
                                <button type="submit"
                                        class="dropdown-item layout-logout">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Cerrar sesión
                                </button>
                            </form>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <main role="main"
          class="layout-main">

        <div class="layout-content">
            @RenderBody()
        </div>

    </main>

    <footer class="layout-footer">

        <div class="container-fluid px-4">

            <span>
                &copy; 2026 - SigesST
            </span>

            <span>
                Área de Soporte Técnico
            </span>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <!-- Librería SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Alertas globales -->
    <script src="~/js/alertas.js"
            asp-append-version="true"></script>

    <!-- Modales globales -->
    <script src="~/js/modales.js"
            asp-append-version="true"></script>

    <!-- Logout -->
    <script src="~/js/logout.js"
            asp-append-version="true"></script>

   </body>

</html>